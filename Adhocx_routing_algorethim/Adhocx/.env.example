# Server-side key: restrict to Geocoding API and Routes API, with a server IP where possible.
GOOGLE_MAPS_API_KEY=

# Browser key: restrict to Maps JavaScript API and approved HTTP referrers.
GOOGLE_MAPS_BROWSER_API_KEY=

# IANA timezone used for date/time input and route scheduling.
# Examples: America/New_York, Europe/London, or UTC.
APP_TIMEZONE=UTC
