# ============================================================
# AdhocX Production Environment Template (AWS EC2 + GHCR)
# ============================================================

# App / Server
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
APP_URL=https://api.adhocx.com
CORS_ORIGINS=https://adhocx.com,https://admin.adhocx.com,https://app.adhocx.com

# PostgreSQL + PostGIS (Production AWS Instance)
POSTGRES_USER=adhocx_user
POSTGRES_PASSWORD=replace_with_strong_production_password_32_chars
POSTGRES_DB=adhocx
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://adhocx_user:replace_with_strong_production_password_32_chars@postgres:5432/adhocx?schema=public

# Redis In-Memory Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# JWT Authentication
JWT_ACCESS_SECRET=replace_with_64_char_cryptographically_secure_random_string
JWT_REFRESH_SECRET=replace_with_64_char_cryptographically_secure_random_string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# OTP Configuration
OTP_EXPIRY_SECONDS=300
OTP_RESEND_DELAY_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Admin Web & Mobile Clients
NEXT_PUBLIC_API_URL=https://api.adhocx.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.adhocx.com

# AI & LLM Providers
GEMINI_API_KEY=

