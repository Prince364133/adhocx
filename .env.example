# ============================================================
# AdhocX Environment Configuration Template
# Source of truth: docs/18_DEVOPS_AND_DEPLOYMENT.md
# ============================================================

# App / Server
NODE_ENV=development
PORT=7001
API_PREFIX=api/v1
APP_URL=http://localhost:7001
CORS_ORIGINS=http://localhost:7002,http://localhost:7003,http://localhost:3000,http://localhost:3001

# PostgreSQL + PostGIS
# PostgreSQL + PostGIS (AWS EC2 Authoritative Production Database)
DATABASE_URL=postgresql://adhocx_user:adhocx_password@3.110.42.191:5432/adhocx?schema=public&connection_limit=45&pool_timeout=30&connect_timeout=15
DB_HOST=3.110.42.191
DB_PORT=5432
DB_USER=adhocx_user
DB_PASSWORD=adhocx_password
DB_NAME=adhocx

# Redis / Valkey Cache Engine
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
# TLS certificates are verified. Private CA: REDIS_TLS_CA (PEM path or inline). Opt out (not recommended):
# REDIS_TLS_REJECT_UNAUTHORIZED=false
# REDIS_TLS_SERVERNAME=
# Optional separate Redis for live-telemetry Pub/Sub (recommended above ~5k GPS fixes/s)
# REDIS_PUBSUB_URL=
# Live telemetry tuning
# TELEMETRY_PUBLISH_BATCH_MS=100
# TELEMETRY_SSE_FLUSH_MS=500
# TELEMETRY_SSE_MAX_PER_USER=5
# TELEMETRY_SSE_MAX_LIFETIME_MS=3600000
# TRIP_LOCATION_PERSIST_INTERVAL_SEC=10

# JWT Authentication
JWT_ACCESS_SECRET=development_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=development_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Support ticket limits (fixed-window requests per authenticated user)
SUPPORT_TICKET_CREATE_LIMIT=5
SUPPORT_COMMENT_LIMIT=30
SUPPORT_RATE_LIMIT_WINDOW_SECONDS=3600

# OTP Configuration
OTP_EXPIRY_SECONDS=300
OTP_RESEND_DELAY_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Admin Web & Mobile
NEXT_PUBLIC_API_URL=http://localhost:7001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:7001
# Ops app origin; set this to the deployed Ops URL in staging/production.
NEXT_PUBLIC_OPS_URL=http://localhost:7004

# AI & LLM Providers
GEMINI_API_KEY=

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=adhocx
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<id>.r2.dev
R2_API_TOKEN=

# Firebase Cloud Messaging (FCM) Push Notifications
FIREBASE_PROJECT_ID=adhocx-507407
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@adhocx-507407.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SMTP Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=AdhocX
SMTP_FROM_EMAIL=

# ── Corporate zonal rate card (Hyderabad, New Adok Rate Card 2026) ──
# Quote validity in minutes (PRD: approve before production)
ZONAL_QUOTE_TTL_MINUTES=15
# Set to false to disable automatic escort booking until the escort service/payee is configured
ZONAL_ESCORT_ENABLED=true
# When true, localities without an ops-verified pin go to operations review instead of auto-quoting
ZONAL_REQUIRE_LOCALITY_PIN=false
# H3 res-8 kRing around a verified locality pin within which the employee pin must fall
ZONAL_LOCALITY_PIN_KRING=4
# Approved hub geofences (JSON). Leave empty to use built-in anchors. Example:
# ZONAL_HUB_GEOFENCES={"HITEC_NANAKRAMGUDA":[{"lat":17.4435,"lng":78.3772,"k":1},{"lat":17.4155,"lng":78.3416,"k":1}],"KOKAPET":[{"lat":17.385,"lng":78.3245,"k":2}]}
ZONAL_HUB_GEOFENCES=
# Redis GEO / H3 driver index metadata TTL (driver app reports location on availability change and trip pings)
DRIVER_GEO_META_TTL_SECONDS=900

# Google Maps Platform (Places New, Routes New, Geocoding, Maps Static)
GOOGLE_MAPS_API_KEY=AIzaSyB8uEHtGy96QPbx3eIxG0s0_WYlWpB8QVI

# MSG91 SMS Service (DLT Compliant OTP & Transactional SMS)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=6aec3196704f112ad8019976
MSG91_SENDER_ID=ADHOCX
MSG91_ENABLED=true

# Digio KYC, KYB, Bank, Biometric & DigiLocker Verification
DIGIO_ENV=production
DIGIO_BASE_URL=https://api.digio.in
DIGIO_GATEWAY_URL=https://app.digio.in
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_WEBHOOK_SECRET=
DIGIO_DIGILOCKER_TEMPLATE_NAME=DIGILOCKER_AADHAAR_PAN
