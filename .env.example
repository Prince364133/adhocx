# ============================================================
# AdhocX Environment Configuration Template
# Source of truth: docs/18_DEVOPS_AND_DEPLOYMENT.md
# ============================================================

# App / Server
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://adhocx_user:adhocx_password@localhost:5432/adhocx_db?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=adhocx_user
DB_PASSWORD=adhocx_password
DB_NAME=adhocx_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_ACCESS_SECRET=development_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=development_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# OTP Configuration
OTP_EXPIRY_SECONDS=300
OTP_RESEND_DELAY_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Admin Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
