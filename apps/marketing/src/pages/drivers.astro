---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "AdhocX Driver Partner Portal — ₹2,000 Joining Bonus (T&C Apply)",
  "description": "Join India's fastest-growing corporate commercial mobility network across Telangana and Hyderabad. Get ₹2,000 bonus — join us today. Terms and conditions apply.",
  "publisher": {
    "@type": "Organization",
    "name": "AdhocX Technologies Private Limited",
    "url": "https://www.adhocx.com"
  },
  "mainEntity": {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How does the ₹2,000 joining bonus work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Join AdhocX as a commercial 4 or 7 seater driver partner and complete your initial onboarding verification and trips. Terms and conditions apply for bonus disbursement directly to your bank."
        }
      },
      {
        "@type": "Question",
        "name": "What vehicle categories do you support?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We exclusively support commercial yellow-plate 4-seater sedans (Dzire, Etios) and 6/7-seater MUVs and SUVs (Ertiga, XL6, Innova Crysta)."
        }
      },
      {
        "@type": "Question",
        "name": "How often do I get paid?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Driver partners receive direct payouts to their bank account every Monday, with on-demand instant withdrawal within 1 hour."
        }
      }
    ]
  }
};
---

<BaseLayout
  title="Drive with AdhocX — ₹2,000 Bonus Join Us (Terms & Conditions Apply)"
  description="Join India's premier B2B commercial transport network across Telangana and Hyderabad for 4 & 7 seater cabs. High-value pre-scheduled corporate routes, 0% promo commission, and ₹2,000 bonus join us (T&C apply)."
  canonical="https://www.adhocx.com/drivers"
  activeNav="drivers"
  jsonLd={jsonLd}
>
  <!-- Driver Hero -->
  <section class="hero-section" style="background: linear-gradient(180deg, var(--color-amber-50) 0%, #ffffff 100%);">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="hero-tag">
          <span class="badge badge-warning" style="display: inline-flex; align-items: center; gap: 4px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            ₹2,000 Bonus Join Us • T&C Apply*
          </span>
          <span class="badge badge-info">Telangana & Regional 4 & 7 Seater Fleets</span>
        </div>
        <h1 class="display-title" style="color: var(--color-text-primary);">
          Drive Smarter. <br />
          <span style="color: var(--color-primary-600);">Earn Higher. Guaranteed.</span>
        </h1>
        <p class="body-large">
          Join AdhocX and connect directly to high-tariff enterprise employee shifts, airport executive transfers, and corporate bookings for 4-seater sedans and 7-seater MUVs across Telangana (Hyderabad Tech Parks & Regional Hubs). No dry runs — get pre-scheduled corporate trips.
        </p>
        <div class="hero-actions">
          <a href="#onboarding" class="btn btn-accent btn-large">
            Document Checklist & Onboarding →
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.adhocx.app&pcampaignid=web_share" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-large">
            Download Driver App
          </a>
        </div>
        <div class="hero-metrics metrics-4" style="border-top: 1px solid var(--color-border);">
          <div class="metric-item">
            <div class="metric-val" style="color: var(--color-accent-base);">₹2,000*</div>
            <div class="metric-lbl">Joining Bonus (T&C Apply)</div>
          </div>
          <div class="metric-item">
            <div class="metric-val" style="color: var(--color-primary-600);">1 Hour</div>
            <div class="metric-lbl">Instant Bank Payout</div>
          </div>
          <div class="metric-item">
            <div class="metric-val" style="color: var(--color-success);">0%</div>
            <div class="metric-lbl">Promo Commission</div>
          </div>
          <div class="metric-item">
            <div class="metric-val" style="color: var(--color-primary-600);">4 & 7 Seater</div>
            <div class="metric-lbl">Exclusive Fleets</div>
          </div>
        </div>
      </div>

      <!-- Bonus Card Highlight -->
      <div class="hero-card-wrapper" data-animate>
        <div class="card" style="border: 2px solid var(--color-accent-base); padding: var(--space-8); box-shadow: var(--shadow-xl); background: #ffffff;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
            <span class="badge badge-warning">Launch Incentive</span>
            <span style="font-weight: 800; color: var(--color-accent-base); font-size: 1.25rem;">+₹2,000 Bonus*</span>
          </div>

          <h3 class="h3-title" style="margin-bottom: var(--space-3); color: var(--color-text-primary);">Join Us & Get ₹2,000 Bonus*</h3>
          <p class="body-text" style="margin-bottom: var(--space-6); color: var(--color-text-secondary);">
            Special partner incentive for commercial yellow-plate 4-seater and 7-seater drivers in Telangana and Hyderabad. Direct bank deposit upon onboarding. Terms and conditions apply.
          </p>

          <!-- Feature Highlights -->
          <div style="display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-6);">
            <div style="display: flex; align-items: center; gap: 12px; background: var(--color-primary-50); padding: 12px 14px; border-radius: 8px; border-left: 4px solid var(--color-primary-600);">
              <div style="width: 2rem; height: 2rem; border-radius: 6px; background: #CEE0FD; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3 3 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>
                </svg>
              </div>
              <div>
                <div style="font-weight: 700; font-size: 0.9rem; color: var(--color-primary-900);">4-Seater Sedans</div>
                <div style="font-size: 0.8rem; color: var(--color-text-secondary);">Dzire, Etios, Aura — steady daily corporate shift trips</div>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 12px; background: var(--color-primary-50); padding: 12px 14px; border-radius: 8px; border-left: 4px solid var(--color-primary-600);">
              <div style="width: 2rem; height: 2rem; border-radius: 6px; background: #CEE0FD; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="10" width="18" height="7" rx="2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 10l2-5h10l2 5"/><line x1="12" y1="5" x2="12" y2="10"/>
                </svg>
              </div>
              <div>
                <div style="font-weight: 700; font-size: 0.9rem; color: var(--color-primary-900);">6 & 7 Seater MUV / SUV</div>
                <div style="font-size: 0.8rem; color: var(--color-text-secondary);">Ertiga, XL6, Innova Crysta — premium executive & airport tariffs</div>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 12px; background: #DCFCE7; padding: 12px 14px; border-radius: 8px; border-left: 4px solid #16A34A;">
              <div style="width: 2rem; height: 2rem; border-radius: 6px; background: #BBF7D0; color: #166534; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>
                </svg>
              </div>
              <div>
                <div style="font-weight: 700; font-size: 0.9rem; color: #166534;">₹2,000 Bonus Credited to Bank</div>
                <div style="font-size: 0.75rem; color: #15803D;">Direct IMPS / UPI payout • Terms and conditions apply</div>
              </div>
            </div>
          </div>

          <a href="#onboarding" class="btn btn-accent" style="width: 100%; text-align: center; display: block;">
            Join Us & Claim ₹2,000 Bonus* →
          </a>
          <div style="font-size: 0.7rem; color: var(--color-text-muted); text-align: center; margin-top: 8px;">
            * Terms and conditions apply. Applicable for verified commercial drivers only.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Driver Benefits 4-Column Grid -->
  <section class="section-padding">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-primary">Partner First</span>
        <h2 class="h2-title">Why Telangana & Hyderabad Commercial Drivers Choose AdhocX</h2>
        <p class="body-large">Built with dignity, fair pricing, and full financial transparency for 4 & 7 seater drivers.</p>
      </div>

      <div class="portal-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6);">
        <div class="card" data-animate>
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: var(--color-primary-50); color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-3);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <h3 class="h4-title" style="margin-bottom: 0.5rem;">Pre-Scheduled Corporate Shifts</h3>
          <p class="body-text">
            No unpredictable roaming or dry running. Get confirmed airport pickups, tech-park shift drops, and executive duties across Hyderabad and regional corridors.
          </p>
        </div>

        <div class="card" data-animate>
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: var(--color-primary-50); color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-3);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3 class="h4-title" style="margin-bottom: 0.5rem;">1-Hour Bank Payouts</h3>
          <p class="body-text">
            Automatic weekly settlement every Monday, or trigger instant on-demand cashouts directly to your bank account within 1 hour.
          </p>
        </div>

        <div class="card" data-animate>
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: var(--color-primary-50); color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-3);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="h4-title" style="margin-bottom: 0.5rem;">₹5 Lakh Accidental Cover</h3>
          <p class="body-text">
            Every active AdhocX partner driver receives comprehensive group accidental insurance coverage of up to ₹5,00,000.
          </p>
        </div>

        <div class="card" data-animate>
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: var(--color-primary-50); color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-3);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="h4-title" style="margin-bottom: 0.5rem;">24/7 Dedicated Driver Helpline</h3>
          <p class="body-text">
            Real human support staff in Kannada, Telugu, Hindi, and English ready to assist with route issues, toll disputes, or emergencies.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Step-by-Step Onboarding Flow & Document Checklist -->
  <section class="section-padding" id="onboarding" style="background: var(--color-surface-muted);">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-primary">Simple Onboarding</span>
        <h2 class="h2-title">Get Verified in 4 Quick Steps (Under 24 Hours)</h2>
        <p class="body-large">Our digital document verification gets you on the road and earning immediately.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-6); margin-bottom: var(--space-10);">
        <div class="card" style="position: relative;" data-animate>
          <div class="step-number">1</div>
          <h3 class="h4-title" style="margin-bottom: 0.5rem;">Register & Install App</h3>
          <p class="body-text">
            Download the AdhocX Driver Partner app or submit your mobile number on our portal.
          </p>
        </div>

        <div class="card" style="position: relative;" data-animate>
          <div class="step-number">2</div>
          <h3 class="h4-title" style="margin-bottom: 0.5rem;">Upload KYC & Vehicle Docs</h3>
          <p class="body-text">
            Upload photos of your Commercial DL, Yellow Plate RC (4 or 7 Seater), Insurance, and Fitness certificates.
          </p>
        </div>

        <div class="card" style="position: relative;" data-animate>
          <div class="step-number">3</div>
          <h3 class="h4-title" style="margin-bottom: 0.5rem;">24-Hr Verification</h3>
          <p class="body-text">
            Our ops team verifies commercial yellow board compliance and activates your driver account.
          </p>
        </div>

        <div class="card" style="position: relative;" data-animate>
          <div class="step-number" style="background: var(--color-amber-50); color: var(--color-amber-700);">4</div>
          <h3 class="h4-title" style="margin-bottom: 0.5rem;">Accept Trips & Earn Bonus*</h3>
          <p class="body-text">
            Start accepting corporate trips, fulfill requirements, and receive your ₹2,000 bonus (T&C apply).
          </p>
        </div>
      </div>

      <!-- Required Document Checklist Box -->
      <div class="card" style="padding: var(--space-8); border: 1px solid var(--color-border); max-width: 800px; margin: 0 auto;" data-animate>
        <h3 class="h3-title" style="margin-bottom: var(--space-4); text-align: center;">Required Document Checklist</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4);">
          <div style="display: flex; align-items: flex-start; gap: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <strong>Commercial Driving License (TR Badge)</strong>
              <div class="text-caption">Valid transport license issued by RTO / RTA</div>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <strong>Yellow Board Vehicle RC (4 or 7 Seater)</strong>
              <div class="text-caption">Commercial taxi registration document</div>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <strong>Commercial Vehicle Insurance</strong>
              <div class="text-caption">Valid commercial comprehensive policy</div>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <strong>Vehicle Fitness Certificate (FC)</strong>
              <div class="text-caption">Mandatory valid commercial fitness certificate</div>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <strong>Aadhaar Card & PAN Card</strong>
              <div class="text-caption">For identity & tax verification</div>
            </div>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <strong>Bank Passbook / UPI ID</strong>
              <div class="text-caption">For direct instant weekly earnings settlement</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Driver FAQ Section -->
  <section class="section-padding">
    <div class="container" style="max-width: 800px;">
      <div class="section-header" style="text-align: center;">
        <span class="badge badge-primary">Driver Questions</span>
        <h2 class="h2-title">Frequently Asked Questions</h2>
      </div>

      <div style="display: flex; flex-direction: column; gap: var(--space-4);">
        <details class="card" style="padding: var(--space-4) var(--space-6); cursor: pointer;">
          <summary style="font-weight: 700; font-size: 1.05rem; color: var(--color-text-primary);">
            How does the ₹2,000 bonus work?
          </summary>
          <p class="body-text" style="margin-top: var(--space-3); color: var(--color-text-secondary);">
            Join AdhocX as a commercial driver partner in Telangana or Hyderabad, complete your onboarding documentation, and start fulfilling corporate rides. The ₹2,000 bonus is credited directly into your verified bank account upon meeting the 100-ride milestone. Terms and conditions apply.
          </p>
        </details>

        <details class="card" style="padding: var(--space-4) var(--space-6); cursor: pointer;">
          <summary style="font-weight: 700; font-size: 1.05rem; color: var(--color-text-primary);">
            Which vehicles are eligible?
          </summary>
          <p class="body-text" style="margin-top: var(--space-3); color: var(--color-text-secondary);">
            We cater exclusively to commercial yellow-plate 4-seater sedans (Maruti Dzire, Toyota Etios, Hyundai Aura) and 6/7-seater MUVs and SUVs (Maruti Ertiga, XL6, Toyota Innova Crysta). Private white-plate cars are strictly not permitted.
          </p>
        </details>

        <details class="card" style="padding: var(--space-4) var(--space-6); cursor: pointer;">
          <summary style="font-weight: 700; font-size: 1.05rem; color: var(--color-text-primary);">
            What is the 1-Hour Bank Payout guarantee?
          </summary>
          <p class="body-text" style="margin-top: var(--space-3); color: var(--color-text-secondary);">
            In addition to our regular scheduled Monday settlements, driver partners can request on-demand cashouts anytime via the app. Funds are transferred via IMPS/UPI rails directly into your bank account within 1 hour.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta-section" style="background: linear-gradient(180deg, var(--color-primary-50) 0%, #FFFFFF 100%); border-top: 1px solid var(--color-border); padding: var(--space-16) 0;">
    <div class="container" style="position: relative; z-index: 1; text-align: center; max-width: 800px;">
      <h2 class="h2-title" style="color: var(--color-text-primary); margin-bottom: var(--space-4);">Ready to Earn More with Every Kilometre?</h2>
      <p class="body-large" style="color: var(--color-text-secondary); max-width: 580px; margin: 0 auto var(--space-8);">
        Download the <strong style="color: var(--color-primary-700);">Adhoc<span style="color: var(--color-accent-base);">X</span></strong> Driver App today, complete your verification, and join us to claim your ₹2,000 bonus (Terms & Conditions Apply*).
      </p>
      <div class="cta-actions" style="margin-top: 0; justify-content: center;">
        <a href="https://play.google.com/store/apps/details?id=com.adhocx.app&pcampaignid=web_share" target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-large">
          Download Driver App (Google Play)
        </a>
        <a href="tel:+919390366116" class="btn btn-secondary btn-large">
          Call Driver Ops (+91-9390366116)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
