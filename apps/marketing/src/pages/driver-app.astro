---
import BaseLayout from '../layouts/BaseLayout.astro';

// Comprehensive Schema.org JSON-LD for Driver Partner Mobile Application & Network
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.adhocx.com/driver-app#webpage",
      "url": "https://www.adhocx.com/driver-app",
      "name": "AdhocX Driver Partner Program | Commercial Cab Owners Hyderabad",
      "description": "Join the AdhocX driver partner network in Hyderabad. Onboard eligible yellow-plate commercial vehicles, receive pre-scheduled corporate route offers, and get direct bank settlements.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://www.adhocx.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Driver Mobile App",
            "item": "https://www.adhocx.com/driver-app"
          }
        ]
      }
    },
    {
      "@type": "MobileApplication",
      "@id": "https://www.adhocx.com/driver-app#app",
      "name": "AdhocX Driver Partner Mobile App",
      "operatingSystem": "Android",
      "applicationCategory": "BusinessApplication",
      "downloadUrl": "https://play.google.com/store/apps/details?id=com.adhocx.app",
      "publisher": {
        "@type": "Organization",
        "name": "AdhocX",
        "legalName": "Estemporaneo Technologies Private Limited",
        "url": "https://www.adhocx.com",
        "telephone": "+91-7893545818",
        "email": "support@adhocx.com"
      },
      "description": "Official driver partner application for verified independent commercial cab drivers operating enterprise employee routes across Hyderabad. Features direct onboarding, advance shift offers, ordered turn-by-turn navigation, and automated bank settlements.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    }
  ]
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Driver Mobile App', url: '/driver-app' }
];
---

<BaseLayout
  title="AdhocX Driver Partner Program | Commercial Cab Owners Hyderabad"
  description="Join the AdhocX driver partner network in Hyderabad. Onboard eligible yellow-plate commercial vehicles, receive pre-scheduled corporate route offers, and get direct bank settlements."
  canonical="https://www.adhocx.com/driver-app"
  ogTitle="AdhocX Driver Partner Program | Commercial Cab Owners Hyderabad"
  ogDescription="Onboard eligible yellow-plate commercial vehicles directly with AdhocX. Pre-scheduled corporate shift rosters, 100% direct bank settlements, and 24-hr activation."
  ogImage="https://www.adhocx.com/images/drivers/hero-driver-partner.jpg"
  ogImageAlt="AdhocX Driver Partner Program for Commercial Yellow-Plate Cab Owners in Hyderabad"
  activeNav="driver-app"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <!-- =========================================================================
       SECTION 1: HERO SECTION
       "Drive with Dignity. Pre-Scheduled Corporate Routes & Direct Bank Settlements."
       ========================================================================= -->
  <section class="drv-hero-section" id="hero">
    <div class="drv-hero-bg-grid"></div>
    <div class="container drv-hero-container">
      <div class="drv-hero-grid">
        <!-- Left Hero Column: Copy & CTAs -->
        <div class="drv-hero-content">
          <!-- Eyebrow Badge -->
          <div class="drv-eyebrow-badge">
            <span class="drv-pulse-dot"></span>
            <span>Driver Partner Network &bull; Commercial Yellow-Plate Chauffeurs</span>
          </div>

          <!-- Main H1 Title -->
          <h1 class="drv-hero-h1">
            Drive with Dignity.
          </h1>

          <!-- Supporting Headline -->
          <h2 class="drv-hero-subhead">
            Pre-Scheduled Corporate Routes &amp; Direct Bank Settlements.
          </h2>

          <!-- Description -->
          <p class="drv-hero-desc">
            AdhocX onboards independent commercial cab owners directly to fulfill verified employee shift routes across Hyderabad. No middleman brokers, no arbitrary commissions, and transparent route terms before you accept.
          </p>

          <!-- Primary & Secondary CTA Buttons -->
          <div class="drv-hero-actions">
            <a href="#onboarding" class="btn-pill-primary drv-btn-primary" id="btn-view-onboarding">
              <span>View Onboarding Requirements</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a 
              href="https://play.google.com/store/apps/details?id=com.adhocx.app" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-pill-secondary drv-btn-secondary"
              id="btn-hero-play-store"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3.609 1.814L13.793 12 3.61 22.186a2.372 2.372 0 0 1-.61-.914V2.728c.15-.36.368-.679.609-.914zm11.233 11.235l2.424 2.424-11.838 6.786 9.414-9.21zm2.424-2.098l3.197 1.832c.983.563.983 1.48 0 2.044l-3.197 1.832-2.316-2.316 2.316-3.392zm-2.424-.326L5.428 1.411l11.838 6.786-2.424 2.428z"/>
              </svg>
              <span>Download Driver App (Google Play)</span>
            </a>
          </div>

          <!-- Value Checks -->
          <div class="drv-hero-checks">
            <div class="drv-check-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>Pre-Scheduled Shift Rosters</span>
            </div>
            <div class="drv-check-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>Direct Bank Account Payouts</span>
            </div>
            <div class="drv-check-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>24 Business-Hour Activation</span>
            </div>
          </div>
        </div>

        <!-- Right Hero Column: Driver & Vehicle Photography Card -->
        <div class="drv-hero-visual-wrapper">
          <div class="drv-hero-image-card">
            <img 
              src="/images/drivers/hero-driver-partner.jpg" 
              alt="Professional commercial yellow-plate cab driver in Hyderabad with vehicle"
              class="drv-hero-photo"
              width="1200"
              height="800"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 2: COMMERCIAL VEHICLE ELIGIBILITY
       "Strictly Commercial Yellow-Plate Vehicles"
       ========================================================================= -->
  <section class="drv-eligibility-section" id="eligibility">
    <div class="container">
      <div class="drv-section-header">
        <div class="drv-eyebrow-badge">
          <span class="drv-pulse-dot"></span>
          <span>Partner Verification Standard</span>
        </div>
        <h2 class="drv-section-h2">Strictly Commercial Yellow-Plate Vehicles</h2>
        <p class="drv-section-desc">
          To maintain enterprise safety contracts, AdhocX only onboards commercially registered, insured, and permit-holding passenger vehicles.
        </p>
      </div>

      <!-- 3 Eligibility Cards -->
      <div class="drv-eligibility-grid">
        <!-- Card 1: 4-Seater Sedans -->
        <div class="drv-eligibility-card">
          <div class="drv-card-top-icon box-purple">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="2" y="7" width="20" height="12" rx="2"></rect>
              <circle cx="7" cy="19" r="2"></circle>
              <circle cx="17" cy="19" r="2"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
            </svg>
          </div>
          <div class="drv-card-badge">Yellow-Plate T/TR Board</div>
          <h3 class="drv-card-h3">Eligible 4-Seater Sedans</h3>
          <p class="drv-card-p">
            Maruti Dzire, Toyota Etios, Hyundai Aura, Tata Tigor EV (Yellow-Plate T/TR registration).
          </p>
          <ul class="drv-card-specs">
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> AC Sedan with commercial yellow registration</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Clean, sanitized interiors &amp; working seatbelts</li>
          </ul>
        </div>

        <!-- Card 2: 6/7-Seater MUVs & SUVs -->
        <div class="drv-eligibility-card">
          <div class="drv-card-top-icon box-purple">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3 3 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
              <circle cx="7" cy="17" r="2"></circle>
              <circle cx="17" cy="17" r="2"></circle>
            </svg>
          </div>
          <div class="drv-card-badge">Yellow Board MUVs</div>
          <h3 class="drv-card-h3">Eligible 6/7-Seater MUVs &amp; SUVs</h3>
          <p class="drv-card-p">
            Maruti Ertiga, XL6, Kia Carens, Toyota Innova Crysta (Commercial yellow board).
          </p>
          <ul class="drv-card-specs">
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> High-capacity employee shift roasters</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Executive airport and client delegation mobility</li>
          </ul>
        </div>

        <!-- Card 3: Direct Contract Model -->
        <div class="drv-eligibility-card drv-card-contract">
          <div class="drv-card-top-icon box-green">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <div class="drv-card-badge badge-green">Direct Bank Transfer</div>
          <h3 class="drv-card-h3">Direct Contract Model</h3>
          <p class="drv-card-p">
            You contract directly with AdhocX. Payouts are made straight to your verified bank account without intermediary cuts.
          </p>
          <ul class="drv-card-specs">
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> No middleman brokers or arbitrary commission cuts</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Automated electronic bank transfers with UTR proofs</li>
          </ul>
        </div>
      </div>

      <!-- Prominent Fleet Image Showcase -->
      <div class="drv-fleet-showcase-box">
        <div class="drv-fleet-img-wrap">
          <img
            src="/corporate-cab-fleet.jpg"
            alt="AdhocX Commercial 4-Seater and 7-Seater Fleet for Verified Drivers"
            width="1376"
            height="768"
            class="drv-fleet-img"
            loading="lazy"
          />
          <div class="drv-fleet-caption">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            <span>Verified Commercial Fleet &bull; HITEC City, Gachibowli &amp; Financial District Corridors</span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 3: DRIVER PARTNER TECHNOLOGY (6 FEATURES)
       "Everything You Need to Manage Your Shifts"
       ========================================================================= -->
  <section class="drv-tech-section" id="technology">
    <div class="container">
      <div class="drv-section-header">
        <div class="drv-eyebrow-badge">
          <span class="drv-pulse-dot"></span>
          <span>Driver Partner Technology</span>
        </div>
        <h2 class="drv-section-h2">Everything You Need to Manage Your Shifts</h2>
        <p class="drv-section-desc">
          Built for operational ease, quick boarding verification, and zero payment disputes.
        </p>
      </div>

      <!-- 6 Feature Cards Grid -->
      <div class="drv-tech-grid">
        <!-- Feature 1: Paperless Onboarding & Verification -->
        <div class="drv-tech-card">
          <div class="drv-tech-icon-box">
            <!-- Lucide FileCheck -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <polyline points="9 15 11 17 15 13"></polyline>
            </svg>
          </div>
          <h3 class="drv-tech-title">Paperless Onboarding &amp; Verification</h3>
          <p class="drv-tech-p">
            Upload your commercial driving license, vehicle RC, RTA fitness, insurance, and bank account details directly through the app. Digital review and activation within 24 business hours.
          </p>
        </div>

        <!-- Feature 2: Pre-Scheduled Route Offers -->
        <div class="drv-tech-card">
          <div class="drv-tech-icon-box">
            <!-- Lucide CalendarClock -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
              <circle cx="12" cy="14" r="2"></circle>
            </svg>
          </div>
          <h3 class="drv-tech-title">Pre-Scheduled Route Offers</h3>
          <p class="drv-tech-p">
            Receive advance shift offers showing exact pickup zone, scheduled pickup time, stop count, total route distance, and agreed contracted payout before you accept.
          </p>
        </div>

        <!-- Feature 3: Ordered Stops & Boarding Scanner -->
        <div class="drv-tech-card">
          <div class="drv-tech-icon-box">
            <!-- Lucide MapPin / QrCode -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3 class="drv-tech-title">Ordered Stops &amp; Boarding Scanner</h3>
          <p class="drv-tech-p">
            Integrated turn-by-turn navigation guides you to each employee's pickup waypoint. Verify passenger boarding instantly using dynamic 4-digit OTP or QR code.
          </p>
        </div>

        <!-- Feature 4: Transparent Payouts to Bank -->
        <div class="drv-tech-card">
          <div class="drv-tech-icon-box">
            <!-- Lucide Landmark / Wallet -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="3" y1="21" x2="21" y2="21"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
              <polyline points="5 10 12 3 19 10"></polyline>
              <line x1="6" y1="10" x2="6" y2="21"></line>
              <line x1="10" y1="10" x2="10" y2="21"></line>
              <line x1="14" y1="10" x2="14" y2="21"></line>
              <line x1="18" y1="10" x2="18" y2="21"></line>
            </svg>
          </div>
          <h3 class="drv-tech-title">Transparent Payouts to Bank</h3>
          <p class="drv-tech-p">
            Earnings are generated automatically upon trip completion. Review submitted, approved, and paid payouts with bank confirmation references in your in-app ledger.
          </p>
        </div>

        <!-- Feature 5: 24/7 Dispatch Desk Assistance -->
        <div class="drv-tech-card">
          <div class="drv-tech-icon-box">
            <!-- Lucide Headset -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
              <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
            </svg>
          </div>
          <h3 class="drv-tech-title">24/7 Dispatch Desk Assistance</h3>
          <p class="drv-tech-p">
            Direct in-app contact with our operations desk for vehicle breakdowns, road blockages, passenger no-shows, or route emergencies.
          </p>
        </div>

        <!-- Feature 6: Compliance Alerts & Safety Training -->
        <div class="drv-tech-card">
          <div class="drv-tech-icon-box">
            <!-- Lucide ShieldCheck -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <h3 class="drv-tech-title">Compliance Alerts &amp; Safety Training</h3>
          <p class="drv-tech-p">
            Proactive alerts before insurance, fitness, or driving licenses expire. Access mandatory corporate passenger etiquette and safety guidelines directly in the app.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 4: REQUIRED ONBOARDING DOCUMENTS
       Section ID: "onboarding"
       ========================================================================= -->
  <section class="drv-onboard-section" id="onboarding">
    <div class="container">
      <div class="drv-onboard-wrapper">
        <div class="drv-section-header">
          <div class="drv-eyebrow-badge">
            <span class="drv-pulse-dot"></span>
            <span>Digital Document Verification</span>
          </div>
          <h2 class="drv-section-h2">Required Onboarding Documents</h2>
          <p class="drv-section-desc">
            All documents can be photographed and uploaded directly within the AdhocX Driver App.
          </p>
        </div>

        <!-- 6 Document Cards -->
        <div class="drv-docs-grid">
          <!-- Doc 1 -->
          <div class="drv-doc-card">
            <div class="drv-doc-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                <circle cx="9" cy="10" r="2"></circle>
                <line x1="15" y1="8" x2="17" y2="8"></line>
                <line x1="15" y1="12" x2="17" y2="12"></line>
                <line x1="7" y1="16" x2="17" y2="16"></line>
              </svg>
            </div>
            <div class="drv-doc-info">
              <div class="drv-doc-num">01</div>
              <h3 class="drv-doc-title">Commercial Driving License (Badge)</h3>
              <p class="drv-doc-desc">Valid commercial endorsement / badge authorizing passenger transport.</p>
            </div>
          </div>

          <!-- Doc 2 -->
          <div class="drv-doc-card">
            <div class="drv-doc-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="7" width="20" height="12" rx="2"></rect>
                <circle cx="7" cy="19" r="2"></circle>
                <circle cx="17" cy="19" r="2"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
              </svg>
            </div>
            <div class="drv-doc-info">
              <div class="drv-doc-num">02</div>
              <h3 class="drv-doc-title">Vehicle Registration Certificate (RC)</h3>
              <p class="drv-doc-desc">Commercial Yellow-Plate (T/TR registration) 4-seater or 7-seater.</p>
            </div>
          </div>

          <!-- Doc 3 -->
          <div class="drv-doc-card">
            <div class="drv-doc-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <div class="drv-doc-info">
              <div class="drv-doc-num">03</div>
              <h3 class="drv-doc-title">Commercial Passenger Insurance</h3>
              <p class="drv-doc-desc">Active comprehensive commercial taxi policy covering passengers.</p>
            </div>
          </div>

          <!-- Doc 4 -->
          <div class="drv-doc-card">
            <div class="drv-doc-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <div class="drv-doc-info">
              <div class="drv-doc-num">04</div>
              <h3 class="drv-doc-title">RTA Commercial Fitness Certificate</h3>
              <p class="drv-doc-desc">Valid roadworthiness &amp; fitness certificate issued by Telangana RTA.</p>
            </div>
          </div>

          <!-- Doc 5 -->
          <div class="drv-doc-card">
            <div class="drv-doc-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <div class="drv-doc-info">
              <div class="drv-doc-num">05</div>
              <h3 class="drv-doc-title">Aadhaar Card / Verified Identity Proof</h3>
              <p class="drv-doc-desc">Government-issued identity proof for driver KYC and verification.</p>
            </div>
          </div>

          <!-- Doc 6 -->
          <div class="drv-doc-card">
            <div class="drv-doc-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
