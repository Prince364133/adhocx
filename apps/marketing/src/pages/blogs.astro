---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

interface BlogItem {
  id: string;
  slug: string;
  title: string;
  category: string;
  readTime: string;
  date: string;
  author: string;
  summary: string;
}

const SEED_ARTICLES: BlogItem[] = [
  {
    id: 'seed-1',
    slug: 'how-adhocx-reverse-auction-cuts-enterprise-cab-costs',
    title: 'How Automated Algorithmic Dispatch Cuts Enterprise Corporate Cab Costs',
    category: 'Corporate Mobility',
    readTime: '4 min read',
    date: 'Oct 15, 2026',
    author: 'AdhocX Fleet Operations Research',
    summary: 'Discover how programmatic driver pairing and instant fulfillment eliminate middlemen broker markups for corporate logistics and spot employee transit in Hyderabad.'
  },
  {
    id: 'seed-2',
    slug: 'commercial-4-seater-and-7-seater-driver-economics',
    title: 'Commercial Driver Economics: 4-Seater Sedans vs 7-Seater MUVs in Hyderabad',
    category: 'Driver Welfare & Earnings',
    readTime: '5 min read',
    date: 'Oct 10, 2026',
    author: 'AdhocX Driver Community Desk',
    summary: 'An operational breakdown of fuel efficiency, daily run tariffs, and how the Century Milestone bonus maximizes monthly net driver payouts.'
  },
  {
    id: 'seed-3',
    slug: '1-hour-bank-refund-sla-in-corporate-mobility',
    title: 'The 1-Hour Bank Refund SLA: Establishing Financial Recourse in B2B Fleet Transit',
    category: 'Compliance & Financial SLAs',
    readTime: '4 min read',
    date: 'Sep 28, 2026',
    author: 'AdhocX Legal & Finance Desk',
    summary: 'Why enterprise transport desks cannot afford locked balances in consumer cab wallets, and how instant IMPS/UPI refund rails transform corporate travel procurement.'
  },
  {
    id: 'seed-4',
    slug: 'hyderabad-tech-park-employee-transit-compliance',
    title: 'Hyderabad Tech Park Transit Compliance: Yellow-Plate Regulations in HITEC City & Gachibowli',
    category: 'Regulatory Compliance',
    readTime: '6 min read',
    date: 'Sep 18, 2026',
    author: 'AdhocX Regulatory Affairs',
    summary: 'Key legal obligations under the Telangana Motor Vehicles Act regarding commercial fitness, passenger insurance, and police verification for corporate staff transport.'
  }
];

let posts: BlogItem[] = [];

try {
  const apiUrl =
    process.env.API_URL ||
    process.env.PUBLIC_API_URL ||
    'http://localhost:7001/api/v1';

  const res = await fetch(`${apiUrl}/blogs?status=PUBLISHED&limit=10`, {
    headers: { 'Content-Type': 'application/json' },
  });

  if (res.ok) {
    const json = await res.json();
    const rawList = Array.isArray(json?.data?.items)
      ? json.data.items
      : Array.isArray(json?.items)
      ? json.items
      : Array.isArray(json)
      ? json
      : [];

    const fetchedPosts = rawList.map((p: any) => {
      const pubDate = p.publishedAt ? new Date(p.publishedAt) : new Date(p.createdAt || Date.now());
      const formattedDate = pubDate.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      });

      return {
        id: p.id,
        slug: p.slug,
        title: p.title,
        category: p.category || 'Enterprise Mobility',
        readTime: p.readTime || '5 min read',
        date: formattedDate,
        author: p.authorName ? `${p.authorName} (${p.authorRole || 'AdhocX Desk'})` : 'AdhocX Logistics Operations Desk',
        summary: p.excerpt || p.seoDescription || (p.content ? p.content.substring(0, 160) + '...' : ''),
      };
    });

    posts = fetchedPosts.length > 0 ? fetchedPosts : SEED_ARTICLES;
  } else {
    posts = SEED_ARTICLES;
  }
} catch (e) {
  // Static build fallback ensures search engine spiders always crawl rich content
  posts = SEED_ARTICLES;
}

const featuredPost = posts.length > 0 ? posts[0] : null;
const remainingPosts = posts.length > 1 ? posts.slice(1) : [];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "AdhocX Commercial Transport Insights & Tech Blog",
  "url": "https://www.adhocx.com/blogs",
  "description": "Insights, engineering deep dives, and operational strategies for B2B fleet logistics, commercial drivers, and corporate mobility in Hyderabad."
};
---

<BaseLayout
  title="AdhocX Insights — Corporate Fleet Mobility, Driver Welfare & Logistics Tech"
  description="Explore research and operational analyses on corporate transport management, commercial driver economics, milestone bonuses, and transport compliance in Hyderabad."
  canonical="https://www.adhocx.com/blogs"
  activeNav="blogs"
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Insights & Blog', url: '/blogs' }
  ]}
>
  <!-- Blog Hero -->
  <section class="hero-section" style="background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);">
    <div class="container" style="text-align: center; max-width: 800px;">
      <span class="badge badge-info" style="margin-bottom: var(--space-3);">
        <Icon name="file-text" size={14} color="var(--color-info)" />
        AdhocX Editorial & Logistics Research
      </span>
      <h1 class="display-title" style="margin-bottom: var(--space-4);">
        Commercial Transport, Digitized & Demystified.
      </h1>
      <p class="body-large" style="margin: 0 auto;">
        Perspectives on corporate mobility operations, commercial driver economics, 1-hour refund architectures, and enterprise logistics compliance across Hyderabad.
      </p>
    </div>
  </section>

  <!-- Featured Blog Post Banner -->
  {featuredPost && (
    <section class="section-padding" style="padding-top: 0;">
      <div class="container">
        <div class="card featured-blog-card" data-animate>
          <div style="display: flex; gap: var(--space-4); align-items: center; margin-bottom: var(--space-3); flex-wrap: wrap;">
            <span class="badge badge-primary">Featured Analysis</span>
            <span style="font-size: 0.85rem; color: var(--color-text-muted);">
              {featuredPost.category} • {featuredPost.readTime} • {featuredPost.date}
            </span>
          </div>
          <h2 class="h2-title" style="margin-bottom: var(--space-3); color: var(--color-primary-900);">
            {featuredPost.title}
          </h2>
          <p class="body-large" style="margin-bottom: var(--space-6); color: var(--color-text-secondary);">
            {featuredPost.summary}
          </p>
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4);">
            <div style="font-size: 0.875rem; color: var(--color-text-secondary);">
              By <strong style="color: var(--color-primary-900);">{featuredPost.author}</strong>
            </div>
            <a href={`/blogs/${featuredPost.slug}`} class="btn btn-primary">
              Read Full Article →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Blog Post Grid -->
  <section class="section-padding" style="background: var(--color-surface-muted);">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-primary">Knowledge Hub</span>
        <h2 class="h2-title">Latest Articles & Operational Whitepapers</h2>
        <p class="body-large">Curated insights for facilities directors, corporate travel leads, and commercial chauffeurs.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-6);">
        {remainingPosts.map((post) => (
          <article class="card blog-card" data-animate>
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3);">
                <span class="badge badge-info">{post.category}</span>
                <span style="font-size: 0.75rem; color: var(--color-text-muted); display: inline-flex; align-items: center; gap: 4px;">
                  <Icon name="clock" size={12} color="var(--color-text-muted)" />
                  {post.readTime}
                </span>
              </div>
              <h3 class="h4-title" style="margin-bottom: var(--space-2); line-height: 1.4;">
                <a href={`/blogs/${post.slug}`} style="color: inherit; text-decoration: none;">
                  {post.title}
                </a>
              </h3>
              <p class="body-text" style="color: var(--color-text-secondary); margin-bottom: var(--space-4); font-size: 0.9rem;">
                {post.summary}
              </p>
            </div>
            <div style="border-top: 1px solid var(--color-border); padding-top: var(--space-4); display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.8rem; color: var(--color-text-muted);">{post.date}</span>
              <a href={`/blogs/${post.slug}`} class="blog-read-link">
                Read Article →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter & Updates Section -->
  <section class="section-padding">
    <div class="container" style="max-width: 720px; text-align: center;">
      <span class="badge badge-success">
        <Icon name="mail" size={14} color="var(--color-success)" />
        Stay Informed
      </span>
      <h2 class="h2-title" style="margin-top: var(--space-2); margin-bottom: var(--space-3);">
        Subscribe to AdhocX Fleet Dispatch
      </h2>
      <p class="body-large" style="margin-bottom: var(--space-6);">
        Receive monthly briefings on corporate transport policy, GST tax updates for mobility, and fleet optimization tech directly in your inbox.
      </p>

      <form id="newsletter-form" style="display: flex; gap: var(--space-3); max-width: 520px; margin: 0 auto; flex-wrap: wrap;">
        <input
          id="newsletter-email"
          type="email"
          required
          placeholder="Enter your official work email"
          aria-label="Work email address"
          style="flex: 1; min-width: 240px; min-height: 44px; padding: 12px 16px; border-radius: var(--radius-md); border: 1px solid var(--color-border); font-size: 0.95rem; outline: none;"
        />
        <button id="newsletter-submit-btn" type="submit" class="btn btn-primary" style="min-height: 44px;">
          Subscribe Briefing
        </button>
      </form>
      <div id="newsletter-feedback" style="margin-top: 14px; font-size: 0.9rem; font-weight: 500; display: none;" role="status"></div>
    </div>
  </section>

  <script>
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
    const submitBtn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement | null;
    const feedback = document.getElementById('newsletter-feedback') as HTMLDivElement | null;

    if (form && emailInput && submitBtn && feedback) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (!email) return;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Subscribing...';
        feedback.style.display = 'none';

        try {
          const res = await fetch('/api/newsletter/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });

          if (res.ok) {
            feedback.style.display = 'block';
            feedback.style.color = 'var(--color-success)';
            feedback.textContent = 'Subscribed successfully! You will receive our next monthly fleet briefing.';
            emailInput.value = '';
          } else {
            feedback.style.display = 'block';
            feedback.style.color = 'var(--color-primary-600)';
            feedback.textContent = 'Thank you for your interest! Newsletter confirmation will be sent shortly.';
            emailInput.value = '';
          }
        } catch {
          feedback.style.display = 'block';
          feedback.style.color = 'var(--color-primary-600)';
          feedback.textContent = 'Thank you for your interest! Newsletter confirmation will be sent shortly.';
          emailInput.value = '';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Subscribe Briefing';
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .featured-blog-card {
    padding: var(--space-8);
    border: 2px solid var(--color-primary-500);
    background: linear-gradient(135deg, #EFF6FF 0%, #FFFFFF 100%);
    box-shadow: var(--shadow-md);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .blog-read-link {
    color: var(--color-primary-600);
    font-weight: 600;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color var(--transition-fast);
  }

  .blog-read-link:hover {
    color: var(--color-primary-800);
    text-decoration: underline;
  }
</style>
