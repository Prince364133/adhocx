---
import BaseLayout from '../layouts/BaseLayout.astro';

interface BlogItem {
  id: string;
  slug: string;
  title: string;
  category: string;
  readTime: string;
  date: string;
  author: string;
  summary: string;
}

let posts: BlogItem[] = [];

try {
  const apiUrl =
    process.env.API_URL ||
    process.env.PUBLIC_API_URL ||
    'http://localhost:7001/api/v1';

  const res = await fetch(`${apiUrl}/blogs?status=PUBLISHED&limit=10`, {
    headers: { 'Content-Type': 'application/json' },
  });

  if (res.ok) {
    const json = await res.json();
    const rawList = Array.isArray(json?.data?.items)
      ? json.data.items
      : Array.isArray(json?.items)
      ? json.items
      : Array.isArray(json)
      ? json
      : [];

    posts = rawList.map((p: any) => {
      const pubDate = p.publishedAt ? new Date(p.publishedAt) : new Date(p.createdAt || Date.now());
      const formattedDate = pubDate.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      });

      return {
        id: p.id,
        slug: p.slug,
        title: p.title,
        category: p.category || 'Enterprise Mobility',
        readTime: p.readTime || '5 min read',
        date: formattedDate,
        author: p.authorName ? `${p.authorName} (${p.authorRole || 'AdhocX Desk'})` : 'AdhocX Logistics Operations Desk',
        summary: p.excerpt || p.seoDescription || (p.content ? p.content.substring(0, 160) + '...' : ''),
      };
    });
  }
} catch (e) {
  // If API is temporarily unreachable during static build, empty array
  posts = [];
}

const featuredPost = posts.length > 0 ? posts[0] : null;
const remainingPosts = posts.length > 1 ? posts.slice(1) : posts;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "AdhocX Commercial Transport Insights & Tech Blog",
  "url": "https://www.adhocx.com/blogs",
  "description": "Insights, engineering deep dives, and operational strategies for B2B fleet logistics, commercial drivers, and corporate mobility."
};
---

<BaseLayout
  title="AdhocX Insights — Corporate Fleet Mobility, Driver Welfare & Logistics Tech"
  description="Explore articles and operational analyses on corporate transport management, driver partner economics, milestone bonuses, and transport compliance in India."
  canonical="https://www.adhocx.com/blogs"
  activeNav="blogs"
  jsonLd={jsonLd}
>
  <!-- Blog Hero -->
  <section class="hero-section" style="background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);">
    <div class="container" style="text-align: center; max-width: 800px;">
      <span class="badge badge-info" style="margin-bottom: var(--space-3);">AdhocX Editorial & Insights</span>
      <h1 class="display-title" style="margin-bottom: var(--space-4);">Commercial Transport, Digitized & Demystified.</h1>
      <p class="body-large" style="margin: 0 auto;">
        Perspectives on corporate mobility operations, driver partner economics, SLA architectures, and enterprise logistics compliance.
      </p>
    </div>
  </section>

  <!-- Featured Blog Post Banner (Live from PostgreSQL) -->
  {featuredPost && (
    <section class="section-padding" style="padding-top: 0;">
      <div class="container">
        <div class="card" style="padding: var(--space-8); border: 2px solid var(--color-primary-500); background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);" data-animate>
          <div style="display: flex; gap: var(--space-4); align-items: center; margin-bottom: var(--space-3); flex-wrap: wrap;">
            <span class="badge badge-primary">Featured Article</span>
            <span style="font-size: 0.85rem; color: var(--color-text-muted);">{featuredPost.category} • {featuredPost.readTime} • {featuredPost.date}</span>
          </div>
          <h2 class="h2-title" style="margin-bottom: var(--space-3); color: var(--color-primary-600);">
            {featuredPost.title}
          </h2>
          <p class="body-large" style="margin-bottom: var(--space-6); color: var(--color-text);">
            {featuredPost.summary}
          </p>
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4);">
            <div style="font-size: 0.875rem; color: var(--color-text-muted);">
              By <strong>{featuredPost.author}</strong>
            </div>
            <a href={`/blog-detail.html?slug=${featuredPost.slug}`} class="btn btn-primary">Read Full Article →</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Blog Post Grid (Live from PostgreSQL) -->
  <section class="section-padding" style="background: var(--color-surface-muted);">
    <div class="container">
      <div class="section-header">
        <h2 class="h2-title">Latest Articles & Research</h2>
        <p class="body-large">Curated insights for facilities directors, corporate travel leads, and commercial driver partners.</p>
      </div>

      {remainingPosts.length > 0 ? (
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-6);">
          {remainingPosts.map((post) => (
            <article class="card" style="display: flex; flex-direction: column; justify-content: space-between;" data-animate>
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3);">
                  <span class="badge badge-info">{post.category}</span>
                  <span style="font-size: 0.8rem; color: var(--color-text-muted);">{post.readTime}</span>
                </div>
                <h3 class="h4-title" style="margin-bottom: var(--space-3); font-size: 1.15rem; line-height: 1.4;">
                  {post.title}
                </h3>
                <p class="body-text" style="color: var(--color-text-muted); margin-bottom: var(--space-6);">
                  {post.summary}
                </p>
              </div>
              <div style="border-top: 1px solid var(--color-border); padding-top: var(--space-4); display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.8rem; color: var(--color-text-muted);">{post.date}</span>
                <a href={`/blog-detail.html?slug=${post.slug}`} style="font-weight: 700; color: var(--color-primary-600); text-decoration: none; font-size: 0.875rem;">
                  Read Article →
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div style="text-align: center; padding: var(--space-8); color: var(--color-text-muted);">
          <p>No published articles currently found in the marketplace database.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Newsletter & Updates Section (Live API Persistence) -->
  <section class="section-padding">
    <div class="container" style="max-width: 700px; text-align: center;">
      <span class="badge badge-success">Stay Informed</span>
      <h2 class="h2-title" style="margin-top: var(--space-2); margin-bottom: var(--space-3);">Subscribe to AdhocX Fleet Dispatch</h2>
      <p class="body-large" style="margin-bottom: var(--space-6);">
        Receive monthly insights on corporate transport policy, GST tax updates for transport, and mobility tech developments directly in your inbox.
      </p>

      <form id="newsletter-form" style="display: flex; gap: var(--space-3); max-width: 500px; margin: 0 auto; flex-wrap: wrap;">
        <input
          id="newsletter-email"
          type="email"
          required
          placeholder="Enter your official work email"
          style="flex: 1; min-width: 240px; padding: 12px 16px; border-radius: var(--radius-md); border: 1px solid var(--color-border); font-size: 0.95rem; outline: none;"
        />
        <button id="newsletter-submit-btn" type="submit" class="btn btn-primary">Subscribe</button>
      </form>
      <div id="newsletter-feedback" style="margin-top: 14px; font-size: 0.9rem; font-weight: 500; display: none;"></div>
    </div>
  </section>

  <script>
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
    const submitBtn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement | null;
    const feedback = document.getElementById('newsletter-feedback') as HTMLDivElement | null;

    if (form && emailInput && submitBtn && feedback) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (!email) return;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Subscribing...';
        feedback.style.display = 'none';

        try {
          const apiUrl =
            window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
              ? 'http://localhost:7001/api/v1'
              : 'https://api.adhocx.com/api/v1';

          const res = await fetch(`${apiUrl}/leads/newsletter`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });

          const data = await res.json();
          if (res.ok) {
            feedback.style.display = 'block';
            feedback.style.color = '#15803d';
            feedback.textContent = '✓ ' + (data?.data?.message || 'Thank you for subscribing to AdhocX Fleet Dispatch!');
            emailInput.value = '';
          } else {
            throw new Error(data?.error?.message || data?.message || 'Subscription failed');
          }
        } catch (err: any) {
          feedback.style.display = 'block';
          feedback.style.color = '#b91c1c';
          feedback.textContent = '⚠️ ' + (err.message || 'Could not subscribe. Please try again.');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Subscribe';
        }
      });
    }
  </script>
</BaseLayout>
