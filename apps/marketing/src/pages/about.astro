---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About AdhocX — Estemporaneo Technologies Private Limited",
  "url": "https://www.adhocx.com/about",
  "description": "Estemporaneo Technologies Private Limited (AdhocX) is modernizing enterprise employee transportation across Hyderabad tech corridors through direct-to-driver fleet governance, PostGIS routing automation, and zero vendor cartels.",
  "publisher": {
    "@type": "Organization",
    "name": "Estemporaneo Technologies Private Limited",
    "alternateName": "AdhocX",
    "url": "https://www.adhocx.com",
    "logo": "https://www.adhocx.com/assets/logo.png",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Level 4, Cyber Gateway, HITEC City",
      "addressLocality": "Hyderabad",
      "addressRegion": "Telangana",
      "postalCode": "500081",
      "addressCountry": "IN"
    }
  }
};
---

<BaseLayout
  title="About AdhocX — Corporate Mobility Infrastructure & Governance | Hyderabad"
  description="Learn how Estemporaneo Technologies Private Limited (AdhocX) transforms enterprise ground transport across HITEC City, Gachibowli, and Financial District through direct-to-driver fleet governance, PostGIS automation, and zero vendor cartels."
  canonical="https://www.adhocx.com/about"
  activeNav="company"
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="page-hero-section" style="background: linear-gradient(180deg, var(--color-primary-50) 0%, #ffffff 100%); padding: var(--space-16) 0 var(--space-12);">
    <div class="container text-center" style="max-width: 860px; margin: 0 auto;">
      <div class="badge badge-blue" style="margin-bottom: var(--space-4);">
        <span class="status-dot-pulse"></span>
        <span>Corporate Mobility Infrastructure &bull; Hyderabad Corridors</span>
      </div>
      <h1 class="display-title" style="color: var(--color-text-primary); margin-bottom: var(--space-6);">
        Building India's Most Transparent Corporate Mobility Infrastructure.
      </h1>
      <p class="body-large" style="color: var(--color-text-secondary); margin-bottom: var(--space-8); line-height: 1.6;">
        Estemporaneo Technologies Private Limited (<span class="logo-text" style="font-size: 1.15em;">Adhoc<span class="logo-accent">X</span></span>) is replacing fragmented cab vendor cartels and manual spreadsheets with an algorithmic, audit-grade enterprise transport operating system built specifically for high-growth tech corridors.
      </p>
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn btn-primary btn-large">
          Schedule Executive Briefing &rarr;
        </a>
        <a href="/ets" class="btn btn-secondary btn-large">
          Explore ETS Platform
        </a>
      </div>
    </div>
  </section>

  <!-- Key Metrics Strip -->
  <section style="background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: var(--space-8) 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-6); text-align: center;">
        <div>
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--color-primary-600); line-height: 1.1;">100%</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: var(--space-2);">Yellow-Plate Commercial Cabs</div>
        </div>
        <div>
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--color-primary-600); line-height: 1.1;">&lt; 15 Sec</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: var(--space-2);">GPS Telemetry Freshness</div>
        </div>
        <div>
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--color-primary-600); line-height: 1.1;">0%</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: var(--space-2);">Vendor Intermediary Cut</div>
        </div>
        <div>
          <div style="font-size: 2.25rem; font-weight: 800; color: var(--color-primary-600); line-height: 1.1;">1 Hour</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: var(--space-2);">Bank SLA Dispute Refund</div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Legacy Failure vs AdhocX Direct Architecture -->
  <section style="padding: var(--space-16) 0; background: var(--color-surface-muted);">
    <div class="container">
      <div class="text-center" style="max-width: 760px; margin: 0 auto var(--space-12);">
        <span class="badge badge-warm" style="margin-bottom: var(--space-3);">Structural Industry Shift</span>
        <h2 style="font-size: 2rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-4);">
          Why Legacy Corporate Transport Fails Enterprise Procurement
        </h2>
        <p style="color: var(--color-text-secondary); font-size: 1rem; line-height: 1.6;">
          For decades, Indian corporate employee transportation has been held hostage by multi-layered vendor cartels, unverified subcontracting, and opaque trip billing. We re-engineered the entire operational model from first principles.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-8);">
        <!-- Legacy Model Card -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm);">
          <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-6);">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-error-bg); display: flex; align-items: center; justify-content: center; color: var(--color-error);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary);">The Legacy Vendor Broker Model</h3>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-4); color: var(--color-text-secondary); font-size: 0.9375rem;">
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <span style="color: var(--color-error); font-weight: bold;">&bull;</span>
              <span><strong>Multi-tiered Subcontracting:</strong> Primary vendors sublet demand to secondary and tertiary middlemen, diluting accountability and inflating costs by 20&ndash;35%.</span>
            </li>
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <span style="color: var(--color-error); font-weight: bold;">&bull;</span>
              <span><strong>Falsified Logsheets & Ghost Kilometers:</strong> Manual trip sheets and disconnected GPS devices result in inaccurate billing and unverified employee drops.</span>
            </li>
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <span style="color: var(--color-error); font-weight: bold;">&bull;</span>
              <span><strong>Severe Driver Attrition:</strong> Middlemen delay driver payouts by 45&ndash;90 days, creating sudden no-shows and shift disruptions for campus operations.</span>
            </li>
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <span style="color: var(--color-error); font-weight: bold;">&bull;</span>
              <span><strong>Compliance Blindspots:</strong> Private vehicles (white plates) and expired fitness certificates slip past manual campus security gate checks.</span>
            </li>
          </ul>
        </div>

        <!-- AdhocX Direct-to-Driver Architecture -->
        <div style="background: var(--color-surface); border: 2px solid var(--color-primary-600); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-lg); position: relative;">
          <div style="position: absolute; top: -14px; right: 24px; background: var(--color-primary-600); color: #ffffff; font-size: 0.75rem; font-weight: 700; padding: 4px 12px; border-radius: var(--radius-full); text-transform: uppercase; letter-spacing: 0.05em;">
            The AdhocX Standard
          </div>
          <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-6);">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-primary-50); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary);"><span class="logo-text">Adhoc<span class="logo-accent">X</span></span> Direct-to-Driver Fleet Engine</h3>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-4); color: var(--color-text-secondary); font-size: 0.9375rem;">
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <span style="color: var(--color-primary-600); font-weight: bold;">&bull;</span>
              <span><strong>Direct Corporate Contract:</strong> Enterprise clients contract directly with AdhocX. No vendor intermediaries, broker commissions, or sub-leasing cartels.</span>
            </li>
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <span style="color: var(--color-primary-600); font-weight: bold;">&bull;</span>
              <span><strong>Automated 3-Way Match Billing:</strong> Every billable kilometer is verified against approved roster requests, actual PostGIS GPS breadcrumbs, and contracted rate cards.</span>
            </li>
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <span style="color: var(--color-primary-600); font-weight: bold;">&bull;</span>
              <span><strong>Direct Bank Payouts to Drivers:</strong> Independent cab-owning drivers receive automated weekly bank transfers with zero platform deduction on corporate routes.</span>
            </li>
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <span style="color: var(--color-primary-600); font-weight: bold;">&bull;</span>
              <span><strong>100% Commercial RTA Verification:</strong> Every cab is independently verified for commercial yellow-board registration, active passenger insurance, and driver TR badges.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Company Identity & Governance Pillars -->
  <section style="padding: var(--space-16) 0; background: var(--color-surface);">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center;">
        <div>
          <span class="badge badge-blue" style="margin-bottom: var(--space-3);">Corporate Governance</span>
          <h2 style="font-size: 2rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-4);">
            Estemporaneo Technologies Private Limited
          </h2>
          <p style="color: var(--color-text-secondary); font-size: 1rem; line-height: 1.6; margin-bottom: var(--space-4);">
            Operating under the brand name <span class="logo-text">Adhoc<span class="logo-accent">X</span></span>, Estemporaneo Technologies Private Limited is a registered Indian technology enterprise dedicated to mission-critical employee transport and corporate logistics.
          </p>
          <p style="color: var(--color-text-secondary); font-size: 1rem; line-height: 1.6; margin-bottom: var(--space-6);">
            Our corporate headquarters and regional safety command center are located in the heart of Hyderabad's technology belt at HITEC City. Our engineering and operations teams combine deep spatial algorithms (PostGIS) with real-world fleet command to guarantee passenger safety and predictable transport economics.
          </p>

          <div style="display: flex; flex-direction: column; gap: var(--space-3); border-left: 3px solid var(--color-primary-600); padding-left: var(--space-4); margin-bottom: var(--space-6);">
            <div style="font-weight: 600; color: var(--color-text-primary);">Registered Corporate Office:</div>
            <div style="color: var(--color-text-secondary); font-size: 0.9375rem;">
              Estemporaneo Technologies Private Limited<br />
              Level 4, Cyber Gateway, HITEC City, Madhapur,<br />
              Hyderabad, Telangana &mdash; 500081, India.
            </div>
          </div>

          <div style="display: flex; gap: var(--space-4);">
            <a href="/safety" class="btn btn-outline">
              Review Safety Protocols
            </a>
            <a href="/pricing" class="btn btn-outline">
              Commercial Rate Cards
            </a>
          </div>
        </div>

        <!-- 4 Pillars Grid -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
          <div style="background: var(--color-surface-muted); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--color-primary-50); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600); margin-bottom: var(--space-3);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h4 style="font-size: 1.0625rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">Duty of Care</h4>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin: 0;">
              Mandatory women employee night escort protocols between 8:00 PM and 6:00 AM, sub-15s SOS dispatch, and direct police integration.
            </p>
          </div>

          <div style="background: var(--color-surface-muted); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--color-primary-50); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600); margin-bottom: var(--space-3);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                <line x1="8" y1="2" x2="8" y2="18"></line>
                <line x1="16" y1="6" x2="16" y2="22"></line>
              </svg>
            </div>
            <h4 style="font-size: 1.0625rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">PostGIS Routing</h4>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin: 0;">
              High-density employee clustering algorithm optimizing travel durations to under 60 minutes and cutting empty deadhead kilometers.
            </p>
          </div>

          <div style="background: var(--color-surface-muted); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--color-primary-50); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600); margin-bottom: var(--space-3);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <line x1="6" y1="8" x2="6" y2="8"></line>
                <line x1="10" y1="8" x2="18" y2="8"></line>
                <line x1="6" y1="12" x2="6" y2="12"></line>
                <line x1="10" y1="12" x2="18" y2="12"></line>
              </svg>
            </div>
            <h4 style="font-size: 1.0625rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">Zero Surge Billing</h4>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin: 0;">
              Fixed commercial contract rate cards with transparent fuel indexation. No sudden surge pricing during rain or peak shifts.
            </p>
          </div>

          <div style="background: var(--color-surface-muted); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--color-primary-50); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600); margin-bottom: var(--space-3);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <h4 style="font-size: 1.0625rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">Full Audit Trails</h4>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin: 0;">
              Immutable event logging with UTC timestamps, user identity, and PostGIS coordinates for external statutory and internal finance audits.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Hyderabad Corridors Section -->
  <section style="padding: var(--space-16) 0; background: var(--color-surface-muted); border-top: 1px solid var(--color-border);">
    <div class="container text-center" style="max-width: 800px; margin: 0 auto var(--space-10);">
      <span class="badge badge-warm" style="margin-bottom: var(--space-3);">Regional Operational Footprint</span>
      <h2 style="font-size: 2rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-4);">
        Active Across Hyderabad's Premier Technology Corridors
      </h2>
      <p style="color: var(--color-text-secondary); font-size: 1rem; line-height: 1.6;">
        Our commercial fleet network and dedicated dispatch centers provide round-the-clock employee transit across all major IT, BFSI, and SEZ campuses in Telangana.
      </p>
    </div>

    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6);">
        <div style="background: var(--color-surface); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
          <div style="font-weight: 700; font-size: 1.125rem; color: var(--color-text-primary); margin-bottom: var(--space-2);">HITEC City & Madhapur</div>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-4);">
            Covering Raheja Mindspace, Cyber Towers, Cyber Gateway, V-Ascendas, and Knowledge City tech zones.
          </p>
          <div style="font-size: 0.75rem; font-weight: 600; color: var(--color-primary-600); display: flex; align-items: center; gap: var(--space-2);">
            <span class="status-dot-pulse"></span> 24/7 Primary Command Hub
          </div>
        </div>

        <div style="background: var(--color-surface); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
          <div style="font-weight: 700; font-size: 1.125rem; color: var(--color-text-primary); margin-bottom: var(--space-2);">Gachibowli & Nanakramguda</div>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-4);">
            Serving DLF Cybercity, DivyaSree Orion, Phoenix Avance, Financial District SEZs, and Waverock IT Park.
          </p>
          <div style="font-size: 0.75rem; font-weight: 600; color: var(--color-primary-600); display: flex; align-items: center; gap: var(--space-2);">
            <span class="status-dot-pulse"></span> Driver Onboarding Center
          </div>
        </div>

        <div style="background: var(--color-surface); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
          <div style="font-weight: 700; font-size: 1.125rem; color: var(--color-text-primary); margin-bottom: var(--space-2);">Kokapet & Gandipet SEZs</div>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-4);">
            Dedicated multi-stop and nodal shift routes for Golden Mile corridor campuses and high-density tech parks.
          </p>
          <div style="font-size: 0.75rem; font-weight: 600; color: var(--color-primary-600); display: flex; align-items: center; gap: var(--space-2);">
            <span class="status-dot-pulse"></span> Shift Nodal Transit
          </div>
        </div>

        <div style="background: var(--color-surface); padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
          <div style="font-weight: 700; font-size: 1.125rem; color: var(--color-text-primary); margin-bottom: var(--space-2);">Uppal & Pocharam Hubs</div>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-4);">
            East corridor long-haul transit connecting peripheral campuses to central Hyderabad residential clusters.
          </p>
          <div style="font-size: 0.75rem; font-weight: 600; color: var(--color-primary-600); display: flex; align-items: center; gap: var(--space-2);">
            <span class="status-dot-pulse"></span> Long-Haul Nodal Fleet
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Strip -->
  <section style="padding: var(--space-16) 0; background: linear-gradient(135deg, var(--color-primary-900) 0%, #032969 100%); color: #ffffff; text-align: center;">
    <div class="container" style="max-width: 760px; margin: 0 auto;">
      <h2 style="font-size: 2.25rem; font-weight: 800; margin-bottom: var(--space-4); color: #ffffff;">
        Ready to Modernize Your Enterprise Fleet Program?
      </h2>
      <p style="font-size: 1.125rem; color: var(--color-primary-200); margin-bottom: var(--space-8); line-height: 1.6;">
        Join forward-thinking enterprise mobility leaders across Hyderabad. Book a confidential 30-minute programme review and receive custom corporate rate cards for your campus.
      </p>
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn btn-primary btn-large" style="background: var(--color-brand-x); border-color: var(--color-brand-x);">
          Book Enterprise Consultation &rarr;
        </a>
        <a href="/faq" class="btn btn-outline btn-large" style="color: #ffffff; border-color: rgba(255,255,255,0.4);">
          Read Enterprise FAQ
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
