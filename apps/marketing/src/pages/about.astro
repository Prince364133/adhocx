---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About AdhocX | Corporate Mobility Infrastructure & Employee Transport Hyderabad",
    "url": "https://www.adhocx.com/about",
    "description": "Discover AdhocX, the enterprise mobility platform by Estemporaneo Technologies Private Limited, delivering transparent employee transportation infrastructure across Hyderabad.",
    "mainEntity": {
      "@type": "Organization",
      "name": "Estemporaneo Technologies Private Limited",
      "alternateName": "AdhocX",
      "url": "https://www.adhocx.com",
      "logo": "https://www.adhocx.com/adhocx-logo.png",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Level 4, Cyber Gateway, HITEC City, Madhapur",
        "addressLocality": "Hyderabad",
        "addressRegion": "Telangana",
        "postalCode": "500081",
        "addressCountry": "IN"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-7893545818",
        "contactType": "customer service",
        "email": "support@adhocx.com",
        "areaServed": "IN"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "AdhocX Hyderabad Corporate Fleet Operations",
    "image": "https://www.adhocx.com/images/hero-corporate-commute.jpg",
    "url": "https://www.adhocx.com/about",
    "telephone": "+91-7893545818",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Level 4, Cyber Gateway, HITEC City, Madhapur",
      "addressLocality": "Hyderabad",
      "addressRegion": "Telangana",
      "postalCode": "500081",
      "addressCountry": "IN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 17.4474,
      "longitude": 78.3762
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "opens": "00:00",
      "closes": "23:59"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.adhocx.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "About Us",
        "item": "https://www.adhocx.com/about"
      }
    ]
  }
];
---

<BaseLayout
  title="About AdhocX | Corporate Mobility Infrastructure & Employee Transport Hyderabad"
  description="Discover AdhocX, the enterprise mobility platform by Estemporaneo Technologies Private Limited, delivering transparent employee transportation infrastructure across Hyderabad."
  canonical="https://www.adhocx.com/about"
  activeNav="company"
  jsonLd={jsonLd}
>
  <!-- =========================================================================
       SECTION 1: HERO SECTION
       "Building India's Most Transparent Corporate Mobility Infrastructure."
       ========================================================================= -->
  <section class="about-hero-section" id="hero">
    <div class="container about-hero-grid">
      <!-- Left Column: Copy & Actions -->
      <div class="about-hero-content">
        <!-- Eyebrow Badge -->
        <div class="about-hero-badge">
          <span class="badge-dot"></span>
          <span>Corporate Mobility Infrastructure &bull; Hyderabad Corridors</span>
        </div>

        <!-- H1 Title -->
        <h1 class="about-hero-h1">
          Building India's Most Transparent <span class="h1-accent">Corporate Mobility Infrastructure.</span>
        </h1>

        <!-- Subtitle Description -->
        <p class="about-hero-desc">
          Estemporaneo Technologies Private Limited (<span class="logo-text">Adhoc<span class="logo-accent">X</span></span>) is replacing fragmented cab vendor cartels and manual spreadsheets with an algorithmic, audit-grade enterprise transport operating system built specifically for high-growth tech corridors.
        </p>

        <!-- CTA Action Buttons -->
        <div class="about-hero-actions">
          <a href="/contact" class="btn-orange-primary" id="btn-hero-briefing">
            <span>Schedule Executive Briefing</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="/ets" class="btn-outline-pill" id="btn-hero-ets">
            Explore ETS Platform
          </a>
        </div>

        <!-- Trust Bullets -->
        <div class="about-hero-trust-bullets">
          <div class="about-trust-bullet-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>100% Commercial Yellow-Plate</span>
          </div>
          <div class="about-trust-bullet-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>PostGIS Spatial Routing</span>
          </div>
          <div class="about-trust-bullet-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Zero Surge Guarantee</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Professional Corporate Photography & HUD Overlay -->
      <div class="about-hero-visual">
        <div class="about-hero-img-frame">
          <img
            src="/images/hero-corporate-commute.jpg"
            alt="AdhocX Corporate Mobility Infrastructure & Fleet Operations in Hyderabad"
            class="about-hero-img"
            width="520"
            height="380"
            loading="eager"
          />

          <!-- HUD Telemetry Card Overlay -->
          <div class="about-hero-telemetry-card">
            <div class="telemetry-hud-info">
              <span class="telemetry-hud-sub">HITEC City Corridor Hub</span>
              <span class="telemetry-hud-title">Live Fleet Dispatch HUD</span>
            </div>
            <div class="telemetry-hud-badge">
              <span style="width: 6px; height: 6px; border-radius: 50%; background: #10B981; display: inline-block;"></span>
              Sub-15s Sync
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 2: COMPANY TRUST METRICS
       Four Key Corporate Mobility Metrics
       ========================================================================= -->
  <section class="about-metrics-section" aria-label="Company Trust Metrics">
    <div class="container">
      <div class="about-metrics-grid">
        <!-- Metric 1: 100% Yellow-Plate -->
        <div class="about-metric-card">
          <div class="about-metric-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <div class="about-metric-val">100%</div>
          <div class="about-metric-lbl">Yellow-Plate Commercial Cabs</div>
        </div>

        <!-- Metric 2: < 15 Sec GPS Freshness -->
        <div class="about-metric-card">
          <div class="about-metric-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="about-metric-val">&lt; 15 Sec</div>
          <div class="about-metric-lbl">GPS Telemetry Freshness</div>
        </div>

        <!-- Metric 3: 0% Vendor Intermediary Cut -->
        <div class="about-metric-card">
          <div class="about-metric-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="about-metric-val">0%</div>
          <div class="about-metric-lbl">Vendor Intermediary Cut</div>
        </div>

        <!-- Metric 4: 1 Hour Bank SLA Refund -->
        <div class="about-metric-card">
          <div class="about-metric-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <line x1="6" y1="8" x2="6" y2="8"></line>
              <line x1="10" y1="8" x2="18" y2="8"></line>
              <line x1="6" y1="12" x2="6" y2="12"></line>
              <line x1="10" y1="12" x2="18" y2="12"></line>
            </svg>
          </div>
          <div class="about-metric-val">1 Hour</div>
          <div class="about-metric-lbl">Bank SLA Dispute Refund</div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 3: STRUCTURAL INDUSTRY SHIFT
       Legacy Vendor Broker Model vs The AdhocX Standard
       ========================================================================= -->
  <section class="about-shift-section" id="industry-shift">
    <div class="container">
      <div class="about-section-header">
        <span class="about-section-eyebrow">Structural Industry Shift</span>
        <h2 class="about-section-h2">Why Legacy Corporate Transport Fails Enterprise Procurement</h2>
        <p class="about-section-desc">
          For decades, Indian corporate employee transportation has been held hostage by multi-layered vendor cartels, unverified subcontracting, and opaque trip billing. We re-engineered the entire operational model from first principles.
        </p>
      </div>

      <div class="about-shift-grid">
        <!-- Column 1: The Legacy Vendor Broker Model -->
        <div class="about-legacy-card">
          <div class="about-card-top-indicator">
            <div class="indicator-icon-legacy" aria-hidden="true">✕</div>
            <div>
              <div class="indicator-title">The Legacy Vendor Broker Model</div>
              <div class="indicator-sub">Fragmented Cartels & Manual Spreadsheets</div>
            </div>
          </div>

          <ul class="about-shift-list">
            <li class="about-shift-item">
              <span class="shift-bullet-neg">&bull;</span>
              <span><strong>Multi-tiered Subcontracting:</strong> Primary vendors sublet demand to secondary and tertiary middlemen, diluting accountability and inflating costs by 20&ndash;35%.</span>
            </li>
            <li class="about-shift-item">
              <span class="shift-bullet-neg">&bull;</span>
              <span><strong>Falsified Logsheets & Ghost Kilometers:</strong> Manual trip sheets and disconnected GPS devices result in inaccurate billing and unverified employee drops.</span>
            </li>
            <li class="about-shift-item">
              <span class="shift-bullet-neg">&bull;</span>
              <span><strong>Severe Driver Attrition:</strong> Middlemen delay driver payouts by 45&ndash;90 days, creating sudden no-shows and shift disruptions for campus operations.</span>
            </li>
            <li class="about-shift-item">
              <span class="shift-bullet-neg">&bull;</span>
              <span><strong>Compliance Blindspots:</strong> Private vehicles (white plates) and expired fitness certificates slip past manual campus security gate checks.</span>
            </li>
          </ul>
        </div>

        <!-- Column 2: The AdhocX Standard -->
        <div class="about-adhocx-card">
          <div class="adhocx-card-badge">The AdhocX Standard</div>

          <div class="about-card-top-indicator">
            <div class="indicator-icon-adhocx" aria-hidden="true">✓</div>
            <div>
              <div class="indicator-title"><span class="logo-text">Adhoc<span class="logo-accent">X</span></span> Direct Architecture</div>
              <div class="indicator-sub">Audited PostGIS Telemetry & Direct Settlements</div>
            </div>
          </div>

          <ul class="about-shift-list">
            <li class="about-shift-item">
              <span class="shift-bullet-pos">&bull;</span>
              <span><strong>Direct Corporate Contract:</strong> Enterprise clients contract directly with AdhocX. No vendor intermediaries, broker commissions, or sub-leasing cartels.</span>
            </li>
            <li class="about-shift-item">
              <span class="shift-bullet-pos">&bull;</span>
              <span><strong>Automated 3-Way Match Billing:</strong> Every billable kilometer is verified against approved roster requests, actual PostGIS GPS breadcrumbs, and contracted rate cards.</span>
            </li>
            <li class="about-shift-item">
              <span class="shift-bullet-pos">&bull;</span>
              <span><strong>Direct Bank Payouts to Drivers:</strong> Independent cab-owning drivers receive automated weekly bank transfers with zero platform deduction on corporate routes.</span>
            </li>
            <li class="about-shift-item">
              <span class="shift-bullet-pos">&bull;</span>
              <span><strong>100% Commercial RTA Verification:</strong> Every cab is independently verified for commercial yellow-board registration, active passenger insurance, and driver TR badges.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 4: CORPORATE GOVERNANCE
       Estemporaneo Technologies Private Limited & Registered Office
       ========================================================================= -->
  <section class="about-governance-section" id="governance">
    <div class="container about-governance-grid">
      <!-- Left Column: Company Bio, Registered Office & Actions -->
      <div>
        <span class="about-section-eyebrow">Corporate Governance</span>
        <h2 class="about-section-h2">Estemporaneo Technologies Private Limited</h2>
        
        <p style="color: #475569; font-size: 1rem; line-height: 1.65; margin-bottom: 1rem;">
          Operating under the brand name <span class="logo-text">Adhoc<span class="logo-accent">X</span></span>, Estemporaneo Technologies Private Limited is a registered Indian technology enterprise dedicated to mission-critical employee transport and corporate logistics.
        </p>
        
        <p style="color: #475569; font-size: 1rem; line-height: 1.65; margin-bottom: 1.5rem;">
          Our corporate headquarters and regional safety command center are located in the heart of Hyderabad's technology belt at HITEC City. Our engineering and operations teams combine deep spatial algorithms (PostGIS) with real-world fleet command to guarantee passenger safety and predictable transport economics.
        </p>

        <!-- Highlighted Registered Office Address Card -->
        <div class="about-registered-office-card">
          <div class="office-card-title">Registered Corporate Office</div>
          <div class="office-card-name">Estemporaneo Technologies Private Limited</div>
          <div class="office-card-address">
            Level 4, Cyber Gateway, HITEC City, Madhapur,<br />
            Hyderabad, Telangana &mdash; 500081, India.
          </div>
        </div>

        <!-- 2 Corporate Action Buttons -->
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href="/safety" class="btn-orange-primary" id="btn-gov-safety">
            <span>Review Safety Protocols</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="/pricing" class="btn-outline-pill" id="btn-gov-pricing">
            Commercial Rate Cards
          </a>
        </div>
      </div>

      <!-- Right Column: Technology Campus / Headquarters Photograph -->
      <div>
        <div class="about-governance-visual-frame">
          <img
            src="/images/service-shift-commute.jpg"
            alt="Estemporaneo Technologies Private Limited Corporate Office and Fleet Hub in Cyber Gateway HITEC City Hyderabad"
            class="about-governance-img"
            width="500"
            height="420"
            loading="lazy"
          />

          <!-- Command Hub Badge Overlay -->
          <div class="about-governance-hud-pill">
            <div style="display: flex; flex-direction: column;">
              <span style="font-size: 0.6875rem; text-transform: uppercase; color: #EE9811; font-weight: 700;">Regional Command Hub</span>
              <span style="font-size: 0.875rem; font-weight: 700;">Cyber Gateway, Madhapur, Hyderabad</span>
            </div>
            <span style="font-size: 0.75rem; color: #10B981; font-weight: 700; background: rgba(16, 185, 129, 0.2); padding: 0.25rem 0.5rem; border-radius: var(--radius-pill);">
              Active 24/7
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 5: TECHNOLOGY & GOVERNANCE PILLARS
       Duty of Care, PostGIS Routing, Zero Surge Billing, Full Audit Trails
       ========================================================================= -->
  <section class="about-pillars-section" id="pillars">
    <div class="container">
      <div class="about-section-header">
        <span class="about-section-eyebrow">Enterprise Technology</span>
        <h2 class="about-section-h2">Architected for Governance, Safety and Speed</h2>
        <p class="about-section-desc">
          Four purpose-built technology and operational pillars engineered to eliminate risk and give enterprise mobility leaders total command over their daily commute programs.
        </p>
      </div>

      <div class="about-pillars-grid">
        <!-- Pillar 1: Duty of Care -->
        <div class="about-pillar-card">
          <div class="about-pillar-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <h3 class="about-pillar-title">Duty of Care</h3>
          <p class="about-pillar-desc">
            Mandatory women employee night escort protocols between 8:00 PM and 6:00 AM, sub-15s SOS dispatch, and direct police integration.
          </p>
        </div>

        <!-- Pillar 2: PostGIS Routing -->
        <div class="about-pillar-card">
          <div class="about-pillar-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
              <line x1="8" y1="2" x2="8" y2="18"></line>
              <line x1="16" y1="6" x2="16" y2="22"></line>
            </svg>
          </div>
          <h3 class="about-pillar-title">PostGIS Routing</h3>
          <p class="about-pillar-desc">
            High-density employee clustering algorithm optimizing travel durations to under 60 minutes and cutting empty deadhead kilometers.
          </p>
        </div>

        <!-- Pillar 3: Zero Surge Billing -->
        <div class="about-pillar-card">
          <div class="about-pillar-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <line x1="6" y1="8" x2="6" y2="8"></line>
              <line x1="10" y1="8" x2="18" y2="8"></line>
              <line x1="6" y1="12" x2="6" y2="12"></line>
              <line x1="10" y1="12" x2="18" y2="12"></line>
            </svg>
          </div>
          <h3 class="about-pillar-title">Zero Surge Billing</h3>
          <p class="about-pillar-desc">
            Fixed commercial contract rate cards with transparent fuel indexation. No sudden surge pricing during rain or peak shifts.
          </p>
        </div>

        <!-- Pillar 4: Full Audit Trails -->
        <div class="about-pillar-card">
          <div class="about-pillar-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h3 class="about-pillar-title">Full Audit Trails</h3>
          <p class="about-pillar-desc">
            Immutable event logging with UTC timestamps, user identity, and PostGIS coordinates for external statutory and internal finance audits.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 6: REGIONAL OPERATIONAL FOOTPRINT
       Active Across Hyderabad's Premier Technology Corridors
       ========================================================================= -->
  <section class="about-corridors-section" id="corridors">
    <div class="container">
      <div class="about-section-header">
        <span class="about-section-eyebrow">Regional Operational Footprint</span>
        <h2 class="about-section-h2">Active Across Hyderabad's Premier Technology Corridors</h2>
        <p class="about-section-desc">
          Our commercial fleet network and dedicated dispatch centers provide round-the-clock employee transit across all major IT, BFSI, and SEZ campuses in Telangana.
        </p>
      </div>

      <div class="about-corridors-grid">
        <!-- Location 1: HITEC City & Madhapur -->
        <div class="about-corridor-card">
          <div>
            <h3 class="about-corridor-title">HITEC City & Madhapur</h3>
            <p class="about-corridor-desc">
              Covering Raheja Mindspace, Cyber Towers, Cyber Gateway, V-Ascendas, and Knowledge City tech zones.
            </p>
          </div>
          <div class="about-corridor-badge">
            <span class="dot-pulse"></span>
            <span>24/7 Primary Command Hub</span>
          </div>
        </div>

        <!-- Location 2: Gachibowli & Nanakramguda -->
        <div class="about-corridor-card">
          <div>
            <h3 class="about-corridor-title">Gachibowli & Nanakramguda</h3>
            <p class="about-corridor-desc">
              Serving DLF Cybercity, DivyaSree Orion, Phoenix Avance, Financial District SEZs, and Waverock IT Park.
            </p>
          </div>
          <div class="about-corridor-badge">
            <span class="dot-pulse"></span>
            <span>Driver Onboarding Center</span>
          </div>
        </div>

        <!-- Location 3: Kokapet & Gandipet SEZs -->
        <div class="about-corridor-card">
          <div>
            <h3 class="about-corridor-title">Kokapet & Gandipet SEZs</h3>
            <p class="about-corridor-desc">
              Dedicated multi-stop and nodal shift routes for Golden Mile corridor campuses and high-density tech parks.
            </p>
          </div>
          <div class="about-corridor-badge">
            <span class="dot-pulse"></span>
            <span>Shift Nodal Transit</span>
          </div>
        </div>

        <!-- Location 4: Uppal & Pocharam Hubs -->
        <div class="about-corridor-card">
          <div>
            <h3 class="about-corridor-title">Uppal & Pocharam Hubs</h3>
            <p class="about-corridor-desc">
              East corridor long-haul transit connecting peripheral campuses to central Hyderabad residential clusters.
            </p>
          </div>
          <div class="about-corridor-badge">
            <span class="dot-pulse"></span>
            <span>Long-Haul Nodal Fleet</span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 7: FINAL CONVERSION SECTION
       "Ready to Modernize Your Enterprise Fleet Program?"
       ========================================================================= -->
  <section class="about-conversion-section" id="conversion">
    <div class="container about-conversion-container">
      <h2 class="about-conversion-h2">
        Ready to Modernize Your Enterprise Fleet Program?
      </h2>
      <p class="about-conversion-desc">
        Join forward-thinking enterprise mobility leaders across Hyderabad. Book a confidential 30-minute programme review and receive custom corporate rate cards for your campus.
      </p>
      <div class="about-conversion-actions">
        <a href="/contact" class="btn-orange-primary btn-large" id="btn-cta-consultation">
          <span>Book Enterprise Consultation</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/faq" class="btn-outline-pill btn-large" style="background: rgba(255, 255, 255, 0.1); color: #FFFFFF; border-color: rgba(255, 255, 255, 0.3);" id="btn-cta-faq">
          Read Enterprise FAQ
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
