---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  // Category: HR & People Mobility
  {
    category: "hr",
    categoryLabel: "HR & People Mobility",
    question: "How does AdhocX ingest employee shift rosters from enterprise HRMS platforms?",
    answer: "AdhocX integrates directly via REST API adapters with enterprise HRMS systems including Darwinbox, Workday, SAP SuccessFactors, and Zoho People. Alternatively, HR teams can upload standard XLSX or CSV rosters into the Corporate Client Portal. Our ingestion engine runs automated dry-run validation to detect invalid geocodes, duplicate entries, and off-shift conflicts before publishing."
  },
  {
    category: "hr",
    categoryLabel: "HR & People Mobility",
    question: "What is the corporate shift cutoff window for roster modifications?",
    answer: "The shift cutoff window is fully configurable per corporate tenant (typically 2 to 3 hours prior to shift commencement). Employees can submit cancellation or pickup change requests via the Employee Mobile App within this window. Once the cutoff passes, changes require Transport Desk exception approval to protect route predictability."
  },
  {
    category: "hr",
    categoryLabel: "HR & People Mobility",
    question: "How does the platform ensure safety for women employees on night shifts?",
    answer: "Under Telangana state regulations, AdhocX enforces mandatory security escort guards for all female employees traveling between 8:00 PM and 6:00 AM. Our PostGIS routing engine enforces first-pickup and last-drop escort rules, ensuring a female employee is never left alone with the driver in the vehicle."
  },

  // Category: Transport Desk & Operations
  {
    category: "ops",
    categoryLabel: "Transport Operations & Admins",
    question: "How does the PostGIS routing engine optimize vehicle allocation?",
    answer: "Our spatial routing engine clusters employees based on residential proximity, shift timings, and corporate campus destinations. Routes are capped at a maximum of 60 minutes commute time, minimizing deadhead kilometers and maintaining an average seat occupancy above 85% on 4-seater sedans and 6/7-seater MUVs."
  },
  {
    category: "ops",
    categoryLabel: "Transport Operations & Admins",
    question: "How is employee boarding authenticated without physical paper trip sheets?",
    answer: "Boarding is verified digitally through dynamic, time-expiring OTPs or secure QR challenge codes presented by the employee and scanned/validated by the driver's mobile app. This creates an immutable, timestamped boarding event bound to the trip ID and GPS coordinates."
  },
  {
    category: "ops",
    categoryLabel: "Transport Operations & Admins",
    question: "What protocol activates when a cab experiences a mechanical breakdown or delay?",
    answer: "If a vehicle is stalled or deviates from its corridor for more than 5 minutes, our 24/7 HITEC City command center receives an automated telemetry alarm. The dispatch supervisor instantly reassigns the route to the nearest available standby driver, notifying passengers via SMS and in-app alerts with updated ETA."
  },

  // Category: Finance, CFO & Billing
  {
    category: "finance",
    categoryLabel: "Finance, CFO & Billing",
    question: "What is automated 3-way match billing and how does it prevent overcharging?",
    answer: "Every billable invoice line is automatically cross-referenced against three immutable data sources: (1) Approved corporate roster request, (2) Actual PostGIS GPS odometer telemetry, and (3) Contracted rate cards. Any unauthorized detours or unserved legs are flagged and stripped prior to invoice generation."
  },
  {
    category: "finance",
    categoryLabel: "Finance, CFO & Billing",
    question: "Does AdhocX charge surge pricing during peak hours, bad weather, or monsoon rains?",
    answer: "No. Enterprise contracts on AdhocX operate under fixed commercial rate cards with pre-agreed kilometer and shift package slabs. We strictly prohibit demand-based surge pricing. Fuel price fluctuations are governed transparently by formulaic indexation clauses agreed in the MSA."
  },
  {
    category: "finance",
    categoryLabel: "Finance, CFO & Billing",
    question: "How does the guaranteed 1-hour bank refund SLA work?",
    answer: "If a ride is marked unserved due to driver non-arrival or a verified SLA breach occurs, our finance system issues an immediate account credit or direct IMPS/NEFT bank refund within 60 minutes of ticket verification. We do not hold disputed corporate funds."
  },

  // Category: Drivers & Vehicle Owners
  {
    category: "drivers",
    categoryLabel: "Driver Partners & Fleets",
    question: "How do independent drivers register and qualify for corporate routes?",
    answer: "Drivers register directly via the AdhocX Driver App. Requirements include a commercial driving license with valid transport (TR) badge, clean police background verification, vehicle commercial Registration Certificate (yellow plate), active passenger fitness certificate, and commercial insurance. All documents undergo manual multi-point verification."
  },
  {
    category: "drivers",
    categoryLabel: "Driver Partners & Fleets",
    question: "What platform commission does AdhocX deduct from drivers on enterprise routes?",
    answer: "AdhocX operates a 0% commission model on dedicated enterprise corporate transport routes. Driver partners are paid fixed, contracted route earnings directly into their verified bank accounts via automated weekly payouts, eliminating vendor middlemen cuts."
  },

  // Category: Legal, Security & Compliance
  {
    category: "compliance",
    categoryLabel: "Legal, Security & Compliance",
    question: "Are private vehicles (white plates) ever deployed for corporate trips?",
    answer: "Strictly prohibited. Every vehicle active on the AdhocX network must hold valid commercial yellow-board registration and commercial taxi permits issued by the Regional Transport Authority (RTA). Private white-plate vehicles cannot be onboarded into our dispatch engine."
  },
  {
    category: "compliance",
    categoryLabel: "Legal, Security & Compliance",
    question: "How does AdhocX comply with the Digital Personal Data Protection (DPDP) Act?",
    answer: "All employee personal identifiable information (PII)—including phone numbers, home addresses, and shift schedules—is encrypted at rest (AES-256) and in transit (TLS 1.3). Driver apps only see optimized pickup sequence waypoints and use masked virtual proxy calling, preventing drivers from accessing employee personal phone numbers."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<BaseLayout
  title="Enterprise ETS & Corporate Mobility FAQ — AdhocX Hyderabad"
  description="Exhaustive answers to enterprise questions on AdhocX employee transport software, PostGIS routing, 3-way match billing, driver background checks, and night escort safety compliance."
  canonical="https://www.adhocx.com/faq"
  activeNav="resources"
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="faq-hero-section">
    <div class="faq-container">
      <div class="faq-hero-header">
        <span class="faq-hero-pill">Knowledge Base & FAQs</span>
        <h1 class="faq-hero-title">
          Frequently Asked Questions
        </h1>
        <p class="faq-hero-desc">
          Explore detailed technical, operational, and commercial answers regarding AdhocX enterprise employee transport, software integrations, and statutory compliance.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Filter Tabs & FAQ Accordion Section -->
  <section class="faq-main-section">
    <div class="faq-container">
      
      <!-- Persona Filter Buttons -->
      <div class="faq-filter-bar">
        <button type="button" class="faq-filter-btn active" data-filter="all">All Topics</button>
        <button type="button" class="faq-filter-btn" data-filter="hr">HR & Mobility</button>
        <button type="button" class="faq-filter-btn" data-filter="ops">Transport Ops</button>
        <button type="button" class="faq-filter-btn" data-filter="finance">Finance & Billing</button>
        <button type="button" class="faq-filter-btn" data-filter="drivers">Driver Partners</button>
        <button type="button" class="faq-filter-btn" data-filter="compliance">Compliance & Legal</button>
      </div>

      <!-- FAQ Accordion List -->
      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item" data-category={faq.category}>
            <summary class="faq-summary">
              <span class="faq-question">{faq.question}</span>
              <span class="faq-chevron-circle" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="faq-answer-body">
              <div class="faq-badge-wrapper">
                <span class="faq-category-badge">{faq.categoryLabel}</span>
              </div>
              <p class="faq-answer-text">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- Bottom Inquiries Help Card -->
      <div class="faq-cta-card">
        <h3 class="faq-cta-title">
          Have a Specific RFP or Technical Inquiry?
        </h3>
        <p class="faq-cta-desc">
          Our enterprise engineering and operations directors in HITEC City are available to review your shift matrices and compliance requirements.
        </p>
        <div class="faq-cta-actions">
          <a href="/contact" class="btn btn-primary">
            Contact Enterprise Desk &rarr;
          </a>
          <a href="/ets" class="btn btn-secondary">
            Explore ETS Software Architecture
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .faq-hero-section {
    background: linear-gradient(180deg, #FAF8FF 0%, #FFFFFF 100%);
    padding: clamp(2.5rem, 5vw, 3.75rem) 0 clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid #F1F5F9;
  }

  .faq-container {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    padding: 0 1.25rem;
    box-sizing: border-box;
  }

  .faq-hero-header {
    text-align: center;
  }

  .faq-hero-pill {
    display: inline-flex;
    align-items: center;
    background: #ECE6FE;
    color: #5728B2;
    padding: 5px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(87, 40, 178, 0.18);
  }

  .faq-hero-title {
    font-size: clamp(2rem, 3.5vw, 2.65rem);
    font-weight: 850;
    color: #0F172A;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 0.85rem 0;
  }

  .faq-hero-desc {
    color: #64748B;
    font-size: 1.025rem;
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto;
  }

  /* Main Section & Filters */
  .faq-main-section {
    padding: clamp(2rem, 4vw, 3.25rem) 0 clamp(3rem, 5vw, 4.5rem);
    background: #FAFAFC;
    min-height: 60vh;
  }

  .faq-filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .faq-filter-btn {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    color: #475569;
    padding: 0.5rem 1.15rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-filter-btn:hover {
    border-color: #A78BFA;
    color: #5728B2;
    background: #FAF5FF;
  }

  .faq-filter-btn.active {
    background: #5728B2;
    border-color: #5728B2;
    color: #FFFFFF;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(87, 40, 178, 0.25);
    transform: translateY(-1px);
  }

  /* Accordion List */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .faq-item {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 14px;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    overflow: hidden;
  }

  .faq-item:hover {
    border-color: #C4B5FD;
    box-shadow: 0 6px 16px -2px rgba(87, 40, 178, 0.08);
  }

  .faq-item[open] {
    border-color: #8B5CF6;
    box-shadow: 0 8px 24px -4px rgba(87, 40, 178, 0.12);
  }

  .faq-summary {
    font-weight: 700;
    font-size: 1rem;
    color: #0F172A;
    line-height: 1.45;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    list-style: none;
    user-select: none;
    transition: background 0.15s ease;
  }

  .faq-summary:hover {
    background: #FAF8FF;
  }

  .faq-question {
    flex: 1;
    text-align: left;
  }

  .faq-chevron-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #FAF5FF;
    border: 1px solid #EDE9FE;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5728B2;
    flex-shrink: 0;
    transition: transform 0.25s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .faq-item[open] .faq-chevron-circle {
    background: #5728B2;
    border-color: #5728B2;
    color: #FFFFFF;
    transform: rotate(180deg);
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  .faq-answer-body {
    padding: 0 1.35rem 1.25rem 1.35rem;
    border-top: 1px solid #F1F5F9;
    margin-top: 0;
    padding-top: 1rem;
  }

  .faq-badge-wrapper {
    margin-bottom: 0.65rem;
  }

  .faq-category-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #5728B2;
    background: #ECE6FE;
    padding: 3px 10px;
    border-radius: 6px;
    border: 1px solid rgba(87, 40, 178, 0.15);
  }

  .faq-answer-text {
    color: #334155;
    font-size: 0.9375rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Bottom CTA */
  .faq-cta-card {
    margin-top: 2.5rem;
    background: linear-gradient(135deg, #FAF5FF 0%, #FFFFFF 100%);
    border: 1.5px solid rgba(87, 40, 178, 0.18);
    border-radius: 20px;
    padding: clamp(1.75rem, 3.5vw, 2.25rem);
    text-align: center;
    box-shadow: 0 8px 24px -4px rgba(87, 40, 178, 0.08);
  }

  .faq-cta-title {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 850;
    color: #0F172A;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.015em;
  }

  .faq-cta-desc {
    font-size: 0.925rem;
    color: #64748B;
    max-width: 540px;
    margin: 0 auto 1.5rem auto;
    line-height: 1.6;
  }

  .faq-cta-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .faq-summary {
      padding: 1rem 1.1rem;
      font-size: 0.9375rem;
    }
    .faq-answer-body {
      padding: 0 1.1rem 1.1rem 1.1rem;
    }
    .faq-filter-btn {
      font-size: 0.8125rem;
      padding: 0.4rem 0.9rem;
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.faq-filter-btn');
  const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      faqItems.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (filter === 'all' || itemCat === filter) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
