---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnterpriseLeadForm from '../components/EnterpriseLeadForm';

const pageTitle = "Corporate Employee Transportation Services in Hyderabad | AdhocX";
const pageDescription = "Explore AdhocX corporate commute solutions in Hyderabad. Employee shift pickups, night safety, executive cabs and verified yellow-plate commercial fleets.";
const canonicalUrl = "https://www.adhocx.com/services";

const breadcrumbList = [
  { name: "Home", url: "https://www.adhocx.com/" },
  { name: "Services", url: canonicalUrl }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.adhocx.com/services#webpage",
    "url": canonicalUrl,
    "name": pageTitle,
    "description": pageDescription,
    "isPartOf": {
      "@type": "WebSite",
      "@id": "https://www.adhocx.com/#website",
      "name": "AdhocX",
      "url": "https://www.adhocx.com"
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.adhocx.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": canonicalUrl
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://www.adhocx.com/services#service",
    "name": "AdhocX Corporate Employee Transportation Services in Hyderabad",
    "serviceType": "Corporate Employee Commute Management",
    "provider": {
      "@type": "Organization",
      "@id": "https://www.adhocx.com/#organization",
      "name": "AdhocX (Estemporaneo Technologies Private Limited)",
      "url": "https://www.adhocx.com",
      "logo": "https://www.adhocx.com/adhocx-logo.png",
      "telephone": "+91-7893545818",
      "email": "support@adhocx.com"
    },
    "areaServed": [
      {
        "@type": "City",
        "name": "Hyderabad"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Telangana"
      },
      {
        "@type": "Place",
        "name": "HITEC City"
      },
      {
        "@type": "Place",
        "name": "Gachibowli"
      },
      {
        "@type": "Place",
        "name": "Financial District"
      },
      {
        "@type": "Place",
        "name": "Kondapur"
      },
      {
        "@type": "Place",
        "name": "Pocharam"
      }
    ],
    "description": pageDescription,
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Corporate Ground Transportation Portfolio",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Scheduled Shift Pickups & Drops",
            "description": "Automated fulfillment of approved corporate rosters for morning logins, evening logouts, and overnight shifts with clustered routing."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Women's Night Safety & Escort Governance",
            "description": "Telangana Transport and Cyberabad Security Council (SCSC) compliant night safety protocols, safe routing, and security guard escort integration."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Executive Travel & RGIA Airport Transfers",
            "description": "On-demand executive spot cabs and pre-booked airport transfers with flight tracking and premium commercial vehicles."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Verified Commercial Yellow-Plate Fleet",
            "description": "Strictly 100% yellow-board 4-seater sedans and 6/7-seater MUVs with calibrated speed governors and digitized document audits."
          }
        }
      ]
    }
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogType="website"
  ogImage="https://www.adhocx.com/images/hero-corporate-commute.jpg"
  ogImageAlt="AdhocX Verified Commercial Cab Fleet and Employee Transportation in Hyderabad"
  activeNav="services"
  breadcrumbs={breadcrumbList}
  jsonLd={jsonLd}
>
  <!-- =========================================================================
       1. HERO SECTION
       ========================================================================= -->
  <section class="services-hero" id="overview">
    <div class="container services-hero-container">
      <div class="services-hero-grid">
        <!-- Hero Content Column -->
        <div class="services-hero-content">
          <!-- Main H1 Headline -->
          <h1 class="services-hero-h1">
            Complete Employee Transportation. <span class="gradient-text">Automated from Roster to Ride.</span>
          </h1>

          <!-- Descriptive Lead Paragraph -->
          <p class="services-hero-desc">
            Replace fragmented WhatsApp groups, unvetted middleman brokers, and disputed paper duty slips. <strong>Adhoc<span style="color: var(--color-brand-x, #FF5F09);">X</span></strong> contracts directly with enterprises to deliver safe, predictable employee commutes across Hyderabad's premier technology corridors.
          </p>

          <!-- Primary CTAs -->
          <div class="services-hero-ctas">
            <a href="#request-proposal" class="btn btn-primary btn-large btn-cta-primary" id="btn-hero-quote">
              <span>Request Corporate Mobility Proposal</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a href="#core-services" class="btn btn-secondary btn-large btn-cta-secondary" id="btn-hero-explore">
              <span>Explore Service Modules</span>
              <span aria-hidden="true">&darr;</span>
            </a>
          </div>

          <!-- Micro Trust SLA Note -->
          <div class="hero-micro-trust">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            <span>Direct Enterprise Agreement &bull; Zero Broker Markups &bull; Same-Day Rate Card Turnaround</span>
          </div>
        </div>

        <!-- Hero Visual Column: Vehicle Photography + Transportation Tracking Dashboard HUD -->
        <div class="services-hero-visual">
          <div class="hero-image-card">
            <!-- Realistic Corporate Commercial Vehicle Photograph -->
            <div class="hero-image-wrapper">
              <img
                src="/images/hero-corporate-commute.jpg"
                alt="AdhocX White Commercial Sedan with Yellow Number Plate Stationed at HITEC City Hyderabad Tech Park"
                width="1200"
                height="670"
                class="hero-main-photo"
                loading="eager"
                decoding="async"
              />
              <div class="hero-image-gradient-overlay" aria-hidden="true"></div>
            </div>

            <!-- Transportation Tracking Dashboard HUD -->
            <div class="hero-tracking-hud" role="region" aria-label="Live Fleet Telemetry Dashboard HUD">
              <div class="hud-top-bar">
                <div class="hud-status-indicator">
                  <span class="hud-live-ping" aria-hidden="true"></span>
                  <span class="hud-status-text">COMMAND CENTER ACTIVE</span>
                </div>
                <span class="hud-corridor-tag">HITEC CITY &bull; GACHIBOWLI</span>
              </div>

              <div class="hud-details-grid">
                <div class="hud-stat-cell">
                  <span class="hud-stat-label">Active Vehicle Class</span>
                  <strong class="hud-stat-value">Commercial White Dzire</strong>
                  <span class="hud-stat-sub"><span class="badge-plate">TS 09 UB 4821</span> &bull; Yellow-Plate</span>
                </div>
                <div class="hud-stat-cell">
                  <span class="hud-stat-label">Shift Commuter Load</span>
                  <strong class="hud-stat-value">4 / 4 Commuters</strong>
                  <span class="hud-stat-sub text-success-sm">&check; OTP Boarding Verified</span>
                </div>
                <div class="hud-stat-cell">
                  <span class="hud-stat-label">PostGIS Geofence</span>
                  <strong class="hud-stat-value">Corridor Enforced</strong>
                  <span class="hud-stat-sub">0 Route Deviation</span>
                </div>
                <div class="hud-stat-cell">
                  <span class="hud-stat-label">3-Way Reconciliation</span>
                  <strong class="hud-stat-value">Automated Audit</strong>
                  <span class="hud-stat-sub text-purple-sm">Roster = GPS = GST Invoice</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       2. FOUR TRUST INDICATORS BAR
       ========================================================================= -->
  <section class="trust-indicators-bar" aria-label="AdhocX Core Commitments and Fleet Standards">
    <div class="container">
      <div class="trust-indicators-grid">
        <!-- Trust Indicator 1 -->
        <div class="trust-card">
          <div class="trust-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <div class="trust-content">
            <h2 class="trust-title">100% Commercial</h2>
            <p class="trust-desc">Yellow-Board Fleet Only (Dzire, Ertiga, Innova).</p>
          </div>
        </div>

        <!-- Trust Indicator 2 -->
        <div class="trust-card">
          <div class="trust-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div class="trust-content">
            <h2 class="trust-title">Direct Contract</h2>
            <p class="trust-desc">No Third-Party Broker Intermediaries.</p>
          </div>
        </div>

        <!-- Trust Indicator 3 -->
        <div class="trust-card">
          <div class="trust-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="6" x2="12" y2="12"></line>
              <line x1="12" y1="12" x2="16" y2="14"></line>
            </svg>
          </div>
          <div class="trust-content">
            <h2 class="trust-title">24/7 Command Center</h2>
            <p class="trust-desc">Live Telemetry, SOS & Rapid Dispatch Support.</p>
          </div>
        </div>

        <!-- Trust Indicator 4 -->
        <div class="trust-card">
          <div class="trust-icon-box" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="trust-content">
            <h2 class="trust-title">3-Way Audit</h2>
            <p class="trust-desc">Roster vs. GPS Geofence vs. GST Invoice.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. CORE MOBILITY SERVICES (Alternating Image & Text Layouts)
       ========================================================================= -->
  <section class="section-padding core-services-section" id="core-services">
    <div class="container">
      <!-- Section Header -->
      <div class="section-intro text-center">
        <h2 class="section-title">
          Engineered for Corporate Scale and Commuter Peace of Mind.
        </h2>
        <p class="section-subtitle">
          From high-volume daily shift pickups to executive travel, AdhocX provides unified corporate ground transport under one service agreement.
        </p>
      </div>

      <!-- Alternating Services Stack -->
      <div class="services-stack">
        <!-- SERVICE 01: SCHEDULED SHIFT PICKUPS & DROPS -->
        <article class="service-item-row" id="shift-commute">
          <div class="service-content-col">
            <div class="service-badge-row">
              <span class="badge badge-primary">SERVICE 01</span>
              <span class="badge-text-sub">ROSTER AUTOMATION</span>
            </div>
            <h3 class="service-h3">
              Scheduled Shift Pickups & Drops
            </h3>
            <p class="service-paragraph">
              Automated fulfillment of approved corporate rosters for morning logins, evening logouts, and overnight shifts. Clustered routing groups employees logically to minimize commute durations.
            </p>
            <div class="service-features-list">
              <div class="service-feature-item">
                <span class="feature-check" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="feature-text">Doorstep & nodal stop optimization with 5-minute dwell buffers.</span>
              </div>
              <div class="service-feature-item">
                <span class="feature-check" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="feature-text">Dynamic OTP/QR boarding verification prevents passenger mix-ups.</span>
              </div>
              <div class="service-feature-item">
                <span class="feature-check" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="feature-text">Corporate cutoff policy enforcement for orderly roster changes.</span>
              </div>
            </div>
            <div class="service-action-wrap">
              <a href="#request-proposal" class="btn btn-primary" id="btn-cta-shift">
                <span>Request Shift Commute Proposal</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <div class="service-visual-col">
            <div class="service-image-card">
              <img
                src="/images/service-shift-commute.jpg"
                alt="AdhocX Corporate employees boarding yellow-board commercial cab outside HITEC City campus"
                width="1200"
                height="670"
                class="service-img"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </article>

        <!-- SERVICE 02: WOMEN'S NIGHT SAFETY & ESCORT GOVERNANCE (Reversed Layout) -->
        <article class="service-item-row service-item-reversed" id="night-safety">
          <div class="service-content-col">
            <div class="service-badge-row">
              <span class="badge badge-primary">SERVICE 02</span>
              <span class="badge-alert-pill">SAFETY ASSURED</span>
            </div>
            <h3 class="service-h3">
              Women's Night Safety & Escort Governance
            </h3>
            <p class="service-paragraph">
              Comprehensive night safety protocols designed in strict compliance with Telangana Department of Transport and Cyberabad Security Council (SCSC) guidelines for corporate night shifts.
            </p>
            <div class="service-features-list">
              <div class="service-feature-item">
                <span class="feature-check" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="feature-text">First-pickup and last-drop female safety routing protocols.</span>
              </div>
              <div class="service-feature-item">
                <span class="feature-check" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="feature-text">Mandatory verified security guard escort integration where mandated.</span>
              </div>
              <div class="service-feature-item">
                <span class="feature-check" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="feature-text">In-app safe-reach confirmation and continuous GPS corridor tracking.</span>
              </div>
            </div>
            <div class="service-action-wrap">
              <a href="#request-proposal" class="btn btn-primary" id="btn-cta-safety">
                <span>Request Night Safety Plan</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <div class="service-visual-col">
            <div class="service-image-card">
              <img
                src="/images/service-night-safety.jpg"
                alt="AdhocX Reassuring night corporate transportation environment with safe commercial cabs"
                width="1200"
                height="800"
                class="service-img"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </article>

        <!-- SERVICE 03: EXECUTIVE TRAVEL & RGIA AIRPORT TRANSFERS -->
        <article class="service-item-row" id="executive-airport">
          <div class="service-content-col">
            <div class="service-badge-row">
              <span class="badge badge-primary">SERVICE 03</span>
              <span class="badge-text-sub">EXECUTIVE MOBILITY</span>
            </div>
            <h3 class="service-h3">
              Executive Travel & RGIA Airport Transfers
            </h3>
            <p class="service-paragraph">
              On-demand executive spot cabs and pre-booked airport transfers for senior management, visiting client delegations, and corporate board members across Hyderabad.
            </p>
            <div class="service-features-list">
              <div class="service-feature-item">
                <span class="feature-check" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="feature-text">Top-tier fleet: Innova Crysta, Hycross, Ertiga & executive sedans.</span>
              </div>
              <div class="service-feature-item">
                <span class="feature-check" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="feature-text">Flight tracking integration ensures drivers are stationed on time.</span>
              </div>
              <div class="service-feature-item">
                <span class="feature-check" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="feature-text">Masked virtual calling protects corporate executive contact privacy.</span>
              </div>
            </div>
            <div class="service-action-wrap">
              <a href="#request-proposal" class="btn btn-primary" id="btn-cta-exec">
                <span>Request Executive Fleet Proposal</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <div class="service-visual-col">
            <div class="service-image-card">
              <img
                src="/images/service-executive-airport.jpg"
                alt="AdhocX Premium Innova Crysta Commercial Executive Sedan at RGIA Hyderabad Airport Pickup Curb"
                width="1200"
                height="670"
                class="service-img"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. VERIFIED COMMERCIAL FLEET (Strictly Yellow-Plate)
       ========================================================================= -->
  <section class="section-padding fleet-section" id="fleet-categories">
    <div class="container">
      <!-- Section Header -->
      <div class="section-intro text-center">
        <h2 class="section-title">
          Strictly Commercial Yellow-Plate Vehicles.
        </h2>
        <p class="section-subtitle">
          AdhocX enforces a 100% yellow-plate commercial fleet mandate. We never dispatch private white-plate cars or uninspected vehicles.
        </p>
      </div>

      <!-- Fleet Overview Hero Banner -->
      <div class="fleet-overview-card">
        <div class="fleet-overview-img-wrap">
          <img
            src="/corporate-cab-fleet.jpg"
            alt="AdhocX Verified Commercial 4-Seater and 7-Seater Cab Fleet in Hyderabad"
            width="1376"
            height="768"
            class="fleet-overview-img"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="fleet-overview-copy">
          <div class="fleet-badge-row">
            <span class="badge-plate-large">100% COMMERCIAL MANDATE</span>
            <span class="fleet-reg-note">RTO Commercial Permits Only</span>
          </div>
          <h3 class="fleet-overview-title">Enterprise Commercial Cab Fleet in Hyderabad</h3>
          <p class="fleet-overview-desc">
            Serving HITEC City, Gachibowli, Financial District, Kondapur, and Pocharam. Every car operates under valid commercial contracts with digital compliance records maintained in the AdhocX enterprise repository.
          </p>
          <div class="fleet-quick-metrics">
            <div class="quick-metric-item">
              <strong>80 km/h</strong>
              <span>Calibrated Speed Governor</span>
            </div>
            <div class="quick-metric-item">
              <strong>AIS-140</strong>
              <span>Live GPS Telemetry</span>
            </div>
            <div class="quick-metric-item">
              <strong>100% Digital</strong>
              <span>Pre-Dispatch Compliance Audit</span>
            </div>
          </div>
        </div>
      </div>

      <!-- FLEET CATEGORY 1: 4-SEATER COMMERCIAL SEDANS -->
      <div class="fleet-category-block" id="sedan-fleet">
        <div class="fleet-cat-header">
          <div>
            <div class="cat-pill">FLEET CLASS 01</div>
            <h3 class="fleet-cat-h3">4-Seater Commercial Sedans</h3>
            <p class="fleet-cat-desc">
              Maruti Suzuki Dzire, Toyota Etios, Tata Tigor EV. Clean interiors, AC, calibrated speed governors, and GPS tracking.
            </p>
          </div>
          <span class="badge badge-primary">Daily Commute & Point-to-Point</span>
        </div>

        <div class="vehicle-cards-grid">
          <!-- Maruti Suzuki Dzire -->
          <div class="vehicle-card">
            <div class="vehicle-img-wrap">
              <img
                src="/images/fleet/fleet-dzire.jpg"
                alt="Maruti Suzuki Dzire Commercial Fleet Sedan in Hyderabad"
                width="800"
                height="520"
                class="vehicle-img"
                loading="lazy"
                decoding="async"
              />
              <span class="vehicle-tag">Maruti Suzuki</span>
            </div>
            <div class="vehicle-card-body">
              <h4 class="vehicle-name">Maruti Suzuki Dzire</h4>
              <div class="vehicle-specs">
                <span class="spec-chip">4 Commuters + 1 Driver</span>
                <span class="spec-chip">Commercial Yellow Plate</span>
                <span class="spec-chip">Speed Governor 80 km/h</span>
                <span class="spec-chip">High Mileage Efficiency</span>
              </div>
              <p class="vehicle-note">Hyderabad's benchmark corporate commute sedan. Dual airbags, calibrated AC, and spacious boot space for office shifts.</p>
            </div>
          </div>

          <!-- Toyota Etios -->
          <div class="vehicle-card">
            <div class="vehicle-img-wrap">
              <img
                src="/images/fleet/fleet-etios.jpg"
                alt="Toyota Etios Commercial Sedan for Corporate Ground Mobility"
                width="800"
                height="520"
                class="vehicle-img"
                loading="lazy"
                decoding="async"
              />
              <span class="vehicle-tag">Toyota</span>
            </div>
            <div class="vehicle-card-body">
              <h4 class="vehicle-name">Toyota Etios</h4>
