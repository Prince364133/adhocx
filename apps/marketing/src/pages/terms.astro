---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms of Service — AdhocX Technologies",
  "url": "https://www.adhocx.com/terms",
  "description": "Terms of Service and Partner Agreement for AdhocX Technologies Private Limited commercial transport marketplace."
};
---

<BaseLayout
  title="Terms & Conditions — AdhocX Technologies Private Limited"
  description="Read the official Terms of Service and Master Services Agreement for corporate clients and commercial driver partners using the AdhocX platform."
  canonical="https://www.adhocx.com/terms"
  activeNav=""
  jsonLd={jsonLd}
>
  <section class="section-padding" style="background: var(--color-surface-muted);">
    <div class="container" style="max-width: 800px;">
      <div style="margin-bottom: var(--space-6);">
        <span class="badge badge-info">Terms & Agreements</span>
        <h1 class="h2-title" style="margin-top: var(--space-2); margin-bottom: var(--space-2);">Terms & Conditions</h1>
        <p class="text-caption">Effective Date: January 1, 2026 | Last Updated: September 1, 2026</p>
      </div>

      <div class="card" style="padding: var(--space-8); line-height: 1.7; color: var(--color-text);">
        <h2 class="h4-title" style="margin-bottom: 8px; color: var(--color-primary-600);">1. Platform Agreement</h2>
        <p class="body-text" style="margin-bottom: var(--space-6);">
          These Terms and Conditions ("Agreement") govern the access and use of the technology platform, dispatch engines, and marketplace services provided by AdhocX Technologies Private Limited ("AdhocX") by corporate clients ("Vendors" or "Enterprise Bookers") and independent commercial drivers or fleet operators ("Driver Partners").
        </p>

        <h2 class="h4-title" style="margin-bottom: 8px; color: var(--color-primary-600);">2. Commercial Fleet & Driver Requirements</h2>
        <p class="body-text" style="margin-bottom: var(--space-4);">
          All Driver Partners on the AdhocX network explicitly agree to and warrant the following:
        </p>
        <ul style="margin-bottom: var(--space-6); padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 0.95rem;">
          <li>All vehicles operated must be registered with commercial yellow boards (commercial transport category).</li>
          <li>Drivers must possess a valid Commercial Driving License with required state transport authority badges.</li>
          <li>Vehicles must maintain up-to-date third-party and passenger commercial insurance, fitness certificates, and pollution control compliance.</li>
          <li>Driver Partners agree to adhere to corporate safety standards, passenger dignity policies, and speed limit adherence.</li>
        </ul>

        <h2 class="h4-title" style="margin-bottom: 8px; color: var(--color-primary-600);">3. 15-Minute Search Cutoff & 1-Hour Bank Refund SLA</h2>
        <p class="body-text" style="margin-bottom: var(--space-6);">
          When an Enterprise Booker initiates a ride or shift requirement on the AdhocX platform, our automated dispatch algorithm searches for the optimal verified fleet partner. If a ride cannot be confirmed within fifteen (15) minutes, the booking is automatically marked unfulfilled, and any prepaid booking fees or security holds are triggered for return directly to the corporate bank account within one (1) hour via instant banking rails.
        </p>

        <h2 class="h4-title" style="margin-bottom: 8px; color: var(--color-primary-600);">4. ₹2,000 Century Milestone Bonus Terms</h2>
        <p class="body-text" style="margin-bottom: var(--space-6);">
          Newly verified Driver Partners are eligible for the "Century Milestone" promotional bonus. Upon completing one hundred (100) verified, non-fraudulent trips within thirty (30) calendar days from account activation, a bonus of ₹2,000 (Two Thousand Indian Rupees) will be deposited into the driver's verified bank account in the subsequent payout cycle. AdhocX reserves the right to audit trips against GPS logs to prevent fraudulent trip completions.
        </p>

        <h2 class="h4-title" style="margin-bottom: 8px; color: var(--color-primary-600);">5. Governing Law & Dispute Resolution</h2>
        <p class="body-text">
          This Agreement shall be governed by and construed in accordance with the laws of the Republic of India. Any disputes arising out of or in connection with this platform shall be subject to the exclusive jurisdiction of the competent courts in Hyderabad, Telangana, India.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
