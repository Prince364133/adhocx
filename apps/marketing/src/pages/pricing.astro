---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnterpriseLeadForm from '../components/EnterpriseLeadForm';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AdhocX Enterprise Corporate Transport Commercial Proposals",
  "description": "Transparent, auditable corporate mobility commercial frameworks for Hyderabad enterprises. Custom shift packages, per-km commercial rate cards for 4-seater and 7-seater fleets, zero surge, and automated 3-way match reconciliation.",
  "provider": {
    "@type": "Organization",
    "name": "AdhocX (Estemporaneo Technologies Private Limited)",
    "url": "https://www.adhocx.com"
  },
  "areaServed": ["Telangana", "Hyderabad"]
};
---

<BaseLayout
  title="Corporate Commercial Framework & Custom Proposals — AdhocX Hyderabad"
  description="Transparent, auditable corporate mobility commercial frameworks for Hyderabad enterprises. Custom shift packages, verified 4-seater and 7-seater fleets, zero surge, and automated 3-way match reconciliation."
  canonical="https://www.adhocx.com/pricing"
  activeNav="pricing"
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="page-hero-section" style="background: linear-gradient(180deg, var(--color-primary-50) 0%, #ffffff 100%); padding: var(--space-16) 0 var(--space-12);">
    <div class="container text-center" style="max-width: 860px; margin: 0 auto;">
      <div class="badge badge-blue" style="margin-bottom: var(--space-4);">
        <span class="status-dot-pulse"></span>
        <span>Transparent Commercial Governance &bull; Tailored Enterprise Quotations</span>
      </div>
      <h1 class="display-title" style="color: var(--color-text-primary); margin-bottom: var(--space-6);">
        Predictable Enterprise Mobility Economics. Zero Hidden Surcharges.
      </h1>
      <p class="body-large" style="color: var(--color-text-secondary); margin-bottom: var(--space-8); line-height: 1.6;">
        Eliminate unvetted vendor markups and opaque manual billing. <span class="logo-text" style="font-size: 1.15em;">Adhoc<span class="logo-accent">X</span></span> provides direct corporate contract pricing across commercial 4-seater sedans, 6/7-seater MUVs, and executive vehicles with automated 3-way match reconciliation.
      </p>
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="#request-quote" class="btn btn-primary btn-large">
          Request Custom Corporate Rate Card &rarr;
        </a>
        <a href="#commercial-models" class="btn btn-secondary btn-large">
          Explore Commercial Models
        </a>
      </div>
    </div>
  </section>

  <!-- 4 Commercial Value Guarantees -->
  <section style="background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: var(--space-8) 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-6); text-align: center;">
        <div>
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--color-primary-600);">Zero Surge</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: 4px;">Predictable Rates in Weather & Peak Hours</div>
        </div>
        <div>
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--color-primary-600);">1-Hour SLA Credit</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: 4px;">Direct Commercial Guarantee on Unserved Demand</div>
        </div>
        <div>
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--color-primary-600);">3-Way Match</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: 4px;">Roster vs. GPS Geofence vs. GST Invoice</div>
        </div>
        <div>
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--color-primary-600);">100% Direct</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: 4px;">No Middleman Broker or Aggregator Deductions</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Commercial Models Breakdown -->
  <section id="commercial-models" style="padding: var(--space-16) 0; background: var(--color-surface-muted);">
    <div class="container">
      <div class="text-center" style="max-width: 800px; margin: 0 auto var(--space-12);">
        <span class="badge badge-warm" style="margin-bottom: var(--space-3);">Tailored B2B Contracts</span>
        <h2 style="font-size: 2rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-4);">
          Flexible Commercial Frameworks for Every Operation
        </h2>
        <p style="color: var(--color-text-secondary); font-size: 1rem; line-height: 1.6;">
          Whether your enterprise operates 24/7 rotating shifts or daytime executive transit, our transparent rate structures are calibrated to your corporate corridors and headcount.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-8);">
        
        <!-- Model 1: 4-Seater Commercial Sedans -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div class="badge badge-blue" style="margin-bottom: var(--space-3);">4-Seater Commercial Sedans</div>
            <h3 style="font-size: 1.4rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
              Daily Point-to-Point Shift Commutes
            </h3>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-6);">
              Optimized for employee doorstep and nodal shift transitions across Hyderabad tech corridors (Dzire, Etios, Tigor EV).
            </p>

            <div style="display: flex; flex-direction: column; gap: var(--space-3); border-top: 1px solid var(--color-border); padding-top: var(--space-4); margin-bottom: var(--space-6);">
              <div style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.9rem; color: var(--color-text-secondary);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Dedicated shift duration packages customized to your office hours</span>
              </div>
              <div style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.9rem; color: var(--color-text-secondary);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Automated multi-stop routing with geofenced pickup arrival timestamps</span>
              </div>
              <div style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.9rem; color: var(--color-text-secondary);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Clean yellow-board commercial vehicles with valid RTO passenger permits</span>
              </div>
            </div>
          </div>

          <a href="#request-quote" class="btn btn-outline" style="width: 100%; text-align: center; justify-content: center;">
            Request Sedan Proposal &rarr;
          </a>
        </div>

        <!-- Model 2: 6/7-Seater MUVs -->
        <div style="background: var(--color-surface); border: 2px solid var(--color-primary-600); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-lg); position: relative; display: flex; flex-direction: column; justify-content: space-between;">
          <div style="position: absolute; top: -14px; right: 24px; background: var(--color-primary-600); color: #ffffff; font-size: 0.75rem; font-weight: 700; padding: 4px 12px; border-radius: var(--radius-full); text-transform: uppercase; letter-spacing: 0.05em;">
            High-Efficiency ETS
          </div>
          <div>
            <div class="badge badge-warm" style="margin-bottom: var(--space-3);">6 & 7-Seater Commercial MUVs</div>
            <h3 style="font-size: 1.4rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
              Grouped Shift Transit & Nodal Corridors
            </h3>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-6);">
              High-density workforce transit maximizing seat occupancy and reducing overall corporate mobility expenditure (Ertiga, XL6, Carens).
            </p>

            <div style="display: flex; flex-direction: column; gap: var(--space-3); border-top: 1px solid var(--color-border); padding-top: var(--space-4); margin-bottom: var(--space-6);">
              <div style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.9rem; color: var(--color-text-secondary);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Clustered employee routing minimizing route detour times</span>
              </div>
              <div style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.9rem; color: var(--color-text-secondary);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Automated female safe-drop sequencing for late-night & early-morning shifts</span>
              </div>
              <div style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.9rem; color: var(--color-text-secondary);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Dynamic OTP/QR boarding verification at every scheduled employee stop</span>
              </div>
            </div>
          </div>

          <a href="#request-quote" class="btn btn-primary" style="width: 100%; text-align: center; justify-content: center;">
            Request MUV Proposal &rarr;
          </a>
        </div>

        <!-- Model 3: Executive MPVs & Airport Spot Cabs -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div class="badge badge-blue" style="margin-bottom: var(--space-3);">Executive Mobility & RGIA Transfers</div>
            <h3 style="font-size: 1.4rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
              Leadership & Client Delegation Transport
            </h3>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-6);">
              Dedicated premium vehicles for senior leadership, business guests, and RGIA airport transfers (Innova Crysta, Hycross, VIP Fleets).
            </p>

            <div style="display: flex; flex-direction: column; gap: var(--space-3); border-top: 1px solid var(--color-border); padding-top: var(--space-4); margin-bottom: var(--space-6);">
              <div style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.9rem; color: var(--color-text-secondary);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Priority vehicle assignment with top-rated commercial chauffeurs</span>
              </div>
              <div style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.9rem; color: var(--color-text-secondary);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Fixed corporate point-to-point airport agreements with flight delay tracking</span>
              </div>
              <div style="display: flex; align-items: flex-start; gap: 8px; font-size: 0.9rem; color: var(--color-text-secondary);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Executive vehicle sanitization standards and climate-controlled interiors</span>
              </div>
            </div>
          </div>

          <a href="#request-quote" class="btn btn-outline" style="width: 100%; text-align: center; justify-content: center;">
            Request Executive Proposal &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Financial Audit & Transparency Engine -->
  <section class="section-padding" style="background: var(--color-surface);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-12); align-items: center;">
        <div>
          <span class="badge badge-primary" style="margin-bottom: var(--space-3);">Audit-Grade Financial Controls</span>
          <h2 style="font-size: 2rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-4);">
            How AdhocX Eliminates Corporate Transport Billing Leakage
          </h2>
          <p class="body-large" style="margin-bottom: var(--space-6);">
            Traditional vendor desks rely on physical log sheets, manual odometer readings, and disputed fuel slips. AdhocX digitizes and verifies every billing milestone automatically.
          </p>

          <div style="display: flex; flex-direction: column; gap: var(--space-4);">
            <div style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <div style="width: 2rem; height: 2rem; border-radius: 50%; background: #EFF6FF; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">1</div>
              <div>
                <strong style="color: var(--color-text-primary);">GPS & Geofence Verification:</strong>
                <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin-top: 2px;">Trips are audited against real vehicle movement timestamps. Deadhead mileage is eliminated from corporate invoicing.</p>
              </div>
            </div>

            <div style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <div style="width: 2rem; height: 2rem; border-radius: 50%; background: #EFF6FF; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">2</div>
              <div>
                <strong style="color: var(--color-text-primary);">Contract Rate Card Lock:</strong>
                <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin-top: 2px;">Your agreed master service agreement terms are permanently locked into the system, preventing unexpected fee spikes.</p>
              </div>
            </div>

            <div style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <div style="width: 2rem; height: 2rem; border-radius: 50%; background: #EFF6FF; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">3</div>
              <div>
                <strong style="color: var(--color-text-primary);">Consolidated Monthly GST Invoicing:</strong>
                <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin-top: 2px;">Single itemized monthly GST invoice with internal cost center breakdowns for seamless ERP integration.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side: Embedded Request Form Island -->
        <div id="request-quote">
          <EnterpriseLeadForm client:load defaultPurpose="Custom Corporate Quotation & Rate Card" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
