---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "AdhocX Enterprise Corporate Transport Commercial Rate Cards",
  "description": "Transparent, auditable corporate mobility rate cards for Hyderabad enterprises. Fixed shift packages, per-km rates for 4-seater and 7-seater cabs, zero surge, and 1-hour refund guarantee.",
  "brand": {
    "@type": "Brand",
    "name": "AdhocX"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "INR",
    "lowPrice": "1200",
    "highPrice": "4500",
    "offerCount": "6"
  }
};
---

<BaseLayout
  title="Corporate Transport Pricing & Commercial Rate Cards — AdhocX Hyderabad"
  description="Transparent, auditable corporate mobility rate cards for Hyderabad enterprises. Fixed shift packages, per-km rates for Dzire, Ertiga, and Innova, zero surge, and 1-hour refund guarantee."
  canonical="https://www.adhocx.com/pricing"
  activeNav="pricing"
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="page-hero-section" style="background: linear-gradient(180deg, var(--color-primary-50) 0%, #ffffff 100%); padding: var(--space-16) 0 var(--space-12);">
    <div class="container text-center" style="max-width: 860px; margin: 0 auto;">
      <div class="badge badge-blue" style="margin-bottom: var(--space-4);">
        <span class="status-dot-pulse"></span>
        <span>Transparent Commercial Pricing &bull; Auditable B2B Rate Cards</span>
      </div>
      <h1 class="display-title" style="color: var(--color-text-primary); margin-bottom: var(--space-6);">
        Predictable Enterprise Transport Economics. Zero Hidden Surcharges.
      </h1>
      <p class="body-large" style="color: var(--color-text-secondary); margin-bottom: var(--space-8); line-height: 1.6;">
        Eliminate vendor middlemen markups. <span class="logo-text" style="font-size: 1.15em;">Adhoc<span class="logo-accent">X</span></span> provides direct corporate contract pricing across 4-seater sedans, 6/7-seater MUVs, and executive MPVs with guaranteed 3-way match reconciliation.
      </p>
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn btn-primary btn-large">
          Request Custom Corporate Rate Card &rarr;
        </a>
        <a href="#commercial-cards" class="btn btn-secondary btn-large">
          View Fleet Rate Slabs
        </a>
      </div>
    </div>
  </section>

  <!-- 4 Commercial Value Guarantees -->
  <section style="background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: var(--space-8) 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-6); text-align: center;">
        <div>
          <div style="font-size: 2rem; font-weight: 800; color: var(--color-primary-600);">Zero Surge</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: 4px;">Fixed Rates in Rains & Peaks</div>
        </div>
        <div>
          <div style="font-size: 2rem; font-weight: 800; color: var(--color-primary-600);">1-Hour Refund</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: 4px;">Direct Bank SLA Guarantee</div>
        </div>
        <div>
          <div style="font-size: 2rem; font-weight: 800; color: var(--color-primary-600);">3-Way Match</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: 4px;">Roster vs GPS vs Invoice</div>
        </div>
        <div>
          <div style="font-size: 2rem; font-weight: 800; color: var(--color-primary-600);">100% Direct</div>
          <div style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-secondary); margin-top: 4px;">No Vendor Broker Commission</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rate Cards Grid -->
  <section id="commercial-cards" style="padding: var(--space-16) 0; background: var(--color-surface-muted);">
    <div class="container">
      <div class="text-center" style="max-width: 800px; margin: 0 auto var(--space-12);">
        <span class="badge badge-warm" style="margin-bottom: var(--space-3);">Standard Hyderabad Commercial Fleet Slabs</span>
        <h2 style="font-size: 2rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-4);">
          Commercial Rate Cards by Vehicle Tier
        </h2>
        <p style="color: var(--color-text-secondary); font-size: 1rem; line-height: 1.6;">
          All rates are 100% yellow-plate compliant, including commercial passenger insurance, RTA fitness, and verified driver partners.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-8);">
        
        <!-- Card 1: 4-Seater Sedans -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div class="badge badge-blue" style="margin-bottom: var(--space-3);">4-Seater Commercial Sedan</div>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
              Maruti Dzire / Etios / Tigor EV
            </h3>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-6);">
              Ideal for daily point-to-point shift pickups, employee drops, and executive campus commute.
            </p>

            <div style="display: flex; flex-direction: column; gap: var(--space-3); border-top: 1px solid var(--color-border); padding-top: var(--space-4); margin-bottom: var(--space-6);">
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">4 Hrs / 40 Km Package:</span>
                <strong style="color: var(--color-text-primary);">&#8377;1,250 &ndash; &#8377;1,450</strong>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">8 Hrs / 80 Km Package:</span>
                <strong style="color: var(--color-text-primary);">&#8377;2,200 &ndash; &#8377;2,500</strong>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">Extra Km Rate:</span>
                <strong style="color: var(--color-text-primary);">&#8377;14.00 &ndash; &#8377;15.50 / km</strong>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">Extra Hour Rate:</span>
                <strong style="color: var(--color-text-primary);">&#8377;120 / hr</strong>
              </div>
            </div>
          </div>

          <a href="/contact" class="btn btn-outline" style="width: 100%; text-align: center; justify-content: center;">
            Request Sedan Rate Card
          </a>
        </div>

        <!-- Card 2: 6/7-Seater MUVs -->
        <div style="background: var(--color-surface); border: 2px solid var(--color-primary-600); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-lg); position: relative; display: flex; flex-direction: column; justify-content: space-between;">
          <div style="position: absolute; top: -14px; right: 24px; background: var(--color-primary-600); color: #ffffff; font-size: 0.75rem; font-weight: 700; padding: 4px 12px; border-radius: var(--radius-full); text-transform: uppercase; letter-spacing: 0.05em;">
            Most Popular for ETS
          </div>
          <div>
            <div class="badge badge-warm" style="margin-bottom: var(--space-3);">6/7-Seater Commercial MUV</div>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
              Maruti Ertiga / Carens / Innova
            </h3>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-6);">
              High-density shift nodal transit and grouped employee routes across HITEC City and Gachibowli.
            </p>

            <div style="display: flex; flex-direction: column; gap: var(--space-3); border-top: 1px solid var(--color-border); padding-top: var(--space-4); margin-bottom: var(--space-6);">
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">4 Hrs / 40 Km Package:</span>
                <strong style="color: var(--color-text-primary);">&#8377;1,750 &ndash; &#8377;1,950</strong>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">8 Hrs / 80 Km Package:</span>
                <strong style="color: var(--color-text-primary);">&#8377;2,900 &ndash; &#8377;3,300</strong>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">Extra Km Rate:</span>
                <strong style="color: var(--color-text-primary);">&#8377;18.00 &ndash; &#8377;20.00 / km</strong>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">Extra Hour Rate:</span>
                <strong style="color: var(--color-text-primary);">&#8377;150 / hr</strong>
              </div>
            </div>
          </div>

          <a href="/contact" class="btn btn-primary" style="width: 100%; text-align: center; justify-content: center;">
            Request MUV Rate Card
          </a>
        </div>

        <!-- Card 3: Executive MPVs & Airport Transfers -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div class="badge badge-blue" style="margin-bottom: var(--space-3);">Executive MPV & Spot Cabs</div>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
              Innova Crysta / Hycross / VIP EV
            </h3>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: var(--space-6);">
              Dedicated leadership mobility, client delegations, and RGIA airport transfers.
            </p>

            <div style="display: flex; flex-direction: column; gap: var(--space-3); border-top: 1px solid var(--color-border); padding-top: var(--space-4); margin-bottom: var(--space-6);">
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">RGIA Airport Transfer Slab:</span>
                <strong style="color: var(--color-text-primary);">&#8377;1,850 &ndash; &#8377;2,400</strong>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">8 Hrs / 80 Km Package:</span>
                <strong style="color: var(--color-text-primary);">&#8377;3,800 &ndash; &#8377;4,500</strong>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">Extra Km Rate:</span>
                <strong style="color: var(--color-text-primary);">&#8377;24.00 &ndash; &#8377;28.00 / km</strong>
              </div>
              <div style="display: flex; justify-content: space-between; font-size: 0.9375rem;">
                <span style="color: var(--color-text-secondary);">Extra Hour Rate:</span>
                <strong style="color: var(--color-text-primary);">&#8377;250 / hr</strong>
              </div>
            </div>
          </div>

          <a href="/contact" class="btn btn-outline" style="width: 100%; text-align: center; justify-content: center;">
            Request Executive Card
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Reconciliation & 1-Hour SLA Section -->
  <section id="reconciliation" style="padding: var(--space-16) 0; background: var(--color-surface);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-12); align-items: center;">
        <div>
          <span class="badge badge-blue" style="margin-bottom: var(--space-3);">Finance & CFO Governance</span>
          <h2 style="font-size: 2rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-4);">
            How 3-Way Match Billing Protects Your Corporate Budget
          </h2>
          <p style="color: var(--color-text-secondary); font-size: 1rem; line-height: 1.6; margin-bottom: var(--space-4);">
            Traditional vendor billing forces finance teams to audit thousands of manual paper slips at the end of each month. AdhocX replaces this chaos with automated, real-time programmatic verification.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-4); font-size: 0.9375rem; color: var(--color-text-secondary);">
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--color-primary-50); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600); flex-shrink: 0; margin-top: 2px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <strong style="color: var(--color-text-primary);">Roster Demand Match:</strong> Every billed leg must trace back to an authorized employee shift record published by HR.
              </div>
            </li>
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--color-primary-50); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600); flex-shrink: 0; margin-top: 2px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <strong style="color: var(--color-text-primary);">PostGIS Telemetry Validation:</strong> Actual distance is computed from geofenced pickup and drop events, stripping phantom detours.
              </div>
            </li>
            <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--color-primary-50); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600); flex-shrink: 0; margin-top: 2px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <strong style="color: var(--color-text-primary);">Contract Rate Card Lock:</strong> System applies your agreed MSA rate cards automatically. No ad-hoc markup by dispatchers.
              </div>
            </li>
          </ul>
        </div>

        <div style="background: var(--color-surface-muted); border: 2px solid var(--color-primary-600); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-md);">
          <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4);">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--color-primary-50); display: flex; align-items: center; justify-content: center; color: var(--color-primary-600);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin: 0;">1-Hour Bank Refund SLA</h3>
          </div>
          <p style="font-size: 0.9375rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-4);">
            We stand behind our operational precision with an industry-first guarantee. If a ride fails to be fulfilled or an SLA breach is confirmed:
          </p>
          <div style="background: var(--color-surface); padding: var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--color-border); font-size: 0.875rem; color: var(--color-text-primary); margin-bottom: var(--space-4);">
            <strong>Escrow-Backed Resolution:</strong> Funds for disputed trips are reversed via IMPS or credited to your corporate balance within <strong>60 minutes</strong> of verification.
          </div>
          <div style="font-size: 0.8125rem; color: var(--color-text-secondary);">
            Standard in all AdhocX enterprise contracts across Hyderabad and regional commercial hubs.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Strip -->
  <section style="padding: var(--space-16) 0; background: linear-gradient(135deg, var(--color-primary-900) 0%, #032969 100%); color: #ffffff; text-align: center;">
    <div class="container" style="max-width: 760px; margin: 0 auto;">
      <h2 style="font-size: 2.25rem; font-weight: 800; margin-bottom: var(--space-4); color: #ffffff;">
        Receive a Customized Rate Proposal for Your Campus
      </h2>
      <p style="font-size: 1.125rem; color: var(--color-primary-200); margin-bottom: var(--space-8); line-height: 1.6;">
        Share your shift volumes and campus location. Our enterprise commercial team will model your projected annual cost savings.
      </p>
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn btn-primary btn-large" style="background: var(--color-brand-x); border-color: var(--color-brand-x);">
          Request Custom Proposal &rarr;
        </a>
        <a href="/faq" class="btn btn-outline btn-large" style="color: #ffffff; border-color: rgba(255,255,255,0.4);">
          Read Pricing FAQs
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
