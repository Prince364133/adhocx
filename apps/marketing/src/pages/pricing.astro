---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnterpriseLeadForm from '../components/EnterpriseLeadForm';

// Comprehensive Schema.org JSON-LD for Enterprise Corporate Pricing & Commercial Proposals
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.adhocx.com/pricing#webpage",
      "url": "https://www.adhocx.com/pricing",
      "name": "Predictable Enterprise Mobility Economics & Commercial Proposals | AdhocX Hyderabad",
      "description": "Transparent, auditable corporate mobility commercial frameworks for Hyderabad enterprises. Custom shift packages, per-km commercial rate cards for 4-seater and 7-seater fleets, zero surge, and automated 3-way match reconciliation.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://www.adhocx.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Enterprise Pricing & Rate Cards",
            "item": "https://www.adhocx.com/pricing"
          }
        ]
      }
    },
    {
      "@type": "Service",
      "@id": "https://www.adhocx.com/pricing#service",
      "name": "AdhocX Enterprise Corporate Transport Commercial Proposals",
      "serviceType": "B2B Employee Transportation Services & Corporate Cab Contracts",
      "provider": {
        "@type": "Organization",
        "name": "AdhocX (Estemporaneo Technologies Private Limited)",
        "url": "https://www.adhocx.com"
      },
      "areaServed": {
        "@type": "City",
        "name": "Hyderabad",
        "containedInPlace": {
          "@type": "State",
          "name": "Telangana"
        }
      },
      "description": "Direct corporate contract pricing across commercial 4-seater sedans, 6/7-seater MUVs, and executive vehicles with automated 3-way match reconciliation.",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Corporate Commute Commercial Models",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "4-Seater Commercial Sedans (Daily Shift Commutes)",
              "description": "Optimized for employee doorstep and nodal shift transitions across Hyderabad tech corridors (Dzire, Etios, Tigor EV)."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "6 & 7-Seater Commercial MUVs (High-Efficiency ETS)",
              "description": "High-density workforce transit maximizing seat occupancy and reducing overall corporate mobility expenditure (Ertiga, XL6, Carens)."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Executive Mobility & RGIA Transfers (Leadership Transport)",
              "description": "Dedicated premium vehicles for senior leadership, business guests, and RGIA airport transfers (Innova Crysta, Hycross, VIP Fleets)."
            }
          }
        ]
      }
    }
  ]
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Enterprise Pricing', url: '/pricing' }
];
---

<BaseLayout
  title="Predictable Enterprise Mobility Economics & Commercial Proposals | AdhocX Hyderabad"
  description="Eliminate unvetted vendor markups and opaque manual billing. AdhocX provides direct corporate contract pricing across commercial 4-seater sedans, 6/7-seater MUVs, and executive vehicles with automated 3-way match reconciliation."
  canonical="https://www.adhocx.com/pricing"
  ogTitle="Predictable Enterprise Mobility Economics. Zero Hidden Surcharges | AdhocX"
  ogDescription="Direct corporate contract pricing across commercial 4-seater sedans, 6/7-seater MUVs, and executive vehicles with automated 3-way match reconciliation in Hyderabad."
  ogImage="https://www.adhocx.com/corporate-cab-fleet.jpg"
  ogImageAlt="AdhocX Commercial Corporate Fleet and Rate Card Governance Hyderabad"
  activeNav="pricing"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <!-- 1. Hero Section -->
  <section class="pricing-hero-section">
    <div class="pricing-hero-container">
      <div class="pricing-hero-grid">
        
        <!-- Left Column: Value Proposition & CTAs -->
        <div class="pricing-hero-content">
          <div class="pricing-hero-eyebrow">
            <span class="pricing-pulse-dot" aria-hidden="true"></span>
            <span>Transparent Commercial Governance &bull; Tailored Enterprise Quotations</span>
          </div>

          <h1 class="pricing-hero-h1">
            Predictable Enterprise Mobility Economics. <span class="pricing-text-accent">Zero Hidden Surcharges.</span>
          </h1>

          <p class="pricing-hero-desc">
            Eliminate unvetted vendor markups and opaque manual billing. <strong class="pricing-brand">Adhoc<span class="pricing-brand-x">X</span></strong> provides direct corporate contract pricing across commercial 4-seater sedans, 6/7-seater MUVs, and executive vehicles with automated 3-way match reconciliation.
          </p>

          <div class="pricing-hero-actions">
            <a href="#request-quote" class="pricing-btn-primary">
              <span>Request Custom Corporate Rate Card</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="#commercial-models" class="pricing-btn-secondary">
              <span>Explore Commercial Models</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </a>
          </div>

          <!-- Micro Trust Stats -->
          <div class="pricing-hero-badges">
            <div class="pricing-hero-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5728B2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>100% Commercial Yellow-Plate Fleets</span>
            </div>
            <div class="pricing-hero-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF5F09" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>HITEC City &bull; Gachibowli &bull; Financial Dist.</span>
            </div>
            <div class="pricing-hero-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>Same-Day Rate Card Turnaround</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Visual Showcase (Fleet Photography + Audit Reconciliation Widget) -->
        <div class="pricing-hero-media">
          <div class="pricing-media-card">
            <!-- Background Fleet Image -->
            <div class="pricing-media-image-wrap">
              <img
                src="/corporate-cab-fleet.jpg"
                alt="AdhocX Commercial Corporate Fleet outside Hyderabad IT Park"
                class="pricing-media-img"
                width="840"
                height="560"
                loading="eager"
              />
              <div class="pricing-media-gradient-overlay" aria-hidden="true"></div>
              <div class="pricing-floating-hub-badge">
                <span class="pricing-dot-live"></span>
                <span>Hyderabad Enterprise Corridors Active</span>
              </div>
            </div>

            <!-- Overlaid 3-Way Match Financial Control Card -->
            <div class="pricing-audit-widget">
              <div class="pricing-audit-header">
                <div class="pricing-audit-title-wrap">
                  <div class="pricing-audit-icon-box">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5728B2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                      <polyline points="2 17 12 22 22 17"></polyline>
                      <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                  </div>
                  <div>
                    <h2 class="pricing-audit-title">3-Way Match Audit Engine</h2>
                    <p class="pricing-audit-sub">Automated Enterprise Reconciliation</p>
                  </div>
                </div>
                <div class="pricing-audit-status-badge">
                  <span>100% Reconciled</span>
                </div>
              </div>

              <!-- Reconciliation Steps Mini Grid -->
              <div class="pricing-audit-grid">
                <div class="pricing-audit-cell">
                  <div class="pricing-cell-label">Shift Roster</div>
                  <div class="pricing-cell-val">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>ERP Synced</span>
                  </div>
                </div>
                <div class="pricing-audit-cell">
                  <div class="pricing-cell-label">GPS Geofence</div>
                  <div class="pricing-cell-val">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>0 Deadhead KM</span>
                  </div>
                </div>
                <div class="pricing-audit-cell">
                  <div class="pricing-cell-label">GST Tax Invoice</div>
                  <div class="pricing-cell-val">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Itemized & Verified</span>
                  </div>
                </div>
              </div>

              <!-- Audit Footer Guarantee -->
              <div class="pricing-audit-footer">
                <div class="pricing-audit-guarantee">
                  <span class="pricing-badge-dot-orange"></span>
                  <span>Zero Surge Algorithm &bull; 1-Hour Unserved SLA Credit Active</span>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Trust Indicators (4 Commitments) -->
  <section class="pricing-trust-strip" aria-label="Commercial Commitments and Guarantees">
    <div class="pricing-section-container">
      <div class="pricing-trust-grid">
        
        <!-- Trust Indicator 1: Zero Surge -->
        <div class="pricing-trust-card">
          <div class="pricing-trust-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5728B2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
          </div>
          <div class="pricing-trust-content">
            <h3 class="pricing-trust-title">Zero Surge</h3>
            <p class="pricing-trust-text">Predictable Rates in Weather &amp; Peak Hours</p>
          </div>
        </div>

        <!-- Trust Indicator 2: 1-Hour SLA Credit -->
        <div class="pricing-trust-card">
          <div class="pricing-trust-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FF5F09" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="pricing-trust-content">
            <h3 class="pricing-trust-title">1-Hour SLA Credit</h3>
            <p class="pricing-trust-text">Direct Commercial Guarantee on Unserved Demand</p>
          </div>
        </div>

        <!-- Trust Indicator 3: 3-Way Match -->
        <div class="pricing-trust-card">
          <div class="pricing-trust-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5728B2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <div class="pricing-trust-content">
            <h3 class="pricing-trust-title">3-Way Match</h3>
            <p class="pricing-trust-text">Roster vs. GPS Geofence vs. GST Invoice</p>
          </div>
        </div>

        <!-- Trust Indicator 4: 100% Direct -->
        <div class="pricing-trust-card">
          <div class="pricing-trust-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="pricing-trust-content">
            <h3 class="pricing-trust-title">100% Direct</h3>
            <p class="pricing-trust-text">No Middleman Broker or Aggregator Deductions</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. Commercial Models Section -->
  <section id="commercial-models" class="pricing-models-section">
    <div class="pricing-section-container">
      
      <!-- Section Header -->
      <div class="pricing-section-header text-center">
        <div class="pricing-section-eyebrow">
          <span>Tailored B2B Contracts</span>
        </div>
        <h2 class="pricing-section-h2">
          Flexible Commercial Frameworks for Every Operation
        </h2>
        <p class="pricing-section-sub">
          Whether your enterprise operates 24/7 rotating shifts or daytime executive transit, our transparent rate structures are calibrated to your corporate corridors and headcount.
        </p>
      </div>

      <!-- Models 3-Card Grid -->
      <div class="pricing-models-grid">
        
        <!-- Model 1: 4-Seater Commercial Sedans -->
        <article class="pricing-model-card">
          <!-- Card Image Header -->
          <div class="pricing-model-image-wrap">
            <img
              src="/images/fleet/fleet-dzire.jpg"
              alt="4-Seater Commercial Sedan Dzire for corporate shift commutes"
              class="pricing-model-img"
              width="600"
              height="360"
              loading="lazy"
            />
            <div class="pricing-model-badge-top">
              <span>4-Seater Commercial Sedans</span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="pricing-model-body">
            <h3 class="pricing-model-title">
              Daily Point-to-Point Shift Commutes
            </h3>
            <p class="pricing-model-desc">
              Optimized for employee doorstep and nodal shift transitions across Hyderabad tech corridors (Dzire, Etios, Tigor EV).
            </p>

            <!-- Vehicle Tags -->
            <div class="pricing-vehicle-tags">
              <span class="pricing-v-tag">Maruti Dzire</span>
              <span class="pricing-v-tag">Toyota Etios</span>
              <span class="pricing-v-tag">Tata Tigor EV</span>
            </div>

            <!-- Feature Bullet List -->
            <ul class="pricing-feature-list" role="list">
              <li class="pricing-feature-item">
                <div class="pricing-feature-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5728B2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Dedicated shift duration packages customized to your office hours.</span>
              </li>
              <li class="pricing-feature-item">
                <div class="pricing-feature-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5728B2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Automated multi-stop routing with geofenced pickup arrival timestamps.</span>
              </li>
              <li class="pricing-feature-item">
                <div class="pricing-feature-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5728B2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Clean yellow-board commercial vehicles with valid RTO passenger permits.</span>
              </li>
            </ul>

            <!-- Model CTA -->
            <div class="pricing-model-footer">
              <a href="#request-quote" class="pricing-model-btn-outline">
                <span>Request Sedan Proposal</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Model 2: 6 & 7-Seater Commercial MUVs (High-Efficiency ETS - Featured) -->
        <article class="pricing-model-card pricing-model-featured">
          <!-- Floating Accent Ribbon -->
          <div class="pricing-featured-ribbon">
            <span class="pricing-pulse-dot-light" aria-hidden="true"></span>
            <span>High-Efficiency ETS</span>
          </div>

          <!-- Card Image Header -->
          <div class="pricing-model-image-wrap">
            <img
              src="/images/fleet/fleet-ertiga.jpg"
              alt="6 and 7-Seater Commercial MUV Ertiga for corporate group employee transit"
              class="pricing-model-img"
              width="600"
              height="360"
              loading="lazy"
            />
            <div class="pricing-model-badge-top pricing-badge-featured">
              <span>6 &amp; 7-Seater Commercial MUVs</span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="pricing-model-body">
            <h3 class="pricing-model-title">
              Grouped Shift Transit &amp; Nodal Corridors
            </h3>
            <p class="pricing-model-desc">
              High-density workforce transit maximizing seat occupancy and reducing overall corporate mobility expenditure (Ertiga, XL6, Carens).
            </p>

            <!-- Vehicle Tags -->
            <div class="pricing-vehicle-tags">
              <span class="pricing-v-tag">Maruti Ertiga</span>
              <span class="pricing-v-tag">Maruti XL6</span>
              <span class="pricing-v-tag">Kia Carens</span>
            </div>

            <!-- Feature Bullet List -->
            <ul class="pricing-feature-list" role="list">
              <li class="pricing-feature-item">
                <div class="pricing-feature-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF5F09" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Clustered employee routing minimizing route detour times.</span>
              </li>
              <li class="pricing-feature-item">
                <div class="pricing-feature-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF5F09" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Automated female safe-drop sequencing for late-night &amp; early-morning shifts.</span>
              </li>
              <li class="pricing-feature-item">
                <div class="pricing-feature-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF5F09" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Dynamic OTP/QR boarding verification at every scheduled employee stop.</span>
              </li>
            </ul>

            <!-- Model CTA -->
            <div class="pricing-model-footer">
              <a href="#request-quote" class="pricing-model-btn-primary">
                <span>Request MUV Proposal</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Model 3: Executive Mobility & RGIA Transfers -->
        <article class="pricing-model-card">
          <!-- Card Image Header -->
          <div class="pricing-model-image-wrap">
            <img
              src="/images/fleet/fleet-innova-crysta.jpg"
              alt="Executive Toyota Innova Crysta for corporate client delegation and RGIA transfers"
              class="pricing-model-img"
              width="600"
              height="360"
              loading="lazy"
            />
            <div class="pricing-model-badge-top">
              <span>Executive Mobility &amp; RGIA Transfers</span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="pricing-model-body">
            <h3 class="pricing-model-title">
              Leadership &amp; Client Delegation Transport
            </h3>
            <p class="pricing-model-desc">
              Dedicated premium vehicles for senior leadership, business guests, and RGIA airport transfers (Innova Crysta, Hycross, VIP Fleets).
            </p>

            <!-- Vehicle Tags -->
            <div class="pricing-vehicle-tags">
              <span class="pricing-v-tag">Toyota Innova Crysta</span>
              <span class="pricing-v-tag">Innova Hycross</span>
              <span class="pricing-v-tag">VIP Fleets</span>
            </div>

            <!-- Feature Bullet List -->
            <ul class="pricing-feature-list" role="list">
              <li class="pricing-feature-item">
                <div class="pricing-feature-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5728B2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Priority vehicle assignment with top-rated commercial chauffeurs.</span>
              </li>
              <li class="pricing-feature-item">
                <div class="pricing-feature-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5728B2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Fixed corporate point-to-point airport agreements with flight delay tracking.</span>
              </li>
              <li class="pricing-feature-item">
                <div class="pricing-feature-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5728B2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Executive vehicle sanitization standards and climate-controlled interiors.</span>
              </li>
            </ul>

            <!-- Model CTA -->
            <div class="pricing-model-footer">
              <a href="#request-quote" class="pricing-model-btn-outline">
                <span>Request Executive Proposal</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- 4. Billing Transparency & Financial Controls (3-Step Process) -->
  <section class="pricing-financial-section">
    <div class="pricing-section-container">
      
      <!-- Section Header -->
      <div class="pricing-section-header text-center">
        <div class="pricing-section-eyebrow">
          <span>Audit-Grade Financial Controls</span>
        </div>
        <h2 class="pricing-section-h2">
          How AdhocX Eliminates Corporate Transport Billing Leakage
        </h2>
        <p class="pricing-section-sub">
          Traditional vendor desks rely on physical log sheets, manual odometer readings, and disputed fuel slips. AdhocX digitizes and verifies every billing milestone automatically.
        </p>
      </div>

      <!-- 3-Step Process / Connected Horizontal Timeline -->
      <div class="pricing-timeline-wrapper">
