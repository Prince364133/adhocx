---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnterpriseLeadForm from '../components/EnterpriseLeadForm';

// Comprehensive Schema.org JSON-LD graph for B2B Industries Page
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.adhocx.com/industries#webpage",
      "url": "https://www.adhocx.com/industries",
      "name": "Industry-Specific Corporate Employee Transportation Solutions | AdhocX",
      "description": "Discover AdhocX industry-specific employee transportation solutions for IT, BPO, GCC, BFSI and healthcare enterprises across Hyderabad.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://www.adhocx.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Industries",
            "item": "https://www.adhocx.com/industries"
          }
        ]
      }
    },
    {
      "@type": "Service",
      "@id": "https://www.adhocx.com/industries#service",
      "name": "Corporate Employee Transportation Solutions by Industry in Hyderabad",
      "serviceType": "B2B Enterprise Employee Mobility & Fleet Management",
      "provider": {
        "@type": "Organization",
        "name": "AdhocX",
        "legalName": "Estemporaneo Technologies Private Limited",
        "url": "https://www.adhocx.com",
        "telephone": "+91-7893545818",
        "email": "support@adhocx.com"
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Hyderabad" },
        { "@type": "Place", "name": "HITEC City" },
        { "@type": "Place", "name": "Gachibowli" },
        { "@type": "Place", "name": "Financial District" },
        { "@type": "Place", "name": "Madhapur" },
        { "@type": "Place", "name": "Kondapur" },
        { "@type": "Place", "name": "Pocharam" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "AdhocX Enterprise Verticals",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "IT & Tech Park Employee Transportation",
              "description": "High-density nodal stop optimization and multi-campus employee transit for IT parks across HITEC City and Gachibowli."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "24/7 BPO & KPO Shift Operations Transit",
              "description": "Zero-dropout graveyard shift handoffs with SCSC female safe-drop sequence and verified security escorts."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "GCC & Management Consulting Executive Mobility",
              "description": "Executive-grade 4 & 7-seater premium fleets, RGIA flight-tracked airport transfers, and privacy proxy routing."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "BFSI Audit-Compliant Corporate Transportation",
              "description": "Audit-ready corporate commute controls with automated 3-way match reconciliation and single GST tax invoicing."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Healthcare & Critical Infrastructure Staff Transport",
              "description": "Round-the-clock punctual staff transit for hospitals, diagnostic labs, and critical facility operations with standby replacements."
            }
          }
        ]
      }
    }
  ]
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Industries', url: '/industries' }
];
---

<BaseLayout
  title="Industry-Specific Corporate Employee Transportation Solutions | AdhocX"
  description="Discover AdhocX industry-specific employee transportation solutions for IT, BPO, GCC, BFSI and healthcare enterprises across Hyderabad."
  canonical="https://www.adhocx.com/industries"
  ogTitle="Industry-Specific Corporate Employee Transportation Solutions | AdhocX"
  ogDescription="Discover AdhocX industry-specific employee transportation solutions for IT, BPO, GCC, BFSI and healthcare enterprises across Hyderabad."
  ogImage="https://www.adhocx.com/images/industries/hero-industries.jpg"
  ogImageAlt="AdhocX Corporate Employee Transportation Solutions by Industry in Hyderabad"
  activeNav="industries"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <!-- =========================================================================
       SECTION 1: HERO SECTION
       "Tailored Employee Commute Solutions for Every Enterprise Industry."
       ========================================================================= -->
  <section class="ind-hero-section" id="hero">
    <div class="ind-hero-bg-grid"></div>
    <div class="container ind-hero-container">
      <div class="ind-hero-grid">
        <!-- Left Hero Column: Copy & CTAs -->
        <div class="ind-hero-content">
          <!-- Eyebrow Badge -->
          <div class="ind-eyebrow-badge">
            <span class="ind-pulse-dot"></span>
            <span>Enterprise Sector Solutions &bull; Hyderabad Tech Corridors</span>
          </div>

          <!-- Main H1 Title -->
          <h1 class="ind-hero-h1">
            Tailored Employee Commute Solutions <br />
            <span class="ind-gradient-accent">for Every Enterprise Industry.</span>
          </h1>

          <!-- Description -->
          <p class="ind-hero-desc">
            Different sectors have radically different shift dynamics, regulatory compliance requirements, and passenger safety obligations. Discover how <span class="ind-brand-inline">Adhoc<strong>X</strong></span> customizes corporate transport operations for your specific industry.
          </p>

          <!-- Action CTA Buttons -->
          <div class="ind-hero-actions">
            <a href="#industry-sectors" class="btn-pill-primary ind-hero-btn-primary">
              <span>Explore Industry Solutions</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="#request-quote" class="btn-pill-secondary ind-hero-btn-secondary">
              <span>Request Sector Consultation</span>
            </a>
          </div>

          <!-- Enterprise Value Badges -->
          <div class="ind-hero-checks">
            <div class="ind-check-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>100% Commercial Yellow-Plate</span>
            </div>
            <div class="ind-check-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>SCSC Night Safety Compliant</span>
            </div>
            <div class="ind-check-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>3-Way Match Audit Invoicing</span>
            </div>
          </div>
        </div>

        <!-- Right Hero Column: Corporate Mobility Showcase -->
        <div class="ind-hero-visual-wrapper">
          <div class="ind-hero-image-card">
            <img 
              src="/images/industries/hero-industries.jpg" 
              alt="AdhocX corporate employee transportation and commercial fleet outside modern Hyderabad IT campus" 
              class="ind-hero-photo"
              width="1400"
              height="933"
              loading="eager"
            />
            <div class="ind-hero-image-overlay"></div>

            <!-- Overlaid Floating Telemetry Card 1 -->
            <div class="ind-float-telemetry-top">
              <div class="ind-float-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <div>
                <div class="ind-float-lbl">HYDERABAD TECH CORRIDORS</div>
                <div class="ind-float-val">HITEC City &bull; Gachibowli &bull; Pocharam</div>
              </div>
            </div>

            <!-- Overlaid Floating Telemetry Card 2 -->
            <div class="ind-float-telemetry-bottom">
              <div class="ind-telemetry-dot-wrap">
                <span class="ind-live-indicator"></span>
              </div>
              <div class="ind-telemetry-details">
                <div class="ind-float-lbl">DIRECT ENTERPRISE SOURCING</div>
                <div class="ind-float-val">Zero Private Cab Reg Liability &bull; Locked Rates</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTOR QUICK-JUMP NAVIGATION BAR
       ========================================================================= -->
  <nav class="ind-quicknav-bar" aria-label="Industry sector navigation">
    <div class="container">
      <div class="ind-quicknav-wrapper">
        <span class="ind-quicknav-label">Select Vertical:</span>
        <div class="ind-quicknav-pills">
          <a href="#it-tech-parks" class="ind-quicknav-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            <span>IT & Tech Parks</span>
          </a>
          <a href="#bpo-operations" class="ind-quicknav-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>24/7 BPO & Operations</span>
          </a>
          <a href="#gcc-consulting" class="ind-quicknav-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            <span>GCCs & Consulting</span>
          </a>
          <a href="#bfsi-banking" class="ind-quicknav-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            <span>Banking & BFSI</span>
          </a>
          <a href="#healthcare-infrastructure" class="ind-quicknav-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            <span>Healthcare & Facilities</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- =========================================================================
       SECTION 2: SPECIALIZED INDUSTRY SOLUTIONS (5 VERTICALS)
       ========================================================================= -->
  <section id="industry-sectors" class="ind-sectors-section">
    <div class="container">
      <!-- Section Header -->
      <div class="ind-section-header">
        <div class="ind-eyebrow-badge">
          <span class="ind-pulse-dot"></span>
          <span>Specialized Verticals</span>
        </div>
        <h2 class="ind-section-h2">Engineered for Exact Operating Conditions</h2>
        <p class="ind-section-desc">
          Whether moving thousands of software engineers in peak hours or safeguarding overnight operations, AdhocX provides specialized mobility frameworks.
        </p>
      </div>

      <!-- Vertical Solution Showcases (Alternating 2-Column Cards) -->
      <div class="ind-verticals-stack">

        <!-- ==========================================
             VERTICAL 1: IT & Tech Parks
             ========================================== -->
        <article class="ind-sector-card" id="it-tech-parks">
          <div class="ind-sector-content">
            <div class="ind-sector-top-meta">
              <span class="ind-sector-num">01</span>
              <span class="ind-sector-tag tag-blue">High-Density Tech Hubs</span>
            </div>

            <div class="ind-sector-icon-title">
              <div class="ind-sector-icon-box box-blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
              </div>
              <h3 class="ind-sector-h3">Information Technology &amp; Tech Parks</h3>
            </div>

            <p class="ind-sector-p">
              Designed for massive campus operations across HITEC City, Gachibowli, and the Financial District. Handles complex rotational rosters and multi-facility employee transit with clustered routing.
            </p>

            <!-- Features Checklist -->
            <ul class="ind-feature-list" role="list">
              <li class="ind-feature-item">
                <div class="ind-feat-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>High-density nodal stop optimization minimizing travel times.</span>
              </li>
              <li class="ind-feature-item">
                <div class="ind-feat-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Multi-office campus connectivity between Kondapur, Madhapur &amp; Gachibowli.</span>
              </li>
              <li class="ind-feature-item">
                <div class="ind-feat-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Scalable commercial fleet capacity for high-volume shift changes.</span>
              </li>
            </ul>

            <!-- Operational Parameters Footer -->
            <div class="ind-sector-footer">
              <a href="#request-quote" class="ind-sector-cta-btn">
                <span>Request Tech Campus Plan</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <div class="ind-fleet-pill">
                <span>Fleets:</span> 4-Seater Sedans &bull; 7-Seater MUVs
              </div>
            </div>
          </div>

          <div class="ind-sector-media">
            <div class="ind-image-frame">
              <img 
                src="/images/industries/it-tech-parks.jpg" 
                alt="Corporate employees boarding commercial cabs outside a modern IT campus in Hyderabad"
                class="ind-sector-photo"
                width="1000"
                height="667"
                loading="lazy"
              />
              <div class="ind-photo-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                <span>HITEC City &bull; Financial District Corridors</span>
              </div>
            </div>
          </div>
        </article>


        <!-- ==========================================
             VERTICAL 2: 24/7 BPO & Operations (Featured)
             ========================================== -->
        <article class="ind-sector-card ind-sector-card-featured" id="bpo-operations">
          <div class="ind-sector-content">
            <div class="ind-sector-top-meta">
              <span class="ind-sector-num">02</span>
              <!-- Company Badge Requirement -->
              <span class="ind-sector-tag tag-purple-badge">24/7 Duty Ready</span>
            </div>

            <div class="ind-sector-icon-title">
              <div class="ind-sector-icon-box box-purple">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <h3 class="ind-sector-h3">24/7 BPO, KPO &amp; Customer Operations</h3>
            </div>

            <p class="ind-sector-p">
              Zero-dropout shift handoffs and uncompromising night safety protocols. Strict adherence to Cyberabad Security Council (SCSC) guidelines for graveyard shifts.
            </p>

            <!-- Features Checklist -->
            <ul class="ind-feature-list" role="list">
              <li class="ind-feature-item">
                <div class="ind-feat-icon feat-purple">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Automated female safe-drop sequence: never drop a female employee first/last.</span>
              </li>
              <li class="ind-feature-item">
                <div class="ind-feat-icon feat-purple">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Mandatory verified security escort integration for midnight shift drops.</span>
              </li>
              <li class="ind-feature-item">
                <div class="ind-feat-icon feat-purple">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>1-tap employee SOS linked directly to our 24/7 emergency response desk.</span>
              </li>
            </ul>

            <!-- Operational Parameters Footer -->
            <div class="ind-sector-footer">
              <a href="#request-quote" class="ind-sector-cta-btn btn-featured-cta">
                <span>Request 24/7 Shift Plan</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <div class="ind-fleet-pill pill-purple">
                <span>Safety:</span> SCSC Safe-Drop &bull; Verified Escorts
              </div>
            </div>
          </div>

          <div class="ind-sector-media">
            <div class="ind-image-frame">
              <img 
                src="/images/industries/bpo-night-shift.jpg" 
                alt="Professional night-shift employee transportation with a commercial cab and security escort in Hyderabad"
                class="ind-sector-photo"
                width="1000"
                height="667"
                loading="lazy"
              />
              <div class="ind-photo-badge badge-night">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Cyberabad SCSC Protocol Enforced</span>
              </div>
            </div>
          </div>
        </article>


        <!-- ==========================================
             VERTICAL 3: GCCs & Consulting
             ========================================== -->
        <article class="ind-sector-card" id="gcc-consulting">
          <div class="ind-sector-content">
            <div class="ind-sector-top-meta">
              <span class="ind-sector-num">03</span>
              <span class="ind-sector-tag tag-blue">Executive &amp; Global Mobility</span>
            </div>

            <div class="ind-sector-icon-title">
              <div class="ind-sector-icon-box box-blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              </div>
              <h3 class="ind-sector-h3">Global Capability Centers (GCCs) &amp; Consulting</h3>
            </div>

            <p class="ind-sector-p">
              Executive-grade mobility services for international leadership, consulting delegations, and client partner travel. Premium 4 &amp; 7-seater vehicles with seasoned chauffeurs.
            </p>

            <!-- Features Checklist -->
            <ul class="ind-feature-list" role="list">
              <li class="ind-feature-item">
                <div class="ind-feat-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Dedicated premium fleets: Innova Crysta, Hycross, and luxury sedans.</span>
              </li>
              <li class="ind-feature-item">
                <div class="ind-feat-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Seamless RGIA airport meet-and-greet transfers with flight delay tracking.</span>
              </li>
              <li class="ind-feature-item">
                <div class="ind-feat-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>Strict non-disclosure, sanitized interiors, and privacy calling proxy.</span>
              </li>
            </ul>

            <!-- Operational Parameters Footer -->
            <div class="ind-sector-footer">
              <a href="#request-quote" class="ind-sector-cta-btn">
                <span>Request GCC Mobility Plan</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <div class="ind-fleet-pill">
                <span>Fleets:</span> Innova Crysta &bull; Hycross &bull; Exec Sedans
              </div>
            </div>
          </div>

          <div class="ind-sector-media">
            <div class="ind-image-frame">
              <img 
                src="/images/industries/gcc-executive.jpg" 
                alt="Premium executive commercial vehicle outside a corporate office or airport in Hyderabad"
                class="ind-sector-photo"
                width="1000"
                height="667"
                loading="lazy"
              />
              <div class="ind-photo-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                <span>RGIA Airport Meet &amp; Greet &bull; Flight-Tracked</span>
              </div>
            </div>
          </div>
        </article>


        <!-- ==========================================
             VERTICAL 4: Banking & Financial Services (BFSI)
             ========================================== -->
        <article class="ind-sector-card" id="bfsi-banking">
          <div class="ind-sector-content">
            <div class="ind-sector-top-meta">
              <span class="ind-sector-num">04</span>
              <span class="ind-sector-tag tag-blue">Audit-Grade Financial Controls</span>
            </div>

            <div class="ind-sector-icon-title">
              <div class="ind-sector-icon-box box-blue">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <line x1="12" y1="1" x2="12" y2="23"></line>
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
              </div>
              <h3 class="ind-sector-h3">Banking &amp; Financial Services (BFSI)</h3>
            </div>

            <p class="ind-sector-p">
              Audit-ready compliance and rigorous financial controls. Automated 3-way match reconciliation ensures finance directors experience zero billing leakage.
            </p>

            <!-- Features Checklist -->
            <ul class="ind-feature-list" role="list">
              <li class="ind-feature-item">
                <div class="ind-feat-icon">
