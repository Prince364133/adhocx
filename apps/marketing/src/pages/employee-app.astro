---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnterpriseLeadForm from '../components/EnterpriseLeadForm';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "AdhocX Employee Mobile App",
    "operatingSystem": "Android, iOS",
    "applicationCategory": "BusinessApplication",
    "publisher": {
      "@type": "Organization",
      "name": "Estemporaneo Technologies Private Limited",
      "alternateName": "AdhocX",
      "url": "https://www.adhocx.com"
    },
    "description": "Dedicated corporate mobile commuter app for enterprise employees. Real-time GPS cab tracking, shift roster visibility, expiring OTP boarding verification, and 1-tap emergency SOS connected to a 24/7 command center."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.adhocx.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Employee App",
        "item": "https://www.adhocx.com/employee-app"
      }
    ]
  }
];
---

<BaseLayout
  title="Employee Mobile App — Commuter Experience | AdhocX"
  description="Designed exclusively for employees using roster-driven company transportation. Real-time vehicle telemetry, precise pickup ETAs, dynamic boarding verification, and prominent SOS emergency assistance."
  canonical="https://www.adhocx.com/employee-app"
  activeNav="employee-app"
  jsonLd={jsonLd}
>
  <!-- =========================================================================
       SECTION 1: HERO SECTION
       "Every Commute in Your Pocket. Real-Time, Verified, and Secure."
       ========================================================================= -->
  <section class="emp-hero-section" id="hero">
    <div class="container emp-hero-grid">
      <!-- Left Hero Column: Copy & Actions -->
      <div class="emp-hero-content">
        <!-- H1 Title -->
        <h1 class="emp-hero-h1">
          Every Commute in Your Pocket. <span class="h1-purple">Real-Time, Verified, and Secure.</span>
        </h1>

        <!-- Subtitle Description -->
        <p class="emp-hero-desc">
          Designed exclusively for corporate employees using roster-driven company transportation. Real-time vehicle telemetry, precise pickup ETAs, dynamic boarding verification, and prominent SOS emergency assistance.
        </p>

        <!-- CTA Buttons -->
        <div class="emp-hero-actions">
          <a href="#app-features" class="btn-orange-primary" id="btn-hero-capabilities">
            <span>Explore App Capabilities</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="/contact" class="btn-outline-pill" id="btn-hero-demo">
            Request Enterprise Demo
          </a>
        </div>

        <!-- Value Checks -->
        <div class="emp-hero-trust-strip">
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>100% Yellow-Plate Commercial Cabs</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Sub-15s Telemetry Freshness</span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.4rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>1-Tap Central Emergency SOS</span>
          </div>
        </div>
      </div>

      <!-- Right Hero Column: Realistic Smartphone App Mockup -->
      <div class="emp-hero-mockup-wrap">
        <!-- Smartphone Frame -->
        <div class="phone-mockup" aria-label="AdhocX Employee Mobile App Interface Preview">
          <div class="phone-top-bar">
            <span>08:15 AM</span>
            <div class="phone-notch"></div>
            <span>5G 100%</span>
          </div>

          <div class="phone-screen">
            <!-- App Header -->
            <div class="phone-app-header">
              <div class="phone-app-brand">
                <span>Adhoc<span style="color: #FF5F09;">X</span></span>
                <span class="phone-emp-chip">EMP88888</span>
              </div>
              <div class="phone-user-greeting">Welcome back,</div>
              <div class="phone-user-name">Demo Commuter</div>
              <div style="font-size: 0.6875rem; color: #DDD6FE; margin-top: 2px;">HiTEC Technologies Ltd. &bull; HITEC City HQ</div>
            </div>

            <div class="phone-body">
              <!-- Active Shift Pickup Card -->
              <div class="phone-card">
                <div class="phone-card-title-row">
                  <span style="font-size: 0.8125rem; font-weight: 700; color: #0F172A;">Office Pickup (Login)</span>
                  <span class="phone-card-tag tag-green">Confirmed</span>
                </div>

                <div style="font-size: 0.75rem; color: #64748B; margin-bottom: 0.5rem;">
                  Today &bull; 08:15 AM &bull; <strong style="color: #5728B2;">ETA ~6 mins</strong>
                </div>

                <div style="font-size: 0.75rem; color: #334155; line-height: 1.4; margin-bottom: 0.75rem;">
                  <div><span style="color: #10B981; font-weight: 800;">&bull;</span> Pickup: Flat 402, Green Glen Layout</div>
                  <div><span style="color: #5728B2; font-weight: 800;">&bull;</span> Drop: HITEC City Office, Tower B</div>
                </div>

                <!-- Driver Details -->
                <div style="background: #F8FAFC; border-radius: 0.5rem; padding: 0.625rem; display: flex; align-items: center; justify-content: space-between; border: 1px solid #E2E8F0;">
                  <div>
                    <div style="font-size: 0.8125rem; font-weight: 700; color: #0F172A;">Suresh R</div>
                    <div style="font-size: 0.6875rem; color: #64748B;">Maruti Ertiga (White)</div>
                  </div>
                  <div style="text-align: right;">
                    <span style="font-size: 0.6875rem; background: #ECE6FE; color: #5728B2; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 700;">
                      TS09UB7845
                    </span>
                    <div style="font-size: 0.6875rem; color: #F59E0B; font-weight: 700; margin-top: 2px;">4.8 ★</div>
                  </div>
                </div>
              </div>

              <!-- Quick Action Button in Phone -->
              <div style="display: flex; gap: 0.5rem;">
                <button type="button" style="flex: 1; background: #5728B2; color: #FFFFFF; border: none; border-radius: 0.5rem; padding: 0.5rem; font-size: 0.75rem; font-weight: 700;">
                  Track Cab Live
                </button>
                <button type="button" style="background: #FEF2F2; color: #DC2626; border: 1px solid #FCA5A5; border-radius: 0.5rem; padding: 0.5rem 0.75rem; font-size: 0.75rem; font-weight: 700;">
                  SOS
                </button>
              </div>
            </div>

            <!-- Bottom Navigation Bar -->
            <div class="phone-bottom-nav">
              <span class="nav-active">Home</span>
              <span>Schedule</span>
              <span>Trips</span>
              <span>Support</span>
              <span>Profile</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 2: SEAMLESS EMPLOYEE MOBILITY
       "Built for Punctual Logins & Safe Night Returns"
       ========================================================================= -->
  <section class="emp-mobility-section" id="mobility">
    <div class="container emp-mobility-grid">
      <!-- Left Column: Copy & 3 Feature Cards -->
      <div>
        <span class="about-section-eyebrow">Seamless Employee Mobility</span>
        <h2 class="about-section-h2">
          Built for Punctual Logins & Safe Night Returns
        </h2>
        <p class="about-section-desc" style="margin-bottom: 2rem;">
          Employees no longer need to call call-centers or message unorganized WhatsApp groups to locate their cab. The AdhocX Employee App keeps commuters updated at every stage of their journey.
        </p>

        <div class="emp-mobility-features-list">
          <!-- Feature 1: Corporate SSO & Secure OTP Login -->
          <div class="emp-mobility-feature-item">
            <div class="emp-feature-icon-box" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <div>
              <h3 class="emp-feature-title">Corporate SSO & Secure OTP Login</h3>
              <p class="emp-feature-desc">
                Instant authentication via company email or phone OTP, mapped directly to active enterprise roster eligibility.
              </p>
            </div>
          </div>

          <!-- Feature 2: Transparent Driver & Vehicle Details -->
          <div class="emp-mobility-feature-item">
            <div class="emp-feature-icon-box" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
                <circle cx="7" cy="17" r="2"></circle>
                <path d="M9 17h6"></path>
                <circle cx="17" cy="17" r="2"></circle>
              </svg>
            </div>
            <div>
              <h3 class="emp-feature-title">Transparent Driver & Vehicle Details</h3>
              <p class="emp-feature-desc">
                Driver photo, verified name, commercial plate number, and car model displayed prior to pickup.
              </p>
            </div>
          </div>

          <!-- Feature 3: Privacy-Safe Calling -->
          <div class="emp-mobility-feature-item">
            <div class="emp-feature-icon-box" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div>
              <h3 class="emp-feature-title">Privacy-Safe Calling</h3>
              <p class="emp-feature-desc">
                In-app proxy calling ensures drivers and employees communicate without exposing personal phone numbers.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Prominent App Illustration Crop -->
      <div>
        <div class="emp-mobility-img-frame">
          <img
            src="/employee-app-illustration.jpg"
            alt="AdhocX Employee Mobile App Commuter Interface"
            class="emp-mobility-img"
            width="440"
            height="520"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 3: EMPLOYEE APP CAPABILITIES (2-2 SCREENSHOT GRID)
       4 Essential Modules in 2x2 Screen Pairs
       ========================================================================= -->
  <section class="emp-capabilities-section" id="app-features">
    <div class="container">
      <div class="emp-capabilities-header">
        <span class="about-section-eyebrow">Employee App Capabilities</span>
        <h2 class="about-section-h2">Engineered for Corporate Safety, Predictability & Clarity</h2>
        <p class="about-section-desc">
          Four essential operational modules mapped to enterprise transportation policies, giving employees full visibility while respecting privacy.
        </p>
      </div>

      <div class="emp-modules-grid">
        <!-- Module 01: Live Tracking & GPS Freshness -->
        <div class="emp-module-card">
          <div class="emp-module-info">
            <span class="emp-feature-tag-badge">Module 01 &bull; Real-Time Telemetry</span>
            <h3 class="emp-module-title">Live Tracking & GPS Freshness</h3>
            <p class="emp-module-desc">
              Live map showing cab position with an authentic GPS age indicator. Stale GPS is clearly marked rather than showing frozen coordinates.
            </p>
            <div class="emp-feature-supporting-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Includes walking directions to pickup spot & arrival alerts</span>
            </div>
          </div>

          <div class="emp-module-mockup-wrap">
            <div class="phone-mockup">
              <div class="phone-top-bar">
                <span>08:18 AM</span>
                <div class="phone-notch"></div>
                <span>5G 98%</span>
              </div>
              <div class="phone-screen">
                <div class="phone-app-header" style="padding-bottom: 0.85rem;">
                  <div style="font-size: 0.8125rem; font-weight: 800;">Live Cab Telemetry</div>
                  <div style="font-size: 0.65rem; color: #DDD6FE;">En route to Green Glen Layout</div>
                </div>

                <div class="phone-body">
                  <!-- Map Graphic Simulation -->
                  <div class="phone-map-container" style="height: 130px;">
                    <div class="map-gps-age">
                      <span style="color: #10B981;">●</span> GPS Age: 4s
                    </div>
                    <div class="map-cab-pin">
                      🚗 TS09UB7845
                    </div>
                  </div>

                  <div class="phone-card">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                      <div>
                        <div style="font-size: 0.75rem; font-weight: 700; color: #0F172A;">Pickup Point: Flat 402 Gate</div>
                        <div style="font-size: 0.65rem; color: #64748B;">Walking time: 2 mins (120m)</div>
                      </div>
                      <span class="phone-card-tag tag-green">ETA 4 MINS</span>
                    </div>
                  </div>
                </div>

                <div class="phone-bottom-nav">
                  <span>Home</span>
                  <span>Schedule</span>
                  <span class="nav-active">Tracking</span>
                  <span>Support</span>
                  <span>Profile</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Module 02: 1-Tap Emergency SOS -->
        <div class="emp-module-card">
          <div class="emp-module-info">
            <span class="emp-feature-tag-badge" style="color: #DC2626; background: #FEE2E2; border-color: #FECACA;">Module 02 &bull; Life Safety</span>
            <h3 class="emp-module-title">1-Tap Emergency SOS</h3>
            <p class="emp-module-desc">
              Active during every in-progress trip. Instantly transmits live vehicle coordinates, trip identifiers, and employee details to our 24/7 command centre.
            </p>
            <div class="emp-feature-supporting-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Immediate acknowledgement & automated emergency escalation</span>
            </div>
          </div>

          <div class="emp-module-mockup-wrap">
            <div class="phone-mockup">
              <div class="phone-top-bar">
                <span>10:45 PM</span>
                <div class="phone-notch"></div>
                <span>5G 92%</span>
              </div>
              <div class="phone-screen">
                <div class="phone-app-header" style="background: #7F1D1D; text-align: center; padding-bottom: 0.85rem;">
                  <div style="font-size: 0.6875rem; color: #FCA5A5; text-transform: uppercase; font-weight: 700;">Safety Command Link</div>
                  <div style="font-size: 0.875rem; font-weight: 800; color: #FFFFFF;">In-Transit Emergency SOS</div>
                </div>

                <div class="phone-body">
                  <div class="phone-sos-box" style="padding: 1rem 0.5rem;">
                    <button type="button" class="phone-sos-btn" style="width: 56px; height: 56px; font-size: 1.1rem; margin: 0.25rem auto;" aria-label="Trigger SOS">
                      SOS
                    </button>
                    <div style="font-size: 0.72rem; font-weight: 800; color: #991B1B; margin-top: 0.35rem;">
                      Press & Hold to Trigger
                    </div>
                    <div style="font-size: 0.65rem; color: #7F1D1D; margin-top: 2px;">
                      Transmits GPS coordinates to Hyderabad 24/7 Desk
                    </div>
                  </div>

                  <div class="phone-card">
                    <div style="font-size: 0.72rem; font-weight: 700; color: #0F172A; margin-bottom: 0.2rem;">Active Safety Protocol</div>
                    <div style="font-size: 0.65rem; color: #64748B;">Night Shift Escort Confirmed &bull; Safe Drop SMS Active</div>
                  </div>
                </div>

                <div class="phone-bottom-nav">
                  <span>Home</span>
                  <span>Schedule</span>
                  <span>Trips</span>
                  <span class="nav-active" style="color: #DC2626;">SOS Desk</span>
                  <span>Profile</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Module 03: Dynamic OTP / QR Boarding -->
        <div class="emp-module-card">
          <div class="emp-module-info">
            <span class="emp-feature-tag-badge">Module 03 &bull; Fraud Prevention</span>
            <h3 class="emp-module-title">Dynamic OTP / QR Boarding</h3>
            <p class="emp-module-desc">
              Secure expiring OTP or QR challenge presented to the driver upon boarding. Guarantees that only authorized employees board the correct cab.
            </p>
            <div class="emp-feature-supporting-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Timestamped boarding verification & safe-reach logging</span>
            </div>
          </div>

          <div class="emp-module-mockup-wrap">
            <div class="phone-mockup">
              <div class="phone-top-bar">
                <span>08:23 AM</span>
                <div class="phone-notch"></div>
                <span>5G 95%</span>
              </div>
              <div class="phone-screen">
                <div class="phone-app-header" style="background: #0F172A; text-align: center; padding-bottom: 0.85rem;">
                  <div style="font-size: 0.6875rem; color: #94A3B8; text-transform: uppercase; font-weight: 700;">Boarding Authentication</div>
                  <div style="font-size: 0.875rem; font-weight: 800; color: #FFFFFF; margin-top: 2px;">Share Code With Driver</div>
                </div>

                <div class="phone-body">
                  <div class="phone-otp-box" style="padding: 1rem 0.5rem;">
                    <div style="font-size: 0.65rem; color: #64748B; font-weight: 700; text-transform: uppercase;">One-Time Boarding Passcode</div>
                    <div class="phone-otp-digits" style="font-size: 1.6rem; letter-spacing: 0.25em; margin: 0.25rem 0;">8 4 9 2</div>
                    <div style="font-size: 0.65rem; color: #EE9811; font-weight: 600;">Expiring in 48s &bull; Auto-Refreshes</div>
                  </div>

                  <div class="phone-card" style="text-align: center;">
                    <span class="phone-card-tag tag-green">✓ Valid Commercial Yellow-Plate</span>
                    <div style="font-size: 0.6875rem; color: #475569; margin-top: 0.35rem;">
                      Driver Suresh R matched to Duty Slip #DS-9428
                    </div>
                  </div>
                </div>

                <div class="phone-bottom-nav">
                  <span>Home</span>
                  <span class="nav-active">Verify</span>
                  <span>Trips</span>
                  <span>Support</span>
                  <span>Profile</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Module 04: Shift Calendar & Policy Rescheduling -->
        <div class="emp-module-card">
          <div class="emp-module-info">
            <span class="emp-feature-tag-badge">Module 04 &bull; Policy Alignment</span>
            <h3 class="emp-module-title">Shift Calendar & Policy Rescheduling</h3>
            <p class="emp-module-desc">
              View upcoming weekly and monthly shift schedules. Submit cancellation or pickup location modification requests strictly within corporate policy cutoff windows.
            </p>
            <div class="emp-feature-supporting-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Prevents duplicate requests & aligns with HR approvals</span>
            </div>
          </div>

          <div class="emp-module-mockup-wrap">
            <div class="phone-mockup">
              <div class="phone-top-bar">
                <span>09:00 AM</span>
                <div class="phone-notch"></div>
                <span>5G 88%</span>
              </div>
              <div class="phone-screen">
                <div class="phone-app-header" style="padding-bottom: 0.85rem;">
                  <div style="font-size: 0.6875rem; color: #E9D5FF; text-transform: uppercase; font-weight: 700;">Shift Rostering</div>
                  <div style="font-size: 0.875rem; font-weight: 800; color: #FFFFFF;">Weekly Commute Schedule</div>
                </div>

                <div class="phone-body">
                  <!-- Shift Row 1 -->
                  <div class="phone-card">
                    <div class="phone-card-title-row" style="margin-bottom: 0.35rem;">
                      <span style="font-size: 0.75rem; font-weight: 700;">Mon &bull; Login Shift</span>
                      <span class="phone-card-tag tag-green">Scheduled</span>
                    </div>
                    <div style="font-size: 0.65rem; color: #64748B;">Pickup 08:30 AM &bull; Flat 402 Gate</div>
                  </div>

                  <!-- Shift Row 2 -->
                  <div class="phone-card">
                    <div class="phone-card-title-row" style="margin-bottom: 0.35rem;">
                      <span style="font-size: 0.75rem; font-weight: 700;">Mon &bull; Logout Shift</span>
                      <span class="phone-card-tag tag-purple">Cutoff: 15:00</span>
                    </div>
                    <div style="font-size: 0.65rem; color: #64748B;">Drop 18:00 PM &bull; Tower B Bay 4</div>
                  </div>

                  <div style="text-align: center; margin-top: 0.25rem;">
                    <span style="font-size: 0.65rem; color: #5728B2; font-weight: 700; cursor: pointer;">+ Request Route / Pickup Change</span>
                  </div>
                </div>

                <div class="phone-bottom-nav">
                  <span>Home</span>
                  <span class="nav-active">Schedule</span>
                  <span>Trips</span>
                  <span>Support</span>
                  <span>Profile</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 4: ENTERPRISE QUOTATION & PROPOSAL (REUSING ENTERPRISELEADFORM)
       "Request Custom Corporate Quotation & Proposal"
       ========================================================================= -->
  <section class="emp-rfp-section" id="corporate-quotation">
    <div class="container">
      <div class="rfp-header">
        <span class="about-section-eyebrow">Direct Enterprise Sourcing</span>
        <h2 class="about-section-h2">Request Custom Corporate Quotation &amp; Proposal</h2>
        <p class="about-section-desc">
          Tailored B2B contract pricing for 4-seater and 7-seater yellow-plate commercial fleets across Hyderabad tech corridors.
        </p>
      </div>

      <div class="rfp-cards-grid">
        <!-- Card 01: Sourcing & SLAs -->
        <div class="rfp-card">
          <div class="rfp-card-top">
            <span class="rfp-module-badge">Module 01 &bull; Direct Sourcing &amp; SLA</span>
            <h3 class="rfp-card-title">Commercial Fleet Assurances</h3>
            <p class="rfp-card-desc">
              Direct bilateral enterprise contracts locked at inception with zero hidden surge surcharges across Hyderabad IT zones.
            </p>

            <div class="rfp-supporting-pills">
              <div class="rfp-supporting-pill">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
