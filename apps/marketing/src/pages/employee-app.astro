---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnterpriseLeadForm from '../components/EnterpriseLeadForm';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "AdhocX Employee Mobile App",
  "operatingSystem": "Android, iOS",
  "applicationCategory": "BusinessApplication",
  "publisher": {
    "@type": "Organization",
    "name": "Estemporaneo Technologies Private Limited",
    "url": "https://www.adhocx.com"
  },
  "description": "Dedicated corporate mobile commuter app for enterprise employees. Real-time GPS cab tracking, shift roster visibility, expiring OTP boarding verification, and 1-tap emergency SOS connected to a 24/7 command center."
};
---

<BaseLayout
  title="Employee Mobile App — Corporate Commuter Experience | AdhocX"
  description="Explore the AdhocX Employee Mobile App: view shift rosters, track assigned commercial cabs live on GPS with age freshness, verify boarding with secure OTP/QR, and access 1-tap SOS safety assistance."
  canonical="https://www.adhocx.com/employee-app"
  activeNav="employee-app"
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="page-hero-section" style="background: linear-gradient(180deg, var(--color-primary-50) 0%, #ffffff 100%); padding: var(--space-16) 0 var(--space-12);">
    <div class="container text-center" style="max-width: 900px; margin: 0 auto;">
      <div class="badge badge-blue" style="margin-bottom: var(--space-4);">
        <span class="status-dot-pulse"></span>
        <span>Corporate Commuter Experience &bull; iOS & Android</span>
      </div>
      <h1 class="display-title" style="color: var(--color-text-primary); margin-bottom: var(--space-6);">
        Every Commute in Your Pocket. <br />
        <span style="color: var(--color-primary-600);">Real-Time, Verified, and Secure.</span>
      </h1>
      <p class="body-large" style="color: var(--color-text-secondary); margin-bottom: var(--space-8); line-height: 1.6;">
        Designed exclusively for corporate employees using roster-driven company transportation. Real-time vehicle telemetry, precise pickup ETAs, dynamic boarding verification, and prominent SOS emergency assistance.
      </p>
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="#app-features" class="btn btn-primary btn-large">
          Explore App Capabilities &rarr;
        </a>
        <a href="/contact" class="btn btn-secondary btn-large">
          Request Enterprise Demo
        </a>
      </div>
    </div>
  </section>

  <!-- App Visual Showcase Section -->
  <section class="section-padding" style="background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-12); align-items: center;">
        <div>
          <span class="badge badge-primary" style="margin-bottom: var(--space-3);">Seamless Employee Mobility</span>
          <h2 style="font-size: 2.25rem; font-weight: 800; color: var(--color-text-primary); margin-bottom: var(--space-4);">
            Built for Punctual Logins & Safe Night Returns
          </h2>
          <p class="body-large" style="color: var(--color-text-secondary); margin-bottom: var(--space-6);">
            Employees no longer need to call call-centers or message unorganized WhatsApp groups to locate their cab. The AdhocX Employee App keeps commuters updated at every stage of their journey.
          </p>

          <div style="display: flex; flex-direction: column; gap: var(--space-4);">
            <div style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <div style="width: 2rem; height: 2rem; border-radius: 6px; background: #ECE6FE; color: #5728B2; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <strong style="color: var(--color-text-primary);">Corporate SSO & Secure OTP Login:</strong>
                <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin-top: 2px;">Instant authentication via company email or phone OTP, mapped directly to active enterprise roster eligibility.</p>
              </div>
            </div>

            <div style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <div style="width: 2rem; height: 2rem; border-radius: 6px; background: #ECE6FE; color: #5728B2; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <strong style="color: var(--color-text-primary);">Transparent Driver & Vehicle Details:</strong>
                <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin-top: 2px;">Driver photo, verified name, commercial plate number, and car model displayed prior to pickup.</p>
              </div>
            </div>

            <div style="display: flex; gap: var(--space-3); align-items: flex-start;">
              <div style="width: 2rem; height: 2rem; border-radius: 6px; background: #ECE6FE; color: #5728B2; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <strong style="color: var(--color-text-primary);">Privacy-Safe Calling:</strong>
                <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin-top: 2px;">In-app proxy calling ensures drivers and employees communicate without exposing personal phone numbers.</p>
              </div>
            </div>
          </div>
        </div>

        <div style="text-align: center;">
          <div style="max-width: 420px; margin: 0 auto; border-radius: 1.5rem; overflow: hidden; box-shadow: var(--shadow-xl); border: 2px solid var(--color-border);">
            <img
              src="/employee-app-illustration.jpg"
              alt="AdhocX Employee Mobile App Commuter Interface"
              width="500"
              height="600"
              style="width: 100%; height: auto; display: block;"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key App Modules Breakdown (PRD Aligned) -->
  <section id="app-features" class="section-padding" style="background: var(--color-surface-muted);">
    <div class="container">
      <div class="text-center" style="max-width: 800px; margin: 0 auto var(--space-12);">
        <span class="badge badge-warm" style="margin-bottom: var(--space-3);">Employee App Capabilities</span>
        <h2 style="font-size: 2.25rem; font-weight: 800; color: var(--color-text-primary); margin-bottom: var(--space-4);">
          Engineered for Corporate Safety, Predictability & Clarity
        </h2>
        <p style="color: var(--color-text-secondary); font-size: 1.05rem; line-height: 1.6;">
          Every module is mapped to enterprise transportation policies, giving employees full visibility while respecting privacy.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-8);">
        
        <!-- Module 1: Home Dashboard & Next Trip -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm);">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: #EFF6FF; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
            Home Dashboard & Next Trip
          </h3>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-4);">
            Clear view of your next approved shift pickup or logout drop with date, designated pickup waypoint, arrival countdown, and vehicle allocation state.
          </p>
          <div style="font-size: 0.8rem; color: var(--color-primary-600); font-weight: 600;">
            Real-time status: Scheduled &rarr; Assigned &rarr; Approaching &rarr; Boarded
          </div>
        </div>

        <!-- Module 2: Live Tracking & GPS Freshness -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm);">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: #EFF6FF; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
            Live Tracking & GPS Freshness
          </h3>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-4);">
            Live map showing cab position with an authentic GPS age indicator. Stale GPS is clearly marked rather than showing frozen coordinates.
          </p>
          <div style="font-size: 0.8rem; color: var(--color-primary-600); font-weight: 600;">
            Includes walking directions to designated pickup spot & arrival alerts
          </div>
        </div>

        <!-- Module 3: Dynamic OTP / QR Boarding -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm);">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
            Dynamic OTP / QR Boarding
          </h3>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-4);">
            Secure expiring OTP or QR challenge presented to the driver upon boarding. Guarantees that only authorized employees board the correct cab.
          </p>
          <div style="font-size: 0.8rem; color: #16A34A; font-weight: 600;">
            Automatic timestamped boarding verification & safe-reach logging
          </div>
        </div>

        <!-- Module 4: In-Transit Emergency SOS -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm);">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
            1-Tap Emergency SOS
          </h3>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-4);">
            Active during every in-progress trip. Instantly transmits live vehicle coordinates, trip identifiers, and employee details to our 24/7 command centre.
          </p>
          <div style="font-size: 0.8rem; color: #DC2626; font-weight: 600;">
            Immediate acknowledgement status & automated emergency escalation
          </div>
        </div>

        <!-- Module 5: Shift Calendar & Change Requests -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm);">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: #EFF6FF; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
            Shift Calendar & Policy Rescheduling
          </h3>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-4);">
            View upcoming weekly and monthly shift schedules. Submit cancellation or pickup location modification requests strictly within corporate policy cutoff windows.
          </p>
          <div style="font-size: 0.8rem; color: var(--color-primary-600); font-weight: 600;">
            Prevents manual duplicate requests & aligns with corporate HR approvals
          </div>
        </div>

        <!-- Module 6: Trip History & Feedback -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-8); box-shadow: var(--shadow-sm);">
          <div style="width: 3rem; height: 3rem; border-radius: 0.75rem; background: #EFF6FF; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center; margin-bottom: var(--space-4);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-2);">
            Trip History & Commuter Feedback
          </h3>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-4);">
            Review past commute logs, verify timestamps, and submit ratings on vehicle cleanliness, driver behavior, and route punctuality.
          </p>
          <div style="font-size: 0.8rem; color: var(--color-primary-600); font-weight: 600;">
            Empowers facility teams with actionable commuter satisfaction data
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Corporate Demo CTA Section -->
  <section class="section-padding" style="background: var(--color-surface);">
    <div class="container" style="max-width: 900px; margin: 0 auto;">
      <EnterpriseLeadForm client:load defaultPurpose="Enterprise Commute / ETS RFP Proposal" />
    </div>
  </section>
</BaseLayout>

