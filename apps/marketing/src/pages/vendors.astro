  <script is:inline>
    function initFleetTableAndCards() {
      // 1. Mobile Contrast View Mode Switcher (Cards vs Table)
      const btnContrastCards = document.getElementById('btnContrastCards');
      const btnContrastTable = document.getElementById('btnContrastTable');
      const contrastSection = document.querySelector('.operational-contrast-section');

      if (btnContrastCards && btnContrastTable && contrastSection) {
        btnContrastCards.addEventListener('click', () => {
          btnContrastCards.classList.add('active');
          btnContrastTable.classList.remove('active');
          contrastSection.classList.remove('show-table-mode');
        });

        btnContrastTable.addEventListener('click', () => {
          btnContrastTable.classList.add('active');
          btnContrastCards.classList.remove('active');
          contrastSection.classList.add('show-table-mode');
        });
      }

      // 2. Fleet View Mode Switcher (Matrix vs Cards)
      const btnFleetMatrix = document.getElementById('btnFleetMatrix');
      const btnFleetCards = document.getElementById('btnFleetCards');
      const fleetMatrixContainer = document.getElementById('fleetMatrixContainer');
      const fleetCardsContainer = document.getElementById('fleetCardsContainer');

      if (btnFleetMatrix && btnFleetCards && fleetMatrixContainer && fleetCardsContainer) {
        btnFleetMatrix.addEventListener('click', () => {
          btnFleetMatrix.classList.add('active');
          btnFleetCards.classList.remove('active');
          fleetMatrixContainer.style.display = 'block';
          fleetCardsContainer.style.display = 'none';
        });

        btnFleetCards.addEventListener('click', () => {
          btnFleetCards.classList.add('active');
          btnFleetMatrix.classList.remove('active');
          fleetMatrixContainer.style.display = 'none';
          fleetCardsContainer.style.display = 'block';
        });
      }

      // 3. Fleet Category Deep-Dive Pill Tabs
      const fleetTabs = document.querySelectorAll('.fleet-pill-tab');
      const specCards = document.querySelectorAll('.fleet-spec-card');

      fleetTabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab');
          fleetTabs.forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');

          specCards.forEach((card) => {
            if (card.id === `fleet-card-${target}`) {
              card.style.display = 'block';
              card.classList.add('active');
            } else {
              card.style.display = 'none';
              card.classList.remove('active');
            }
          });
        });
      });

      // 4. Quick Jump Buttons for horizontal scroll with focus feedback
      const jumpButtons = document.querySelectorAll('.table-jump-btn');
      jumpButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const containerId = btn.getAttribute('data-container');
          const offset = parseInt(btn.getAttribute('data-offset') || '0', 10);
          const container = document.getElementById(containerId);
          if (container) {
            container.scrollTo({ left: offset, behavior: 'smooth' });
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFleetTableAndCards);
    } else {
      initFleetTableAndCards();
    }
  </script>
