            <tr>
              <th class="col-th col-th-workflow" style="min-width: 200px; width: 220px;">
                <div class="th-main-title">Feature / Workflow</div>
                <div class="th-subtitle">Operational governance</div>
              </th>
              <th class="col-th col-th-whatsapp" style="min-width: 270px; width: 280px;">
