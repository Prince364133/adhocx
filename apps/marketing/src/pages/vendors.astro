---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnterpriseLeadForm from '../components/EnterpriseLeadForm';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AdhocX Enterprise Corporate Transport Solutions",
  "serviceType": "Commercial 4 & 7 Seater Fleet Logistics & Employee Mobility",
  "provider": {
    "@type": "Organization",
    "name": "AdhocX Technologies Private Limited",
    "url": "https://www.adhocx.com"
  },
  "areaServed": ["Telangana", "Hyderabad"],
  "description": "Automated B2B corporate 4 & 7 seater cab fulfillment marketplace across Telangana and regional tech corridors. Algorithmic dispatch, 15-minute search cutoff SLA, 1-hour bank refund guarantee, and single unified GST billing for enterprise transport desks."
};
---

<BaseLayout
  title="Corporate Fleet Solutions & B2B Cab Sourcing (4 & 7 Seater) — AdhocX"
  description="Automated enterprise corporate cab fulfillment for 4-seater and 7-seater yellow plate fleets across Telangana and regional tech corridors. Eliminate WhatsApp dispatch chaos with instant driver assignment, 15-minute SLA cutoffs, and 1-hour bank refund guarantee."
  canonical="https://www.adhocx.com/vendors"
  activeNav="vendors"
  jsonLd={jsonLd}
>
  <!-- Enterprise Hero -->
  <section class="hero-section" style="background: linear-gradient(180deg, var(--color-primary-50) 0%, #ffffff 100%);">
    <div class="container hero-grid">
      <div class="hero-content">
        <h1 class="display-title" style="color: var(--color-text-primary);">
          Never Drop a Fleet Requirement Again.
        </h1>
        <p class="body-large">
          Replace unorganized WhatsApp groups and fragmented vendors with AdhocX's automated B2B dispatch engine. Verified 4-seater and 7-seater yellow-board cabs across Hyderabad IT corridors (HITEC City, Gachibowli, Financial District, Madhapur) and regional hubs, backed by 15-minute cutoff SLAs.
        </p>
        <div class="hero-actions">
          <a href="#corporate-form" class="btn btn-primary btn-large">
            Book Corporate Demo →
          </a>
          <a href="#fleet-rates" class="btn btn-secondary btn-large">
            Explore 4 & 7 Seater Fleets
          </a>
        </div>
        <div class="hero-metrics metrics-4" style="border-top: 1px solid var(--color-border);">
          <div class="metric-item">
            <div class="metric-val" style="color: var(--color-primary-600);">99.4%</div>
            <div class="metric-lbl">On-Time SLA Delivery</div>
          </div>
          <div class="metric-item">
            <div class="metric-val" style="color: var(--color-primary-600);">&lt; 90 Sec</div>
            <div class="metric-lbl">Instant Auto-Dispatch</div>
          </div>
          <div class="metric-item">
            <div class="metric-val" style="color: var(--color-primary-600);">4 & 7 Seater</div>
            <div class="metric-lbl">Commercial Yellow-Plate</div>
          </div>
          <div class="metric-item">
            <div class="metric-val" style="color: var(--color-primary-600);">1 Hour</div>
            <div class="metric-lbl">Bank Refund SLA</div>
          </div>
        </div>
      </div>

      <!-- Lead Capture Form Island -->
      <div class="hero-card-wrapper" id="corporate-form" data-animate>
        <EnterpriseLeadForm client:load />
      </div>
    </div>
  </section>

  <!-- Pain vs Solution Comparison Section (Solutions Mega-Menu: Compare AdhocX) -->
  <section class="section-padding" id="compare" style="background: var(--color-surface-muted);">
    <div class="container">
      <div class="section-header" style="text-align: center;">
        <span class="badge badge-primary">Operational Contrast</span>
        <h2 class="h2-title">Why Enterprises Switch from WhatsApp Groups to AdhocX</h2>
        <p class="body-large" style="margin: 0 auto; max-width: 650px;">
          Traditional transport procurement is fragmented, unverified, and prone to last-minute vehicle dropouts. AdhocX digitizes every single step.
        </p>
      </div>

      <div class="contrast-table-wrapper" data-animate>
        <table class="contrast-table">
          <thead>
            <tr>
              <th class="col-feature">Feature / Workflow</th>
              <th class="col-traditional">
                <span class="th-badge-neg"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span> Traditional WhatsApp Groups
              </th>
              <th class="col-adhocx">
                <span class="th-badge-pos"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg></span> AdhocX Automated Platform
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="cell-feature">Driver Sourcing</td>
              <td class="cell-traditional">
                <span class="cell-icon-neg"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
                <span>Endless manual calls & unverified WhatsApp chats</span>
              </td>
              <td class="cell-adhocx">
                <span class="cell-icon-pos"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                <div>
                  <strong>Programmatic allocation:</strong> Algorithm matches verified drivers in &lt; 90s
                </div>
              </td>
            </tr>
            <tr>
              <td class="cell-feature">Pricing Transparency</td>
              <td class="cell-traditional">
                <span class="cell-icon-neg"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
                <span>Surge charges, hidden fees, manual price haggling</span>
              </td>
              <td class="cell-adhocx">
                <span class="cell-icon-pos"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                <div>
                  <strong>Fixed transparent contract rates:</strong> Standard per-trip pricing
                </div>
              </td>
            </tr>
            <tr>
              <td class="cell-feature">Commercial Compliance</td>
              <td class="cell-traditional">
                <span class="cell-icon-neg"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
                <span>Unchecked driver papers, risk of white-plate vehicles</span>
              </td>
              <td class="cell-adhocx">
                <span class="cell-icon-pos"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                <div>
                  <strong>100% Commercial Yellow-Plate:</strong> RC, fitness, insurance, and background checked
                </div>
              </td>
            </tr>
            <tr>
              <td class="cell-feature">Cancellation & Refunds</td>
              <td class="cell-traditional">
                <span class="cell-icon-neg"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
                <span>Days of arguing for refunds on dropped rides</span>
              </td>
              <td class="cell-adhocx">
                <span class="cell-icon-pos"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                <div>
                  <strong>1-Hour Direct Bank Refund SLA:</strong> Guaranteed 60-min banking refund
                </div>
              </td>
            </tr>
            <tr>
              <td class="cell-feature">Billing & GST</td>
              <td class="cell-traditional">
                <span class="cell-icon-neg"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
                <span>Scattered individual driver paper receipts</span>
              </td>
              <td class="cell-adhocx">
                <span class="cell-icon-pos"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                <div>
                  <strong>Single Monthly Tax Invoice:</strong> Full itemized trip audit trails
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Solutions by Role & Outcome (Solutions Mega-Menu Reference) -->
  <section class="section-padding" id="solutions" style="background: #FFFFFF;">
    <div class="container">
      <div class="section-header" style="text-align: center;">
        <span class="badge badge-primary">Tailored Operational Impact</span>
        <h2 class="h2-title">Built for Every Stakeholder in Corporate Transit</h2>
        <p class="body-large" style="margin: 0 auto; max-width: 700px;">
          Whether you manage employee shift rosters, audit vendor invoices, or oversee campus safety, AdhocX provides purpose-built workflows.
        </p>
      </div>

      <div class="stakeholders-row-grid">
        <!-- Role 1: HR & Mobility -->
        <div class="card stakeholder-mini-card" id="role-hr" style="border-top: 4px solid var(--color-primary-600);" data-animate>
          <div>
            <span class="badge badge-info" style="margin-bottom: 0.5rem; font-size: 0.6875rem; padding: 0.15rem 0.45rem;">BY ROLE</span>
            <h3 class="stakeholder-mini-title">HR & Mobility</h3>
            <p class="stakeholder-mini-desc">
              Shift rosters, safety compliance, SOS telemetry, and employee experience. Seamless nodal pickups across Hyderabad corridors with strict night escort compliance.
            </p>
          </div>
          <div class="stakeholder-mini-footer" style="color: var(--color-primary-700); display: flex; align-items: center; gap: 6px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>99.4% On-Time Satisfaction</span>
          </div>
        </div>

        <!-- Role 2: Transport Admin -->
        <div class="card stakeholder-mini-card" id="role-admin" style="border-top: 4px solid var(--color-primary-600);" data-animate>
          <div>
            <span class="badge badge-info" style="margin-bottom: 0.5rem; font-size: 0.6875rem; padding: 0.15rem 0.45rem;">BY ROLE</span>
            <h3 class="stakeholder-mini-title">Transport Admin</h3>
            <p class="stakeholder-mini-desc">
              One queue instead of an overflowing inbox. Replace 20+ chaotic WhatsApp groups with automated dispatch assigning verified yellow-plate cabs in &lt; 90s.
            </p>
          </div>
          <div class="stakeholder-mini-footer" style="color: var(--color-primary-700); display: flex; align-items: center; gap: 6px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>&lt; 90s Auto Assignment</span>
          </div>
        </div>

        <!-- Outcome 1: Finance & CFO -->
        <div class="card stakeholder-mini-card" id="outcome-cfo" style="border-top: 4px solid var(--color-accent-base);" data-animate>
          <div>
            <span class="badge badge-warning" style="margin-bottom: 0.5rem; font-size: 0.6875rem; padding: 0.15rem 0.45rem;">BY OUTCOME</span>
            <h3 class="stakeholder-mini-title">Finance & CFO</h3>
            <p class="stakeholder-mini-desc">
              Rate cards, three-way match, single monthly ERP sync. Transparent fixed trip rates, automated 1-hour refund processing, and full 100% GST input credit.
            </p>
          </div>
          <div class="stakeholder-mini-footer" style="color: var(--color-amber-700); display: flex; align-items: center; gap: 6px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>100% GST & ERP Sync</span>
          </div>
        </div>

        <!-- Outcome 2: Mid-Market Ops -->
        <div class="card stakeholder-mini-card" id="outcome-ops" style="border-top: 4px solid var(--color-accent-base);" data-animate>
          <div>
            <span class="badge badge-warning" style="margin-bottom: 0.5rem; font-size: 0.6875rem; padding: 0.15rem 0.45rem;">BY OUTCOME</span>
            <h3 class="stakeholder-mini-title">Mid-Market Ops</h3>
            <p class="stakeholder-mini-desc">
              Enterprise control without the dedicated team. Scale 5 to 500 cabs on demand without internal logistics coordinators. Flex fleet capacity as attendance shifts.
            </p>
          </div>
          <div class="stakeholder-mini-footer" style="color: var(--color-amber-700); display: flex; align-items: center; gap: 6px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Zero In-House Overhead</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Modules: Shift Drops & Unified Mobility (Platform Mega-Menu Reference) -->
  <section class="section-padding" style="background: var(--color-surface-muted);" id="shift-transit">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-primary">Core Modules</span>
        <h2 class="h2-title">Employee Transport Software (ETS) & Unified Sourcing</h2>
        <p class="body-large">Algorithmic routing, automated shift allocation, and real-time vehicle telemetry.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-8); align-items: center;">
        <div class="card" style="padding: var(--space-6); background: #FFFFFF; border: 1px solid var(--color-border);" data-animate>
          <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
            <div style="width: 2.25rem; height: 2.25rem; border-radius: 0.5rem; background: #EFF6FF; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
                <line x1="9" y1="3" x2="9" y2="18"></line>
                <line x1="15" y1="6" x2="15" y2="21"></line>
              </svg>
            </div>
            <h3 class="h3-title" style="font-size: 1.2rem;">Automated Shift Rostering & Routing</h3>
          </div>
          <p class="body-text" style="margin-bottom: var(--space-4);">
            Our dispatch engine ingests shift schedules directly from Darwinbox, Workday, or spreadsheets, automatically generating optimized cluster routes that group employees living along the same IT corridor.
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.875rem; color: var(--color-text-secondary); padding: 0;">
            <li style="display: flex; align-items: flex-start; gap: 8px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Dynamic pickup sequencing minimizing employee in-cab travel time</span>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 8px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>OTP-based boarding with geofenced arrival alerts</span>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 8px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Live vehicle speed, path tracking, and instant panic SOS alerts</span>
            </li>
          </ul>
        </div>

        <div class="card" id="unified" style="padding: var(--space-6); background: #FFFFFF; border: 1px solid var(--color-border);" data-animate>
          <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
            <div style="width: 2.25rem; height: 2.25rem; border-radius: 0.5rem; background: #EFF6FF; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
              </svg>
            </div>
            <h3 class="h3-title" style="font-size: 1.2rem;">Travel + Transport in One Platform</h3>
          </div>
          <p class="body-text" style="margin-bottom: var(--space-4);">
            Both daily employee shifts and ad-hoc executive spot cabs (airport transfers, client delegations, inter-campus visits) run on one policy engine, one GST invoice, and a single approval chain.
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.875rem; color: var(--color-text-secondary); padding: 0;">
            <li style="display: flex; align-items: flex-start; gap: 8px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Unified travel desk console for transport managers</span>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 8px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Automated departmental cost center tagging</span>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 8px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Guaranteed 15-minute search cutoff with 1-hour bank refund SLA</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Commercial Fleet Categories & Rates -->
  <section class="section-padding" id="fleet-rates" style="background: #FFFFFF;">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-primary">Commercial Fleet Portfolio</span>
        <h2 class="h2-title">4 & 7 Seater Dedicated Commercial Cabs</h2>
        <p class="body-large">Verified yellow-board fleets suited for every enterprise logistics and transit scenario.</p>
      </div>

      <div class="fleet-categories-grid">
        <div class="fleet-card" data-animate>
          <div class="fleet-icon-wrapper">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3 3 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>
            </svg>
          </div>
          <h3 class="h3-title">4-Seater Commercial Sedan</h3>
          <p class="body-text" style="margin: 0.5rem 0 1rem 0;">
            Maruti Dzire, Toyota Etios, Hyundai Aura. Optimal for daily employee shift drops, individual manager commutes, and spot cabs.
          </p>
          <div class="fleet-rate-tag">
            <span class="text-caption">Fixed Shift Rate</span>
            <span class="fleet-rate-val">₹480 <span style="font-size: 0.8rem; font-weight: 500; color: var(--color-text-muted);">/ avg trip</span></span>
          </div>
        </div>

        <div class="fleet-card" data-animate>
          <div class="fleet-icon-wrapper">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="10" width="18" height="7" rx="2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 10l2-5h10l2 5"/><line x1="12" y1="5" x2="12" y2="10"/>
            </svg>
          </div>
          <h3 class="h3-title">6 & 7 Seater Commercial MUV</h3>
          <p class="body-text" style="margin: 0.5rem 0 1rem 0;">
            Maruti Ertiga, XL6, Kia Carens. Ideal for multi-employee pooled routes, tech park shuttle clusters, and group airport drops.
          </p>
          <div class="fleet-rate-tag">
            <span class="text-caption">Fixed Shift Rate</span>
            <span class="fleet-rate-val">₹680 <span style="font-size: 0.8rem; font-weight: 500; color: var(--color-text-muted);">/ avg trip</span></span>
          </div>
        </div>

        <div class="fleet-card" data-animate>
          <div class="fleet-icon-wrapper">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-base)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h3 class="h3-title">7-Seater Executive MPV</h3>
          <p class="body-text" style="margin: 0.5rem 0 1rem 0;">
            Toyota Innova Crysta. Chauffeur-driven executive mobility for VIP airport transfers, executive client delegations, and corporate events.
          </p>
          <div class="fleet-rate-tag">
            <span class="text-caption">Fixed Executive Rate</span>
            <span class="fleet-rate-val">₹950 <span style="font-size: 0.8rem; font-weight: 500; color: var(--color-text-muted);">/ avg trip</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost Calculator & Spend Benchmark (Platform Mega-Menu: Cost Calculator) -->
  <section class="section-padding" id="calculator" style="background: var(--color-surface-muted);">
    <div class="container">
      <div class="section-header" style="text-align: center;">
        <span class="badge badge-primary">Mobility ROI Estimator</span>
        <h2 class="h2-title">Estimate Your Enterprise Transport Savings</h2>
        <p class="body-large" style="margin: 0 auto; max-width: 650px;">
          See how eliminating WhatsApp surge tariffs, reducing dropped rides, and claiming 100% GST input tax credit lowers your total monthly ground spend.
        </p>
      </div>

