---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { href: '/services', label: 'Employee transport services' },
  { href: '/ets', label: 'Employee transport software (ETS)' },
  { href: '/vendors', label: 'Corporate cab sourcing' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/blogs', label: 'Insights & reports' },
  { href: '/contact', label: 'Contact us' },
];
---

<BaseLayout
  title="Page Not Found | AdhocX"
  description="The page you were looking for does not exist or has moved. Browse AdhocX corporate employee transport services, software, pricing and guides."
  canonical="https://www.adhocx.com/404"
  noindex={true}
>
  <section class="section-padding">
    <div class="container" style="max-width: 720px; text-align: center; padding: 4rem 1rem;">
      <p style="font-weight: 700; color: var(--color-primary-600);">Error 404</p>
      <h1 class="h2-title">This page could not be found</h1>
      <p class="body-large" style="margin: 1rem 0 2rem;">
        The link may be broken or the page may have moved. Try one of these instead:
      </p>
      <ul style="list-style: none; padding: 0; display: grid; gap: 0.75rem;">
        {links.map((l) => (
          <li><a href={l.href} class="btn btn-outline">{l.label}</a></li>
        ))}
      </ul>
      <p style="margin-top: 2rem;"><a href="/">Back to home</a></p>
    </div>
  </section>
</BaseLayout>
