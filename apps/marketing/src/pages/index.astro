<script>
  // Interactive App Illustration Variant Toggle
  const appImg = document.getElementById('employee-app-main-img') as HTMLImageElement | null;
  const toggleBtns = document.querySelectorAll<HTMLButtonElement>('.app-toggle-btn');

  toggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const newSrc = btn.getAttribute('data-src');
      if (appImg && newSrc) {
        appImg.src = newSrc;
        toggleBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
      }
    });
  });

  // Interactive Stakeholder Tab Switcher
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.stakeholder-tab-btn');
  const tabPanels = document.querySelectorAll<HTMLElement>('.stakeholder-panel');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');

      // Update button active state & accessibility
      tabButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      // Update panel visibility
      tabPanels.forEach((panel) => {
        if (panel.id === targetId) {
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
        }
      });
    });
  });
</script>
