---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AdhocX Technologies Private Limited",
  "url": "https://www.adhocx.com",
  "logo": "https://www.adhocx.com/assets/logo.png",
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "support@adhocx.in",
    "telephone": "+91-8490834945",
    "contactType": "customer service",
    "areaServed": "IN"
  }
};
---

<BaseLayout
  title="AdhocX — B2B Commercial Ground Transport Operating System"
  description="AdhocX is the operating system for corporate ground transport. Companies book and control trips, rental operators run their business, and travel companies fulfil demand across India."
  canonical="https://www.adhocx.com/"
  jsonLd={jsonLd}
>
  <!-- =========================================================================
       SECTION 1: HERO SECTION (Reference: Screenshot 1)
       "Every corporate cab trip. One system from booking to billing."
       ========================================================================= -->
  <section class="adhocx-hero-section" id="hero">
    <div class="container adhocx-hero-grid">
      <!-- Left Hero Column: Copy & Actions -->
      <div class="hero-left-content">
        <!-- H1 Title -->
        <h1 class="adhocx-hero-h1">
          Every corporate cab trip. <span class="adhocx-hero-accent">One system from booking to billing.</span>
        </h1>

        <!-- Subtitle Description -->
        <p class="adhocx-hero-desc">
          AdhocX is the operating system for corporate ground transport. Companies book and control trips, rental operators run their business, and travel companies fulfil demand across India.
        </p>

        <!-- CTA Buttons -->
        <div class="adhocx-hero-actions">
          <a href="/vendors#corporate-form" class="btn-pill-primary" id="btn-hero-demo">
            <span>Book a demo</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/vendors" class="btn-pill-secondary" id="btn-hero-path">
            Choose your path
          </a>
        </div>

        <!-- 3 Value Checks -->
        <div class="adhocx-hero-checks">
          <div class="adhocx-check-item">
            <svg class="adhocx-check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span>Bookings in one place</span>
          </div>

          <div class="adhocx-check-item">
            <svg class="adhocx-check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span>Every trip tracked</span>
          </div>

          <div class="adhocx-check-item">
            <svg class="adhocx-check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span>Billing backed by trip records</span>
          </div>
        </div>
      </div>

      <!-- Right Hero Column: Interactive SaaS Mockup Canvas -->
      <div class="hero-mockup-wrapper">
        <div class="hero-blueprint-grid"></div>

        <!-- Overlaid Top Pill: New Booking -->
        <div class="hero-floating-booking">
          <div style="width: 2rem; height: 2rem; border-radius: 0.5rem; background: #EFF6FF; color: var(--color-primary-600); display: flex; align-items: center; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
            </svg>
          </div>
          <div>
            <div style="font-size: 0.6875rem; text-transform: uppercase; color: #64748B; font-weight: 700; letter-spacing: 0.05em;">NEW BOOKING</div>
            <div style="font-size: 0.875rem; font-weight: 700; color: #191B1C;">Airport transfer</div>
          </div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-600)" stroke-width="2.5" style="margin-left: 0.5rem;">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="16 12 12 8 8 12"></polyline>
          </svg>
        </div>

        <!-- Central Dashboard Frame -->
        <div class="hero-dashboard-window">
          <!-- Top Window Bar -->
          <div class="dashboard-topbar">
            <div class="dashboard-search-sim">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span style="color: #94A3B8;">Search bookings, cabs...</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.875rem;">
              <span class="dashboard-live-badge">
                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-success); display: inline-block;"></span>
                Live
              </span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
          </div>

          <!-- Body with mini sidebar & simulated booking console -->
          <div class="dashboard-body-split">
            <!-- Mini icon sidebar -->
            <div class="dashboard-sidebar-mini">
              <span class="active">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
              </span>
              <span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3 3 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
              </span>
              <span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="9" y2="22.01"></line><line x1="15" y1="22" x2="15" y2="22.01"></line><line x1="9" y1="6" x2="9" y2="6.01"></line><line x1="15" y1="6" x2="15" y2="6.01"></line><line x1="9" y1="10" x2="9" y2="10.01"></line><line x1="15" y1="10" x2="15" y2="10.01"></line><line x1="9" y1="14" x2="9" y2="14.01"></line><line x1="15" y1="14" x2="15" y2="14.01"></line></svg>
              </span>
              <span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
              </span>
              <span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
              </span>
            </div>

            <!-- Booking Console Interface -->
            <div class="dashboard-main-area">
              <div class="hero-booking-form-sim">
                <div class="hero-input-field">
                  <div style="font-size: 0.625rem; color: #64748B;">PICKUP</div>
                  <strong>RGIA Hyderabad Airport</strong>
                </div>
                <div class="hero-input-field">
                  <div style="font-size: 0.625rem; color: #64748B;">DROP</div>
                  <strong>HITEC City Tech Park</strong>
                </div>
              </div>

              <!-- Commercial Sedan Graphic Card -->
              <div class="hero-cab-visual">
                <div>
                  <div style="font-size: 0.8125rem; font-weight: 700; color: var(--color-text-primary);">Commercial Sedan (Dzire / Etios)</div>
                  <div style="font-size: 0.6875rem; color: #64748B;">100% Commercial Yellow-Plate • AC</div>
                </div>
                <!-- Sedan Car SVG -->
                <svg width="68" height="32" viewBox="0 0 68 32" fill="none">
                  <path d="M4 22L12 12H44L56 16L64 22V28H4V22Z" fill="#FFFFFF" stroke="#1167EE" stroke-width="2"/>
                  <circle cx="16" cy="28" r="4.5" fill="#191B1C"/>
                  <circle cx="50" cy="28" r="4.5" fill="#191B1C"/>
                  <line x1="26" y1="12" x2="26" y2="22" stroke="#91B9FB" stroke-width="1.5"/>
                  <line x1="38" y1="12" x2="38" y2="22" stroke="#91B9FB" stroke-width="1.5"/>
                </svg>
              </div>

              <!-- Auto-Dispatch Button Inside Simulated UI -->
              <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
                <div style="background: var(--color-primary-600); color: #FFFFFF; font-size: 0.75rem; font-weight: 700; padding: 0.45rem 1rem; border-radius: 0.375rem;">
                  Auto-Allot Cab
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Overlaid Dark Blue Floating Driver Card -->
        <div class="hero-floating-driver">
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.6875rem; opacity: 0.9; margin-bottom: 0.5rem;">
            <span>TRIP TS-2841</span>
            <span style="display: inline-flex; align-items: center; gap: 0.25rem;">
              <span style="width: 5px; height: 5px; border-radius: 50%; background: #4ADE80; display: inline-block;"></span>
              Live
            </span>
          </div>
          <div style="font-size: 0.9375rem; font-weight: 700; margin-bottom: 0.75rem;">Driver en route</div>
          <div style="font-size: 0.75rem; line-height: 1.5; margin-bottom: 0.75rem; border-left: 2px solid #5290F9; padding-left: 0.5rem;">
            <div><strong>Pickup:</strong> RGIA Hyderabad Airport</div>
            <div><strong>Drop:</strong> HITEC City Tech Hub</div>
          </div>
          <div style="display: flex; justify-content: flex-end;">
            <span style="background: rgba(255, 255, 255, 0.2); font-size: 0.6875rem; padding: 0.2rem 0.5rem; border-radius: var(--radius-pill); font-weight: 600;">
              Live tracking
            </span>
          </div>
        </div>

        <!-- Overlaid Billing Verified Pill -->
        <div class="hero-floating-billing">
          <span style="font-weight: 800; color: var(--color-primary-600); font-size: 0.875rem;">₹</span>
          <div>
            <div style="font-size: 0.625rem; color: #64748B; font-weight: 700;">BILLING</div>
            <div style="font-weight: 700; color: #191B1C;">Trip verified</div>
          </div>
        </div>

        <!-- Bottom Status Progression Pill -->
        <div class="hero-status-progression">
          <div class="prog-item">
            <span class="prog-lbl">BOOK</span>
            <span class="prog-val">Created</span>
          </div>
          <span style="color: #CBD5E1;">—</span>
          <div class="prog-item">
            <span class="prog-lbl">TRACK</span>
            <span class="prog-val" style="color: var(--color-primary-600);">Live</span>
          </div>
          <span style="color: #CBD5E1;">—</span>
          <div class="prog-item">
            <span class="prog-lbl">BILL</span>
            <span class="prog-val" style="color: var(--color-success);">Verified</span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 2: WHY ADHOCX (Reference: Screenshot 2)
       "The difference shows up from day one"
       ========================================================================= -->
  <section class="why-adhocx-section" id="why-adhocx">
    <div class="container">
      <!-- Badge -->
      <div class="why-badge">
        <span class="adhocx-hero-dot"></span>
        <span>Why AdhocX</span>
      </div>

      <!-- Section Title -->
      <h2 class="why-h2">
        The difference shows up <span class="highlight-day">from day one</span>
      </h2>

      <!-- Lead Description -->
      <p class="why-desc">
        AdhocX does not replace the relationships that make transport work. It makes every booking, trip and payment visible.
      </p>

      <!-- 3 Columns Comparison Grid with Top Blue Borders -->
      <div class="why-grid">
        <!-- Col 01 -->
        <div class="why-card">
          <div>
            <div class="why-card-num">01</div>
            <h3 class="why-card-title">Built for the corporate cab program — not retrofitted</h3>
            <p class="why-card-desc">
              Approvals, cost centres, GST e-invoicing, duty slips and HRMS sync are first-class — not bolted on top of a consumer ride app.
            </p>
          </div>
          <div class="why-compare-pill">
            <span class="dot"></span>
            <span>vs. consumer ride apps</span>
          </div>
        </div>

        <!-- Col 02 -->
        <div class="why-card">
          <div>
            <div class="why-card-num">02</div>
            <h3 class="why-card-title">Your vendors. Your SLAs. Our orchestration.</h3>
            <p class="why-card-desc">
              Keep the suppliers and rates you've already negotiated. AdhocX auto-allots, tracks SLA and consolidates billing across all of them.
            </p>
          </div>
          <div class="why-compare-pill">
            <span class="dot"></span>
            <span>vs. single-vendor lock-in</span>
          </div>
        </div>

        <!-- Col 03 -->
        <div class="why-card">
          <div>
            <div class="why-card-num">03</div>
            <h3 class="why-card-title">Audit-ready by default</h3>
            <p class="why-card-desc">
              Every invoice line is matched to GPS telemetry and a signed digital duty slip. Finance closes the month without reconciling spreadsheets.
            </p>
          </div>
          <div class="why-compare-pill">
            <span class="dot"></span>
            <span>vs. manual spreadsheet reconciliation</span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 3: GOVERNANCE & COMPLIANCE (Reference: Screenshot 3)
       Dark Midnight Navy Card: Policy enforced at booking, not reconciled at month-end.
       ========================================================================= -->
  <section class="governance-section" id="governance">
    <div class="container">
      <div class="governance-dark-container">
        <div class="governance-grid">
          <!-- Left Column: Copy & Link -->
          <div>
            <span class="gov-tag">GOVERNANCE & COMPLIANCE</span>
            <h2 class="gov-h2">
              Policy enforced at booking, not reconciled at month-end.
            </h2>
            <p class="gov-p">
              Out-of-policy fares, hotels and rides are blocked or routed for approval before a ticket is issued or a vehicle allocated. Every booking carries its cost centre, approver and GST details into your ERP.
            </p>
            <a href="/terms#compliance" class="gov-link">
              <span>Read the security & compliance brief</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Right Column: 2x2 Grid with Distinct Color Badges -->
          <div class="governance-tiles-grid">
            <!-- Tile 01: Green Badge -->
            <div class="gov-tile">
              <span class="gov-badge gov-badge-green">01</span>
              <h3 class="gov-tile-title">Pre-trip controls</h3>
              <p class="gov-tile-desc">
                Fare class, hotel caps, vehicle type and budget rules checked before booking.
              </p>
            </div>

            <!-- Tile 02: Sky Blue Badge -->
            <div class="gov-tile">
              <span class="gov-badge gov-badge-cyan">02</span>
              <h3 class="gov-tile-title">Safety compliance</h3>
              <p class="gov-tile-desc">
                Escort rules, driver vetting and night-shift protocols enforced automatically.
              </p>
            </div>

            <!-- Tile 03: Amber Gold Badge -->
            <div class="gov-tile">
              <span class="gov-badge gov-badge-amber">03</span>
              <h3 class="gov-tile-title">Audit trail</h3>
              <p class="gov-tile-desc">
                Every change, approval and cancellation timestamped and exportable.
              </p>
            </div>

            <!-- Tile 04: Purple Badge -->
            <div class="gov-tile">
              <span class="gov-badge gov-badge-purple">04</span>
              <h3 class="gov-tile-title">ERP sync</h3>
              <p class="gov-tile-desc">
                Cost centres, GST data and invoices flow into SAP, Oracle or Zoho.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 4: BUILT FOR EVERY STAKEHOLDER (Reference: Screenshot 4)
       Interactive 5-Tab Console: Everyone who touches a trip gets their own view.
       ========================================================================= -->
  <section class="stakeholders-section" id="stakeholders">
    <div class="container">
      <span class="stakeholder-tag">BUILT FOR EVERY STAKEHOLDER</span>
      <h2 class="stakeholder-h2">
        Everyone who touches a trip gets their own view.
      </h2>

      <!-- 5-Tab Navigation Pill Bar -->
      <div class="stakeholder-tabs-nav" role="tablist" aria-label="Stakeholder views">
        <button type="button" class="stakeholder-tab-btn active" data-tab="panel-hr" role="tab" aria-selected="true" id="tab-hr">
          HR & mobility
        </button>
        <button type="button" class="stakeholder-tab-btn" data-tab="panel-admin" role="tab" aria-selected="false" id="tab-admin">
          Travel & admin desk
        </button>
        <button type="button" class="stakeholder-tab-btn" data-tab="panel-finance" role="tab" aria-selected="false" id="tab-finance">
          Finance & CFO
        </button>
        <button type="button" class="stakeholder-tab-btn" data-tab="panel-vendors" role="tab" aria-selected="false" id="tab-vendors">
          Vendor partners
        </button>
        <button type="button" class="stakeholder-tab-btn" data-tab="panel-ops" role="tab" aria-selected="false" id="tab-ops">
          Mid-market ops
        </button>
      </div>

      <!-- Tab Panels Container -->
      <div class="stakeholder-panels-container">
        <!-- 1. HR & Mobility (Active in Screenshot 4) -->
        <div class="stakeholder-panel active" id="panel-hr" role="tabpanel" aria-labelledby="tab-hr">
          <div class="panel-info-side">
            <h3 class="panel-title">Employee transport without the spreadsheets.</h3>
            <p class="panel-desc">
              Rosters, shifts, shared routing and safety compliance run from one console across every city you operate in.
            </p>
            <div class="panel-bullets">
              <div class="panel-bullet-item">
                <span class="panel-marker-square"></span>
                <span>Shift rosters and route optimisation</span>
              </div>
              <div class="panel-bullet-item">
                <span class="panel-marker-square"></span>
                <span>Female-safety and escort compliance rules</span>
              </div>
              <div class="panel-bullet-item">
                <span class="panel-marker-square"></span>
                <span>Self-serve booking in the AdhocX app</span>
              </div>
            </div>
          </div>

          <!-- Right Console Card Mockup (Exact Screenshot 4 Details) -->
          <div class="console-card">
            <div class="console-card-title">Shift roster — Hyderabad • Night</div>
            
            <div class="console-metrics-grid">
              <div class="console-stat-box">
                <div class="stat-val">46</div>
                <div class="stat-lbl">On-duty vehicles</div>
              </div>
              <div class="console-stat-box">
                <div class="stat-val">312</div>
                <div class="stat-lbl">Employees routed</div>
              </div>
              <div class="console-stat-box">
                <div class="stat-val">38m</div>
                <div class="stat-lbl">Avg. ride time</div>
              </div>
              <div class="console-stat-box">
                <div class="stat-val text-green">100%</div>
                <div class="stat-lbl">Escort compliance</div>
              </div>
            </div>

            <div class="console-divider"></div>

            <div class="console-roster-list">
              <div class="console-roster-row">
                <div class="roster-left">
                  <span>HTC-04 · HITEC City</span>
                </div>
                <div class="roster-mid">
                  <span>21:30</span>
                  <span>6 / 6</span>
                  <span class="tag-dispatched">Dispatched</span>
                </div>
              </div>

              <div class="console-roster-row">
                <div class="roster-left">
                  <span>GCB-11 · Gachibowli</span>
                </div>
                <div class="roster-mid">
                  <span>22:00</span>
                  <span>5 / 6</span>
                  <span class="tag-boarding">Boarding</span>
                </div>
              </div>

              <div class="console-roster-row">
                <div class="roster-left">
                  <span>FIN-02 · Financial District</span>
                </div>
                <div class="roster-mid">
                  <span>22:00</span>
                  <span>4 / 6</span>
                  <span class="tag-escort">Escort assigned</span>
                </div>
