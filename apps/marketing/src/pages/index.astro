---
import BaseLayout from '../layouts/BaseLayout.astro';
import CorporateEstimator from '../components/CorporateEstimator';
import EnterpriseLeadForm from '../components/EnterpriseLeadForm';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "AdhocX Technologies Private Limited",
    "legalName": "Estemporaneo Technologies Private Limited",
    "url": "https://www.adhocx.com",
    "logo": "https://www.adhocx.com/adhocx-logo.png",
    "description": "Operating system for corporate ground transport. Companies book and control trips, rental operators run their business, and travel companies fulfil demand across India.",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@adhocx.com",
      "telephone": "+91-7893545818",
      "contactType": "customer service",
      "areaServed": "IN"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Corporate Ground Transport Operating System",
    "provider": {
      "@type": "Organization",
      "name": "AdhocX"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "Telangana, India"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Corporate Mobility Solutions",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Employee Transportation Services (ETS) Shift Rostering"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Executive Spot Cabs & RGIA Airport Mobility"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "100% Commercial Yellow-Plate Fleet Orchestration"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How does AdhocX guarantee 100% yellow-plate commercial cab compliance?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AdhocX enforces strict zero-tolerance policy against private white-plate vehicles. Every vehicle onboarded must submit valid commercial RTO registration, fitness certificate, commercial passenger insurance, and driver police verification before taking corporate trips."
        }
      },
      {
        "@type": "Question",
        "name": "How does AdhocX enforce night-shift female employee escort protocols?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In accordance with Telangana government labor regulations, our algorithm automatically pairs security escorts for female employees traveling between 8:00 PM and 6:00 AM, confirms first pickup/last drop safety protocols, and monitors rides through a 24/7 central emergency SOS desk."
        }
      },
      {
        "@type": "Question",
        "name": "Can our enterprise keep existing transport vendors and negotiated rate cards?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. AdhocX is vendor-neutral orchestration software. You retain your existing contracted fleet vendors and pre-negotiated rate cards. AdhocX provides the dispatch technology, live GPS telemetry, SLA tracking, and consolidated digital billing."
        }
      },
      {
        "@type": "Question",
        "name": "How does AdhocX eliminate manual duty slip reconciliation for finance teams?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Every ride generates an OTP-authenticated digital duty slip linked directly to the driver's real-time GPS telemetry, eliminating paper vouchers. Invoices match duty slips line-by-line and automatically export to SAP, Oracle, Zoho Books, or CSV."
        }
      },
      {
        "@type": "Question",
        "name": "Which vehicle categories are available for corporate commute and spot travel?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AdhocX supports commercial 4-seater sedans (Maruti Dzire, Toyota Etios), 6/7-seater MUVs (Maruti Ertiga, Kia Carens), and 7-seater executive vehicles (Toyota Innova Crysta), all carrying commercial yellow license plates."
        }
      }
    ]
  }
];
---

<BaseLayout
  title="AdhocX — B2B Commercial Ground Transport Operating System"
  description="AdhocX is the operating system for corporate ground transport. Companies book and control trips, rental operators run their business, and travel companies fulfil demand across India."
  canonical="https://www.adhocx.com/"
  jsonLd={jsonLd}
>
  <!-- =========================================================================
       SECTION 1: HERO SECTION
       "Every corporate cab trip. One system from booking to billing."
       ========================================================================= -->
  <section class="adhocx-hero-section" id="hero">
    <div class="container hero-container">
      <div class="adhocx-hero-grid">
        <!-- Left Hero Column: Copy, Value Checks & Actions -->
        <div class="hero-left-content">
          <!-- H1 Title (Completed in exactly 2 lines) -->
          <h1 class="adhocx-hero-h1">
            <span class="hero-h1-line">Every corporate cab trip.</span>
            <span class="hero-h1-line adhocx-hero-accent">One system from booking to billing.</span>
          </h1>

          <!-- Subtitle Description -->
          <p class="adhocx-hero-desc">
            AdhocX is the operating system for corporate ground transport. Companies book and control trips, rental operators run their business, and travel companies fulfil demand across India.
          </p>

          <!-- CTA Buttons -->
          <div class="adhocx-hero-actions">
            <a href="#corporate-rfp" class="btn-pill-primary" id="btn-hero-demo">
              <span>Book a demo</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="#estimator" class="btn-pill-secondary" id="btn-hero-estimator">
              Calculate Commute Sizing
            </a>
          </div>

          <!-- 4 Enterprise Value Checks -->
          <div class="adhocx-hero-checks">
            <div class="adhocx-check-item">
              <svg class="adhocx-check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>100% Commercial Yellow-Plate</span>
            </div>

            <div class="adhocx-check-item">
              <svg class="adhocx-check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>99.8% On-Time SLA Adherence</span>
            </div>

            <div class="adhocx-check-item">
              <svg class="adhocx-check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>100% Telemetry Duty Slips</span>
            </div>

            <div class="adhocx-check-item">
              <svg class="adhocx-check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>Zero Surge Pricing Guarantee</span>
            </div>
          </div>
        </div>

        <!-- Right Hero Column: Coordinated Product Console Showcase -->
        <div class="hero-showcase-column">
          <!-- Main Dashboard Hardware Frame -->
          <div class="hero-dashboard-window">
            <!-- Modern Browser Chrome Header -->
            <div class="dashboard-topbar">
              <div class="topbar-controls">
                <span class="control-dot dot-close"></span>
                <span class="control-dot dot-min"></span>
                <span class="control-dot dot-max"></span>
                <div class="topbar-url-pill">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  <span>portal.adhocx.com/overview</span>
                </div>
              </div>

              <div class="topbar-meta">
                <div class="showcase-status-indicator">
                  <span class="status-live-beacon"></span>
                  <span>Live Operations &bull; 142 Active Cabs</span>
                </div>
                <button type="button" class="dashboard-zoom-btn" id="btn-hero-zoom" aria-label="Expand console preview">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <polyline points="9 21 3 21 3 15"></polyline>
                    <line x1="21" y1="3" x2="14" y2="10"></line>
                    <line x1="3" y1="21" x2="10" y2="14"></line>
                  </svg>
                  <span>Expand</span>
                </button>
              </div>
            </div>

            <!-- Screenshot Display Wrap -->
            <div class="hero-dashboard-img-wrap" id="hero-img-wrap" title="Click to view full console in high resolution">
              <img 
                src="/images/corporate-dashboard.png" 
                alt="AdhocX Corporate Operations and Executive Commute Management Dashboard" 
                class="hero-dashboard-img"
                width="1024"
                height="479"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal for Dashboard Zoom -->
  <div class="dashboard-lightbox-modal" id="dashboard-lightbox" role="dialog" aria-modal="true" aria-label="Console Overview Large View">
    <div class="dashboard-lightbox-content">
      <button type="button" class="dashboard-lightbox-close" id="btn-close-lightbox" aria-label="Close modal">✕</button>
      <img src="/images/corporate-dashboard.png" alt="AdhocX Corporate Operations Console - Detailed View" class="dashboard-lightbox-img" />
    </div>
  </div>


  <!-- =========================================================================
       CORRIDOR TELEMETRY & TRUST METRICS STRIP
       High-visibility real-time coverage across Hyderabad tech clusters
       ========================================================================= -->
  <section class="telemetry-strip-section" aria-label="Telangana Operating Corridors & Real-Time SLAs">
    <div class="container telemetry-strip-grid">
      <!-- Corridor Tags -->
      <div class="telemetry-corridors-group">
        <span class="telemetry-strip-tag">
          <span style="width: 6px; height: 6px; border-radius: 50%; background: #EE9811; display: inline-block;"></span>
          Active Corridors
        </span>
        <span class="telemetry-corridor-pill">
          <span class="pill-dot"></span>
          HITEC City & Madhapur
        </span>
        <span class="telemetry-corridor-pill">
          <span class="pill-dot"></span>
          Gachibowli & Financial District
        </span>
        <span class="telemetry-corridor-pill">
          <span class="pill-dot"></span>
          Pocharam & Uppal Hub
        </span>
        <span class="telemetry-corridor-pill">
          <span class="pill-dot"></span>
          RGIA Shamshabad Transit
        </span>
      </div>

      <!-- Real-Time Metrics -->
      <div class="telemetry-metrics-group">
        <div class="telemetry-metric-item">
          <strong>99.8%</strong>
          <span>On-Time SLA</span>
        </div>
        <div class="telemetry-metric-item">
          <strong>&lt; 90s</strong>
          <span>Spot Allocation</span>
        </div>
        <div class="telemetry-metric-item">
          <strong style="color: #10B981;">100%</strong>
          <span>Escort Compliance</span>
        </div>
        <div class="telemetry-metric-item">
          <strong style="color: #F59E0B;">0%</strong>
          <span>Surge Pricing</span>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 2: WHY ADHOCX
       "The difference shows up from day one"
       ========================================================================= -->
  <section class="why-adhocx-section" id="why-adhocx">
    <div class="container">
      <!-- Badge -->
      <div class="why-badge">
        <span class="adhocx-hero-dot"></span>
        <span>Why AdhocX</span>
      </div>

      <!-- Section Title -->
      <h2 class="why-h2">
        The difference shows up <span class="highlight-day">from day one</span>
      </h2>

      <!-- Lead Description -->
      <p class="why-desc">
        AdhocX does not replace the relationships that make transport work. It makes every booking, trip and payment visible.
      </p>

      <!-- 3 Columns Comparison Grid with Top Accent Borders -->
      <div class="why-grid">
        <!-- Col 01 -->
        <div class="why-card">
          <div>
            <div class="why-card-num">01</div>
            <h3 class="why-card-title">Built for the corporate cab program — not retrofitted</h3>
            <p class="why-card-desc">
              Approvals, cost centres, GST e-invoicing, duty slips and HRMS sync are first-class — not bolted on top of a consumer ride app.
            </p>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; font-size: 0.8125rem; color: #475569;">
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span style="color: #16A34A; font-weight: 800;">✓</span>
                <span>Multi-level manager approvals by department and cost centre</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span style="color: #16A34A; font-weight: 800;">✓</span>
                <span>Direct HRMS roster sync for shifts and hybrid office schedules</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span style="color: #16A34A; font-weight: 800;">✓</span>
                <span>100% yellow-plate commercial cabs (zero private vehicle substitutions)</span>
              </div>
            </div>
          </div>
          <div class="why-compare-pill">
            <span class="dot"></span>
            <span>vs. consumer ride apps</span>
          </div>
        </div>

        <!-- Col 02 -->
        <div class="why-card">
          <div>
            <div class="why-card-num">02</div>
            <h3 class="why-card-title">Your vendors. Your SLAs. Our orchestration.</h3>
            <p class="why-card-desc">
              Keep the suppliers and rates you've already negotiated. AdhocX auto-allots, tracks SLA and consolidates billing across all of them.
            </p>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; font-size: 0.8125rem; color: #475569;">
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span style="color: #16A34A; font-weight: 800;">✓</span>
                <span>Retain your existing trusted vendors and locked commercial rate cards</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span style="color: #16A34A; font-weight: 800;">✓</span>
                <span>Performance-based auto-allocation prioritizing on-time drivers</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span style="color: #16A34A; font-weight: 800;">✓</span>
                <span>24/7 central emergency SOS desk with instant supervisor alert</span>
              </div>
            </div>
          </div>
          <div class="why-compare-pill">
            <span class="dot"></span>
            <span>vs. single-vendor lock-in</span>
          </div>
        </div>

        <!-- Col 03 -->
        <div class="why-card">
          <div>
            <div class="why-card-num">03</div>
            <h3 class="why-card-title">Audit-ready by default</h3>
            <p class="why-card-desc">
              Every invoice line is matched to GPS telemetry and a signed digital duty slip. Finance closes the month without reconciling spreadsheets.
            </p>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; font-size: 0.8125rem; color: #475569;">
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span style="color: #16A34A; font-weight: 800;">✓</span>
                <span>100% paperless digital duty slips with tamper-proof GPS geostamps</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span style="color: #16A34A; font-weight: 800;">✓</span>
                <span>Direct ERP integration into SAP, Oracle, Zoho Books, or CSV</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span style="color: #16A34A; font-weight: 800;">✓</span>
                <span>Elimination of ghost kilometers, manual billing disputes, and fraud</span>
              </div>
            </div>
          </div>
          <div class="why-compare-pill">
            <span class="dot"></span>
            <span>vs. manual spreadsheet reconciliation</span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 3: ENTERPRISE CONTRAST COMPARISON TABLE
       Traditional Broker vs AdhocX Corporate Operating System
       ========================================================================= -->
  <section class="contrast-section" style="padding: clamp(3.5rem, 6vw, 5.5rem) 0; background: #F8FAFC; border-bottom: 1px solid var(--color-border);" id="comparison">
    <div class="container">
      <div style="text-align: center; max-width: 44rem; margin: 0 auto 2.5rem;">
        <span style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary-600); margin-bottom: 0.75rem; display: inline-block;">
          SIDE-BY-SIDE EVALUATION
        </span>
        <h2 style="font-size: clamp(2rem, 3.8vw, 2.75rem); font-weight: 800; letter-spacing: -0.025em; color: var(--color-text-primary); line-height: 1.2; margin-bottom: 1rem;">
          Traditional transport brokers vs. AdhocX
        </h2>
        <p style="font-size: 1rem; color: var(--color-text-secondary); line-height: 1.6;">
          Why enterprise procurement, facility directors, and finance teams switch from fragmented manual operations to an audited operating system.
        </p>
      </div>

      <div class="contrast-table-wrapper">
        <table class="contrast-table" aria-label="Feature comparison between traditional brokers and AdhocX">
          <thead>
            <tr>
              <th class="col-feature">OPERATIONAL CRITERIA</th>
              <th class="col-traditional">
                <span class="th-badge-neg">✕</span> TRADITIONAL VENDOR / BROKER
              </th>
              <th class="col-adhocx">
                <span class="th-badge-pos">✓</span> ADHOCX CORPORATE OS
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="cell-feature">Fleet Verification</td>
              <td class="cell-traditional">
                <span class="cell-icon-neg">✕</span>
                Unvetted white-plate substitutions, unverified driver documents, and inconsistent vehicle maintenance.
              </td>
              <td class="cell-adhocx">
                <span class="cell-icon-pos">✓</span>
                <strong>100% Commercial Yellow-Plate Cabs</strong> (Dzire, Etios, Ertiga, Innova) with automated RTO and police verification.
              </td>
            </tr>
            <tr>
              <td class="cell-feature">Duty Slip Reconciliation</td>
              <td class="cell-traditional">
                <span class="cell-icon-neg">✕</span>
                Weeks of paper duty slips, illegible signatures, and manual spreadsheet auditing subject to human error.
              </td>
              <td class="cell-adhocx">
                <span class="cell-icon-pos">✓</span>
                <strong>100% Telemetry GPS-Backed Duty Slips</strong> with OTP pickup/drop geostamps, zero paperwork, and instant audit trails.
              </td>
            </tr>
            <tr>
              <td class="cell-feature">Pricing & Surge Predictability</td>
              <td class="cell-traditional">
                <span class="cell-icon-neg">✕</span>
                Unpredictable spot surge pricing during peak hours and rain, plus hidden toll and night-allowance markups.
              </td>
              <td class="cell-adhocx">
                <span class="cell-icon-pos">✓</span>
                <strong>Direct Contract-Locked Rates</strong> with a strict zero-surge guarantee, transparent toll reconciliation, and clear SLAs.
              </td>
            </tr>
            <tr>
              <td class="cell-feature">Night Shift Safety & Escorts</td>
              <td class="cell-traditional">
                <span class="cell-icon-neg">✕</span>
                Manual guard allocation, unverified first/last drop safety, and no centralized SOS panic response.
              </td>
              <td class="cell-adhocx">
                <span class="cell-icon-pos">✓</span>
                <strong>Automated Security Escort Allocation</strong> between 8 PM - 6 AM, automated safe-drop SMS verification, and 24/7 SOS desk.
              </td>
            </tr>
            <tr>
              <td class="cell-feature">Finance & ERP Integration</td>
              <td class="cell-traditional">
                <span class="cell-icon-neg">✕</span>
                Disputed invoices, delayed month-end books, and manual data re-entry into accounting software.
              </td>
              <td class="cell-adhocx">
                <span class="cell-icon-pos">✓</span>
                <strong>Direct API Sync into SAP, Oracle, Zoho & Workday</strong> with department cost-centre splitting and automated GST e-invoicing.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 4: GOVERNANCE & COMPLIANCE
       Dark Midnight Navy Card: Policy enforced at booking, not reconciled at month-end.
       ========================================================================= -->
  <section class="governance-section" id="governance">
    <div class="container">
      <div class="governance-dark-container">
        <div class="governance-grid">
          <!-- Left Column: Copy & Link -->
          <div>
            <span class="gov-tag">GOVERNANCE & COMPLIANCE</span>
            <h2 class="gov-h2">
              Policy enforced at booking, not reconciled at month-end.
            </h2>
            <p class="gov-p">
              Out-of-policy fares, hotels and rides are blocked or routed for approval before a ticket is issued or a vehicle allocated. Every booking carries its cost centre, approver and GST details into your ERP.
            </p>
            <a href="/terms#compliance" class="gov-link">
              <span>Read the security & compliance brief</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Right Column: 2x2 Grid with Distinct Color Badges -->
          <div class="governance-tiles-grid">
            <!-- Tile 01: Green Badge -->
            <div class="gov-tile">
              <span class="gov-badge gov-badge-green">01</span>
              <h3 class="gov-tile-title">Pre-trip controls</h3>
              <p class="gov-tile-desc">
                Fare class, hotel caps, vehicle type and budget rules checked before booking.
              </p>
            </div>

            <!-- Tile 02: Sky Blue Badge -->
            <div class="gov-tile">
              <span class="gov-badge gov-badge-cyan">02</span>
              <h3 class="gov-tile-title">Safety compliance</h3>
              <p class="gov-tile-desc">
                Escort rules, driver vetting and night-shift protocols enforced automatically.
              </p>
            </div>

            <!-- Tile 03: Amber Gold Badge -->
            <div class="gov-tile">
              <span class="gov-badge gov-badge-amber">03</span>
              <h3 class="gov-tile-title">Audit trail</h3>
              <p class="gov-tile-desc">
                Every change, approval and cancellation timestamped and exportable.
              </p>
            </div>

            <!-- Tile 04: Purple Badge -->
            <div class="gov-tile">
              <span class="gov-badge gov-badge-purple">04</span>
              <h3 class="gov-tile-title">ERP sync</h3>
              <p class="gov-tile-desc">
                Cost centres, GST data and invoices flow into SAP, Oracle or Zoho.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 5: CORPORATE COMMUTE ESTIMATOR (INTERACTIVE ISLAND)
       Real-Time Fleet Sizing & Shift Modeling Island
       ========================================================================= -->
  <section class="corporate-estimator-section" id="estimator">
    <div class="container">
      <div class="estimator-header">
        <span class="estimator-tag">CORPORATE COMMUTE SIZING</span>
        <h2 class="estimator-h2">
          Plan your enterprise fleet with precision.
        </h2>
        <p class="estimator-desc">
          Model your company's daily shift requirements, calculate vehicle mix, and estimate monthly administrative hours saved with AdhocX orchestration.
        </p>
      </div>

      <!-- React Interactive Sizing Island -->
      <CorporateEstimator client:visible />
    </div>
  </section>


  <!-- =========================================================================
       SECTION 6: BUILT FOR EVERY STAKEHOLDER
