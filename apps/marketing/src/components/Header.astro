---
interface Props {
  activeNav?: string;
  logoTag?: string;
}

const { activeNav = '', logoTag = '' } = Astro.props;
---

<header class="header-sticky" id="site-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" id="header-brand-logo" aria-label="AdhocX Corporate Homepage">
      <span class="logo-text">Adhoc<span class="logo-accent">X</span></span>
      {logoTag && <span class="logo-tag">{logoTag}</span>}
    </a>

    <!-- Primary Navigation Suite -->
    <ul class="nav-links" id="primary-nav-links">
      <!-- 1. Services -->
      <li>
        <a href="/services" class:list={["nav-link", { active: activeNav === 'services' }]} id="nav-services">
          Services
        </a>
      </li>

      <!-- 2. Mobile Apps (Dropdown) -->
      <li class="nav-item-dropdown" id="nav-dropdown-apps">
        <button type="button" class="nav-link" aria-expanded="false" aria-haspopup="true">
          <span>Mobile Apps</span>
          <svg class="caret-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.25a.75.75 0 01-1.06 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>

        <div class="mega-menu-panel" style="max-width: 580px; grid-template-columns: 1fr 1fr; gap: var(--space-6);">
          <div>
            <div class="mega-menu-col-title">Commuters</div>
            <div class="mega-menu-list">
              <a href="/employee-app" class="mega-menu-item">
                <div class="mega-menu-item-title">Employee Mobile App</div>
                <div class="mega-menu-item-desc">Rosters, live GPS vehicle tracking, OTP boarding, and 1-tap SOS</div>
              </a>
            </div>
          </div>

          <div>
            <div class="mega-menu-col-title">Commercial Fleet</div>
            <div class="mega-menu-list">
              <a href="/driver-app" class="mega-menu-item">
                <div class="mega-menu-item-title">Driver Mobile App</div>
                <div class="mega-menu-item-desc">Direct onboarding, advance shift offers, navigation, and bank settlements</div>
              </a>
            </div>
          </div>
        </div>
      </li>

      <!-- 3. Industries -->
      <li>
        <a href="/industries" class:list={["nav-link", { active: activeNav === 'industries' }]} id="nav-industries">
          Industries
        </a>
      </li>

      <!-- 4. Safety & Governance -->
      <li>
        <a href="/safety" class:list={["nav-link", { active: activeNav === 'safety' }]} id="nav-safety">
          Safety & SLAs
        </a>
      </li>

      <!-- 5. Commercial Framework & RFP -->
      <li>
        <a href="/pricing" class:list={["nav-link", { active: activeNav === 'pricing' }]} id="nav-pricing">
          Proposals & RFP
        </a>
      </li>

      <!-- 6. About Us -->
      <li>
        <a href="/about" class:list={["nav-link", { active: activeNav === 'about' }]} id="nav-about">
          About Us
        </a>
      </li>

      <!-- Mobile Only Action inside drawer -->
      <li class="mobile-only-action">
        <a href="/contact" class="btn btn-primary" style="width:100%;justify-content:center;">Request Proposal</a>
      </li>
    </ul>

    <!-- Header Right Actions -->
    <div class="header-actions">
      <a href="/contact" class="btn btn-primary nav-action-btn" id="btn-header-demo">
        Request Proposal &rarr;
      </a>
      <!-- Mobile Menu Toggle Button -->
      <button class="menu-toggle" id="menu-toggle-btn" aria-label="Toggle Navigation Menu" aria-expanded="false">
        <svg class="hamburger-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="close-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const navLinks = document.getElementById('primary-nav-links');
  const hamburger = toggleBtn?.querySelector('.hamburger-icon') as HTMLElement | null;
  const close = toggleBtn?.querySelector('.close-icon') as HTMLElement | null;
  const dropdownItems = document.querySelectorAll<HTMLElement>('.nav-item-dropdown');

  let activeCloseTimeout: ReturnType<typeof setTimeout> | null = null;

  function closeAllDropdowns() {
    if (activeCloseTimeout) {
      clearTimeout(activeCloseTimeout);
      activeCloseTimeout = null;
    }
    dropdownItems.forEach(item => {
      item.classList.remove('is-open');
      const btn = item.querySelector<HTMLButtonElement>('button.nav-link');
      if (btn) {
        btn.setAttribute('aria-expanded', 'false');
        btn.blur();
      }
    });
  }

  function openDropdown(targetItem: HTMLElement) {
    if (activeCloseTimeout) {
      clearTimeout(activeCloseTimeout);
      activeCloseTimeout = null;
    }
    dropdownItems.forEach(item => {
      const btn = item.querySelector<HTMLButtonElement>('button.nav-link');
      if (item === targetItem) {
        item.classList.add('is-open');
        if (btn) btn.setAttribute('aria-expanded', 'true');
      } else {
        item.classList.remove('is-open');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Setup dropdown interactions
  dropdownItems.forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>('button.nav-link');

    // Desktop hover behavior
    item.addEventListener('mouseenter', () => {
      if (window.innerWidth > 768) {
        openDropdown(item);
      }
    });

    item.addEventListener('mouseleave', () => {
      if (window.innerWidth > 768) {
        activeCloseTimeout = setTimeout(() => {
          item.classList.remove('is-open');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        }, 150);
      }
    });

    // Mobile / Click behavior
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = item.classList.contains('is-open');
      if (isOpen) {
        closeAllDropdowns();
      } else {
        openDropdown(item);
      }
    });
  });

  // Close dropdown on outside click or ESC key
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.nav-item-dropdown')) {
      closeAllDropdowns();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAllDropdowns();
      if (toggleBtn?.getAttribute('aria-expanded') === 'true') {
        toggleBtn.click();
      }
    }
  });

  // Mobile drawer toggle
  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    navLinks?.classList.toggle('is-open');

    if (hamburger && close) {
      hamburger.style.display = isExpanded ? 'block' : 'none';
      close.style.display = isExpanded ? 'none' : 'block';
    }
  });

  // Close drawer when clicking any link inside mobile navigation
  navLinks?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 768 && navLinks.classList.contains('is-open')) {
        navLinks.classList.remove('is-open');
        toggleBtn?.setAttribute('aria-expanded', 'false');
        if (hamburger && close) {
          hamburger.style.display = 'block';
          close.style.display = 'none';
        }
      }
    });
  });

  // Auto-close mobile drawer if viewport is expanded to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth > 768 && navLinks?.classList.contains('is-open')) {
      navLinks.classList.remove('is-open');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      if (hamburger && close) {
        hamburger.style.display = 'block';
        close.style.display = 'none';
      }
    }
  });

  // Header scroll shadow
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
  }, { passive: true });
</script>
