    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-links a:hover {
    color: #FFFFFF;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
