---
// AdhocX Corporate Enterprise Footer
---

<footer class="footer-enterprise-ref" id="site-footer">
  <div class="container">
    <div class="footer-ref-grid">
      <!-- Col 1: Brand, Tagline, & Legal Entity -->
      <div class="footer-ref-brand">
        <a href="/" class="brand-logo" id="footer-brand-logo" aria-label="AdhocX Corporate Homepage">
          <span class="logo-text" style="font-size: 1.75rem;">Adhoc<span class="logo-accent">X</span></span>
        </a>

        <p class="footer-brand-desc">
          Automated employee transportation services and corporate ground mobility for enterprises across Hyderabad and India.
        </p>

        <!-- Google Play Store Button -->
        <div class="app-download-badges">
          <a href="/driver-app" class="app-badge-btn" aria-label="Explore AdhocX Mobile Apps">
            <span class="app-badge-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M3.6 2.5a1.2 1.2 0 0 0-.6 1.1v16.8a1.2 1.2 0 0 0 .6 1.1l9.5-9.5L3.6 2.5z" fill="#00C1DE"/>
                <path d="M16.7 15.6l-3.6-3.6-9.5 9.5a1.1 1.1 0 0 0 1.4.1l11.7-6z" fill="#FF3A44"/>
                <path d="M16.7 8.4L5 2.4a1.1 1.1 0 0 0-1.4.1l9.5 9.5 3.6-3.6z" fill="#00E676"/>
                <path d="M20.8 10.7l-4.1-2.3-3.6 3.6 3.6 3.6 4.1-2.3c1.2-.7 1.2-1.9 0-2.6z" fill="#FFD000"/>
              </svg>
            </span>
            <span class="app-badge-text">
              <span class="app-badge-subtitle">GET IT ON</span>
              <span class="app-badge-title">Google Play</span>
            </span>
          </a>
        </div>
      </div>

      <!-- Col 2: Services & Mobility (Page Links Only) -->
      <div>
        <div class="footer-ref-col-title">SERVICES</div>
        <div class="footer-ref-links">
          <a href="/services">Corporate Ground Transport</a>
          <a href="/ets">Employee Transport (ETS)</a>
          <a href="/safety">Safety & Compliance</a>
          <a href="/pricing">Proposals & Rate Cards</a>
          <a href="/industries">Industries We Serve</a>
        </div>
      </div>

      <!-- Col 3: Mobile Apps & Fleet (Page Links Only) -->
      <div>
        <div class="footer-ref-col-title">MOBILE APPS</div>
        <div class="footer-ref-links">
          <a href="/employee-app">Employee Mobile App</a>
          <a href="/driver-app">Driver Partner App</a>
          <a href="/drivers">Driver Partner Network</a>
          <a href="/vendors">Vendor Partner Program</a>
        </div>
      </div>

      <!-- Col 4: Company & Support (Page Links Only) -->
      <div>
        <div class="footer-ref-col-title">COMPANY</div>
        <div class="footer-ref-links">
          <a href="/about">About Us</a>
          <a href="/faq">Corporate FAQ</a>
          <a href="/blogs">Industry Insights</a>
          <a href="/contact">Contact & Demo Request</a>
        </div>
      </div>

      <!-- Col 5: Governance & Legal (Page Links Only) -->
      <div>
        <div class="footer-ref-col-title">LEGAL & PRIVACY</div>
        <div class="footer-ref-links">
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
          <a href="/delete-account">Account & Data Removal</a>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="footer-bottom-bar">
      <div>
        &copy; 2026 Estemporaneo Technologies Private Limited (AdhocX). All rights reserved.
      </div>
      <div>
        Telangana (Hyderabad Operating Corridors: HITEC City, Gachibowli, Financial District, Madhapur, Pocharam)
      </div>
    </div>
  </div>
</footer>
