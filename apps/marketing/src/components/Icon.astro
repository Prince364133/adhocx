---
interface Props {
  name:
    | 'building'
    | 'car'
    | 'clock'
    | 'shield-check'
    | 'bank-note'
    | 'sparkles'
    | 'check'
    | 'check-circle'
    | 'x-circle'
    | 'arrow-right'
    | 'phone'
    | 'mail'
    | 'chevron-down'
    | 'map-pin'
    | 'users'
    | 'percent'
    | 'file-text'
    | 'download';
  size?: number;
  class?: string;
  color?: string;
}

const { name, size = 20, class: className = '', color = 'currentColor' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['adhocx-icon', `icon-${name}`, className]}
  aria-hidden="true"
  focusable="false"
>
  {name === 'building' && (
    <Fragment>
      <rect x="4" y="2" width="16" height="20" rx="2" ry="2" />
      <path d="M9 22v-4h6v4" />
      <path d="M8 6h.01" />
      <path d="M16 6h.01" />
      <path d="M8 10h.01" />
      <path d="M16 10h.01" />
      <path d="M8 14h.01" />
      <path d="M16 14h.01" />
    </Fragment>
  )}

  {name === 'car' && (
    <Fragment>
      <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.9c-.7.3-1.1 1-1.1 1.8v3.4c0 .6.4 1 1 1h2" />
      <circle cx="7" cy="17" r="2" />
      <path d="M9 17h6" />
      <circle cx="17" cy="17" r="2" />
    </Fragment>
  )}

  {name === 'clock' && (
    <Fragment>
      <circle cx="12" cy="12" r="10" />
      <polyline points="12 6 12 12 16 14" />
    </Fragment>
  )}

  {name === 'shield-check' && (
    <Fragment>
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      <path d="m9 12 2 2 4-4" />
    </Fragment>
  )}

  {name === 'bank-note' && (
    <Fragment>
      <rect width="20" height="12" x="2" y="6" rx="2" />
      <circle cx="12" cy="12" r="2" />
      <path d="M6 12h.01M18 12h.01" />
    </Fragment>
  )}

  {name === 'sparkles' && (
    <Fragment>
      <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z" />
    </Fragment>
  )}

  {name === 'check' && (
    <Fragment>
      <polyline points="20 6 9 17 4 12" />
    </Fragment>
  )}

  {name === 'check-circle' && (
    <Fragment>
      <circle cx="12" cy="12" r="10" />
      <path d="m9 12 2 2 4-4" />
    </Fragment>
  )}

  {name === 'x-circle' && (
    <Fragment>
      <circle cx="12" cy="12" r="10" />
      <line x1="15" y1="9" x2="9" y2="15" />
      <line x1="9" y1="9" x2="15" y2="15" />
    </Fragment>
  )}

  {name === 'arrow-right' && (
    <Fragment>
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </Fragment>
  )}

  {name === 'phone' && (
    <Fragment>
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
    </Fragment>
  )}

  {name === 'mail' && (
    <Fragment>
      <rect width="20" height="16" x="2" y="4" rx="2" />
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
    </Fragment>
  )}

  {name === 'chevron-down' && (
    <Fragment>
      <polyline points="6 9 12 15 18 9" />
    </Fragment>
  )}

  {name === 'map-pin' && (
    <Fragment>
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
      <circle cx="12" cy="10" r="3" />
    </Fragment>
  )}

  {name === 'users' && (
    <Fragment>
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
    </Fragment>
  )}

  {name === 'percent' && (
    <Fragment>
      <line x1="19" y1="5" x2="5" y2="19" />
      <circle cx="6.5" cy="6.5" r="2.5" />
      <circle cx="17.5" cy="17.5" r="2.5" />
    </Fragment>
  )}

  {name === 'file-text' && (
    <Fragment>
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
      <polyline points="14 2 14 8 20 8" />
      <line x1="16" y1="13" x2="8" y2="13" />
      <line x1="16" y1="17" x2="8" y2="17" />
      <line x1="10" y1="9" x2="8" y2="9" />
    </Fragment>
  )}

  {name === 'download' && (
    <Fragment>
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <polyline points="7 10 12 15 17 10" />
      <line x1="12" y1="15" x2="12" y2="3" />
    </Fragment>
  )}
</svg>
