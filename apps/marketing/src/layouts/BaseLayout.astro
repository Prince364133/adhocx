---
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import CorporateAiAssistant from '../components/CorporateAiAssistant';
import '../styles/global.css';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  activeNav?: string;
  logoTag?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogType = 'website',
  ogImage,
  ogImageAlt,
  activeNav,
  logoTag,
  jsonLd,
  noindex = false,
  breadcrumbs,
} = Astro.props;

// Global Organization & Hyderabad LocalBusiness Schema
const defaultOrganizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.adhocx.com/#organization",
      "name": "AdhocX",
      "legalName": "Estemporaneo Technologies Private Limited",
      "url": "https://www.adhocx.com",
      "logo": "https://www.adhocx.com/adhocx-logo.png",
      "foundingDate": "2024",
      "description": "Enterprise employee transportation services and B2B corporate mobility platform in Hyderabad. Connecting corporate transport desks directly with verified commercial 4 & 7 seater yellow-plate drivers.",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-7893545818",
        "contactType": "customer service",
        "email": "support@adhocx.com",
        "areaServed": "IN",
        "availableLanguage": ["English", "Hindi", "Telugu"]
      },
      "sameAs": [
        "https://www.linkedin.com/company/adhocx",
        "https://twitter.com/AdhocX"
      ]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://www.adhocx.com/#localbusiness",
      "name": "AdhocX Hyderabad Corporate Fleet Operations",
      "image": "https://www.adhocx.com/adhocx-logo.png",
      "url": "https://www.adhocx.com",
      "telephone": "+91-7893545818",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "HITEC City & Financial District",
        "addressLocality": "Hyderabad",
        "addressRegion": "Telangana",
        "postalCode": "500081",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 17.4486,
        "longitude": 78.3741
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday"
        ],
        "opens": "00:00",
        "closes": "23:59"
      }
    },
    ...(breadcrumbs && breadcrumbs.length > 0 ? [{
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbs.map((bc, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": bc.name,
        "item": bc.url.startsWith('http') ? bc.url : `https://www.adhocx.com${bc.url}`
      }))
    }] : [])
  ]
};

const combinedJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? [defaultOrganizationSchema, ...jsonLd]
    : [defaultOrganizationSchema, jsonLd]
  : defaultOrganizationSchema;
---

<!DOCTYPE html>
<html lang="en-IN">
<head>
  <SeoHead
    title={title}
    description={description}
    canonical={canonical}
    ogTitle={ogTitle}
    ogDescription={ogDescription}
    ogType={ogType}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    noindex={noindex}
  />
  <script type="application/ld+json" set:html={JSON.stringify(combinedJsonLd)} />
</head>
<body>
  <a href="#main-content" class="skip-to-content">Skip to main content</a>
  <Header activeNav={activeNav} logoTag={logoTag} />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <CorporateAiAssistant client:load />

  <script>
    // Intersection Observer for scroll animations
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('[data-animate]').forEach((el) => {
      observer.observe(el);
    });

    // Apply consistent brand typography and appearance to 'AdhocX' across all pages
    const brandRegex = /\bAdhocX\b/g;
    const walker = document.createTreeWalker(
      document.body,
      NodeFilter.SHOW_TEXT,
      {
        acceptNode: (node) => {
          if (!node.parentElement) return NodeFilter.FILTER_REJECT;
          const tag = node.parentElement.tagName;
          if (['SCRIPT', 'STYLE', 'SVG', 'NOSCRIPT', 'TEXTAREA', 'INPUT', 'TITLE'].includes(tag)) {
            return NodeFilter.FILTER_REJECT;
          }
          if (node.parentElement.closest('.brand-logo, .brand-inline, .logo-text')) {
            return NodeFilter.FILTER_REJECT;
          }
          return brandRegex.test(node.nodeValue || '') ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
        }
      }
    );

    const nodesToReplace: Node[] = [];
    while (walker.nextNode()) {
      nodesToReplace.push(walker.currentNode);
    }

    nodesToReplace.forEach((node) => {
      const parent = node.parentNode;
      if (!parent || !node.nodeValue) return;
      const frag = document.createDocumentFragment();
      const parts = node.nodeValue.split('AdhocX');
      parts.forEach((part, i) => {
        if (part) frag.appendChild(document.createTextNode(part));
        if (i < parts.length - 1) {
          const span = document.createElement('span');
          span.className = 'brand-inline';
          span.innerHTML = 'Adhoc<span class="brand-accent">X</span>';
          frag.appendChild(span);
        }
      });
      parent.replaceChild(frag, node);
    });
  </script>
</body>
</html>
