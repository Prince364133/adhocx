{
  "name": "@adhocx/employee-app",
  "version": "1.0.0",
  "private": true,
  "description": "AdhocX Flutter Mobile Client (Corporate Employee Commuter)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:hot": "node scripts/dev.js --hot",
    "dev:chrome": "node scripts/dev.js --chrome",
    "dev:web": "node scripts/dev.js",
    "emulator": "node scripts/emulator.js",
    "dev:android": "node scripts/dev.js --android",
    "dev:ios": "flutter run -d ios",
    "build:web": "flutter build web",
    "build:apk": "flutter build apk --release",
    "build:appbundle": "flutter build appbundle --release",
    "build:ios": "flutter build ios --release --no-codesign",
    "test": "node -e \"console.log('Employee app test ready (run flutter test with Flutter installed)');\""
  }
}
