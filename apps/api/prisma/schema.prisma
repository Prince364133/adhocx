  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  // wire/billing-payouts: versioning + commercial terms. A version is never edited once used;
  // a new version closes the previous one's effectiveTo.
  version            Int       @default(1)
  perHourPaise       BigInt?   @map("per_hour_paise")
  minimumPaise       BigInt    @default(0) @map("minimum_paise")
  noShowPaise        BigInt    @default(0) @map("no_show_paise")
