  amountPaise       BigInt?  @map("amount_paise")
  providerReference String?  @map("provider_reference") @db.VarChar(128)
  /// APPLIED | NOOP_SAME_STATE | ILLEGAL_TRANSITION | AMOUNT_MISMATCH | UNMATCHED
  outcome           String   @db.VarChar(32)
  occurredAt        DateTime @map("occurred_at")
  receivedAt        DateTime @default(now()) @map("received_at")
  payload           Json     @default("{}")

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@index([payoutId, occurredAt])
  @@map("corporate_payout_provider_events")
}

enum CorporateInvoiceDisputeStatus {
