datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  VENDOR
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DriverAvailability {
  OFFLINE
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum VehicleType {
  SEDAN
  SUV
  HATCHBACK
  TEMPO_TRAVELLER
  BUS
  TATA_ACE
  PICKUP_TRUCK
}

enum FulfillmentMode {
  DIRECT_DISPATCH
  BIDDING
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum RequirementStatus {
  DRAFT
  POSTED
  DISPATCHING
  PARTIALLY_FULFILLED
  FULFILLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVER_AVAILABLE
}

enum OfferStatus {
  CREATED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TripStatus {
  ASSIGNED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
  CANCELLED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  phone     String     @unique
  email        String?    @unique
  passwordHash String?    @map("password_hash")
  fullName     String?    @map("full_name")
  role      UserRole   @default(DRIVER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  vendor          Vendor?
  driver          Driver?
  auditLogs       AuditLog[]
  reviewsWritten  Review[]   @relation("ReviewsWritten")
  reviewsReceived Review[]   @relation("ReviewsReceived")
  filedDisputes   Dispute[]  @relation("ReporterDisputes")
  accusedDisputes Dispute[]  @relation("AccusedDisputes")

  @@map("users")
}

model Vendor {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  organizationName   String             @map("organization_name")
  fullName           String             @map("full_name")
  phone              String
  gstNumber          String?            @map("gst_number")
  address            String?
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  escrowBalance      Decimal            @default(0.00) @map("escrow_balance") @db.Decimal(12, 2)
  approvedAt         DateTime?          @map("approved_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  trips        Trip[]
  payments     Payment[]

  @@map("vendors")
}

model Driver {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  fullName           String             @map("full_name")
  phone              String             @unique
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  availabilityStatus DriverAvailability @default(OFFLINE) @map("availability_status")
  vehicleType        VehicleType?       @map("vehicle_type")
  vehicleModel       String?            @map("vehicle_model")
  vehiclePlate       String?            @map("vehicle_plate")
  walletBalance      Decimal            @default(0.00) @map("wallet_balance") @db.Decimal(12, 2)
  trustScore         Float              @default(100.0) @map("trust_score")
  averageRating      Float              @default(5.0) @map("average_rating")
  ratingCount        Int                @default(0) @map("rating_count")
  totalTrips         Int                @default(0) @map("total_trips")
  currentLat         Decimal?           @map("current_lat") @db.Decimal(10, 7)
  currentLng         Decimal?           @map("current_lng") @db.Decimal(10, 7)
  lastLocationAt     DateTime?          @map("last_location_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles        Vehicle[]
  offers          Offer[]
  bids            Bid[]
  assignments     Assignment[]
  trips           Trip[]
  settlements     Settlement[]
  reviewsReceived Review[]      @relation("DriverReviewsReceived")

  @@map("drivers")
}

model Vehicle {
  id                 String             @id @default(uuid()) @db.Uuid
  driverId           String             @map("driver_id") @db.Uuid
  vehicleType        VehicleType        @map("vehicle_type")
  make               String?
  model              String
  registrationNumber String             @unique @map("registration_number")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rcNumber           String?            @map("rc_number")
  insuranceExpiry    DateTime?          @map("insurance_expiry")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  driver      Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  trips       Trip[]

  @@map("vehicles")
}

model Requirement {
  id               String            @id @default(uuid()) @db.Uuid
  vendorId         String            @map("vendor_id") @db.Uuid
  fulfillmentMode  FulfillmentMode   @default(DIRECT_DISPATCH) @map("fulfillment_mode")
  vehicleType      VehicleType       @map("vehicle_type")
  quantity         Int               @default(1)
  assignedQuantity Int               @default(0) @map("assigned_quantity")
  pickupLat        Decimal           @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng        Decimal           @map("pickup_lng") @db.Decimal(10, 7)
  pickupAddress    String            @map("pickup_address")
  dropLat          Decimal           @map("drop_lat") @db.Decimal(10, 7)
  dropLng          Decimal           @map("drop_lng") @db.Decimal(10, 7)
  dropAddress      String            @map("drop_address")
  reportingTime    DateTime          @map("reporting_time")
  ratePerVehicle   Decimal?          @map("rate_per_vehicle") @db.Decimal(10, 2)
  suggestedBudget  Decimal?          @map("suggested_budget") @db.Decimal(10, 2)
  totalAmount      Decimal           @map("total_amount") @db.Decimal(12, 2)
  status           RequirementStatus @default(POSTED)
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  vendor      Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  offers      Offer[]
  bids        Bid[]
  assignments Assignment[]
  trips       Trip[]
  payments    Payment[]

  @@map("requirements")
}

model Offer {
  id            String      @id @default(uuid()) @db.Uuid
  requirementId String      @map("requirement_id") @db.Uuid
  driverId      String      @map("driver_id") @db.Uuid
  vehicleType   VehicleType @map("vehicle_type")
  offeredRate   Decimal     @map("offered_rate") @db.Decimal(10, 2)
  status        OfferStatus @default(SENT)
  expiresAt     DateTime    @map("expires_at")
  respondedAt   DateTime?   @map("responded_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignment  Assignment?

  @@map("offers")
}

model Bid {
  id            String    @id @default(uuid()) @db.Uuid
  requirementId String    @map("requirement_id") @db.Uuid
  driverId      String    @map("driver_id") @db.Uuid
  bidAmount     Decimal   @map("bid_amount") @db.Decimal(10, 2)
  etaMinutes    Int?      @map("eta_minutes")
  notes         String?
  status        BidStatus @default(PENDING)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignment  Assignment?

  @@index([requirementId, status])
  @@index([driverId, status])
  @@index([createdAt])
  @@map("bids")
}

model Assignment {
  id            String           @id @default(uuid()) @db.Uuid
  requirementId String           @map("requirement_id") @db.Uuid
  offerId       String?          @unique @map("offer_id") @db.Uuid
  bidId         String?          @unique @map("bid_id") @db.Uuid
  driverId      String           @map("driver_id") @db.Uuid
  vehicleId     String?          @map("vehicle_id") @db.Uuid
  status        AssignmentStatus @default(CONFIRMED)
  assignedAt    DateTime         @default(now()) @map("assigned_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  offer       Offer?      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  bid         Bid?        @relation(fields: [bidId], references: [id], onDelete: Cascade)
  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trip        Trip?

  @@map("assignments")
}

model Trip {
  id                  String      @id @default(uuid()) @db.Uuid
  requirementId       String      @map("requirement_id") @db.Uuid
  assignmentId        String      @unique @map("assignment_id") @db.Uuid
  vendorId            String      @map("vendor_id") @db.Uuid
  driverId            String      @map("driver_id") @db.Uuid
  vehicleId           String?     @map("vehicle_id") @db.Uuid
  vehicleType         VehicleType @map("vehicle_type")
  pickupAddress       String      @map("pickup_address")
  dropAddress         String      @map("drop_address")
  reportingTime       DateTime    @map("reporting_time")
  startedAt           DateTime?   @map("started_at")
  completedAt         DateTime?   @map("completed_at")
  cancelledAt         DateTime?   @map("cancelled_at")
  status              TripStatus  @default(ASSIGNED)
  otp                 String      @default("1234")
  driverRate          Decimal     @map("driver_rate") @db.Decimal(10, 2)
  tollCharges         Decimal     @default(0.00) @map("toll_charges") @db.Decimal(10, 2)
  parkingCharges      Decimal     @default(0.00) @map("parking_charges") @db.Decimal(10, 2)
  totalDriverEarnings Decimal     @default(0.00) @map("total_driver_earnings") @db.Decimal(10, 2)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  assignment  Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  events      TripEvent[]
  reviews     Review[]
  disputes    Dispute[]

  @@map("trips")
}

model TripEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  eventType String   @map("event_type")
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_events")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String   @map("trip_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  driverId   String?  @map("driver_id") @db.Uuid
  rating     Int
  feedback   String?
  createdAt  DateTime @default(now()) @map("created_at")

  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  driver   Driver? @relation("DriverReviewsReceived", fields: [driverId], references: [id], onDelete: SetNull)

  @@unique([tripId, reviewerId])
  @@map("reviews")
}

model Dispute {
  id             String        @id @default(uuid()) @db.Uuid
  tripId         String        @map("trip_id") @db.Uuid
  reporterId     String        @map("reporter_id") @db.Uuid
  accusedId      String        @map("accused_id") @db.Uuid
  reason         String
  description    String?
  status         DisputeStatus @default(OPEN)
  resolutionText String?       @map("resolution_text")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reporter User @relation("ReporterDisputes", fields: [reporterId], references: [id], onDelete: Cascade)
  accused  User @relation("AccusedDisputes", fields: [accusedId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
  @@index([reporterId])
  @@index([status])
  @@map("disputes")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  requirementId  String        @map("requirement_id") @db.Uuid
  vendorId       String        @map("vendor_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?       @map("payment_method")
  transactionRef String?       @map("transaction_ref")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  accountType   String          @map("account_type")
  accountId     String          @map("account_id") @db.Uuid
  entryType     LedgerEntryType @map("entry_type")
  amount        Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(12, 2)
  referenceType String          @map("reference_type")
  referenceId   String          @map("reference_id") @db.Uuid
  description   String
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("ledger_entries")
}

model Settlement {
  id                String           @id @default(uuid()) @db.Uuid
  driverId          String           @map("driver_id") @db.Uuid
  amount            Decimal          @db.Decimal(12, 2)
  status            SettlementStatus @default(PENDING)
  bankAccountName   String?          @map("bank_account_name")
  bankAccountNumber String?          @map("bank_account_number")
  bankIfsc          String?          @map("bank_ifsc")
  transactionRef    String?          @map("transaction_ref")
  processedAt       DateTime?        @map("processed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("settlements")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  entityName String   @map("entity_name")
  entityId   String?  @map("entity_id") @db.Uuid
  payload    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id             String      @id @default(uuid()) @db.Uuid
  title          String
  slug           String      @unique
  excerpt        String      @db.Text
  content        String      @db.Text
  category       String
  tags           String[]    @default([])
  coverImage     String?     @map("cover_image")
  authorName     String      @default("AdhocX Team") @map("author_name")
  authorRole     String?     @default("Fleet Operations & Mobility Research") @map("author_role")
  status         BlogStatus  @default(DRAFT)
  views          Int         @default(0)
  readTime       String      @default("5 min read") @map("read_time")
  seoTitle       String?     @map("seo_title")
  seoDescription String?     @map("seo_description") @db.Text
  seoKeywords    String?     @map("seo_keywords")
  publishedAt    DateTime?   @map("published_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status, publishedAt])
  @@index([category])
  @@map("blog_posts")
}

