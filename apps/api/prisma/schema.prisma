model CorporateRateCard {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  vehicleCategory    String    @default("SEDAN") @map("vehicle_category") @db.VarChar(16)
  baseFarePaise      BigInt    @map("base_fare_paise")
  baseDistanceMeters Int       @default(10000) @map("base_distance_meters")
  perKmPaise         BigInt    @map("per_km_paise")
  perExtraStopPaise  BigInt    @default(0) @map("per_extra_stop_paise")
