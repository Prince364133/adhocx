  batch      CorporatePayoutBatch @relation(fields: [batchId], references: [id])
  driver     Driver               @relation(fields: [driverId], references: [id])
  reversalOf CorporatePayout?     @relation("CorporatePayoutReversal", fields: [reversalOfId], references: [id])
  reversal   CorporatePayout?     @relation("CorporatePayoutReversal")

  @@unique([batchId, driverId, kind])
  @@index([driverId, status])
  @@index([status, updatedAt])
  @@index([providerPayoutId])
  @@map("corporate_payouts")
}

/// Append-only log of signed provider callbacks. (provider, eventId) unique => replays are ignored.
model CorporatePayoutProviderEvent {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String   @db.VarChar(32)
  eventId           String   @map("event_id") @db.VarChar(128)
