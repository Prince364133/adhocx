  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")
  // wire/billing-payouts: versioning + terms (same rules as CorporateRateCard).
  version                Int       @default(1)
  perHourPaise           BigInt?   @map("per_hour_paise")
  minimumPaise           BigInt    @default(0) @map("minimum_paise")
  noShowPaise            BigInt    @default(0) @map("no_show_paise")
