datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  VENDOR
  DRIVER
  ADMIN
  OPS
  CORPORATE_ADMIN
  CORPORATE_MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DriverAvailability {
  OFFLINE
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum VehicleType {
  SEDAN
  SUV
  HATCHBACK
  TEMPO_TRAVELLER
  BUS
  TATA_ACE
  PICKUP_TRUCK
}

enum FulfillmentMode {
  DIRECT_DISPATCH
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum RequirementStatus {
  DRAFT
  POSTED
  DISPATCHING
  PARTIALLY_FULFILLED
  FULFILLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVER_AVAILABLE
}

enum OfferStatus {
  CREATED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TripStatus {
  ASSIGNED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
  CANCELLED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum CouponDiscountType {
  PERCENTAGE
  FLAT
}

enum CouponApplicableContext {
  WALLET_TOPUP
  REQUIREMENT_BOOKING
  ALL
}

enum DriverSubscriptionStatus {
  TRIAL_ACTIVE
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  FROZEN
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  phone              String?            @unique
  email              String?            @unique
  passwordHash       String?            @map("password_hash")
  fullName           String?            @map("full_name")
  role               UserRole           @default(DRIVER)
  status             UserStatus         @default(ACTIVE)
  /// Corporate tenant this user belongs to (CORPORATE_ADMIN / CORPORATE_MANAGER / EMPLOYEE). Null for platform users.
  corporateTenantId  String?            @map("corporate_tenant_id") @db.Uuid
  /// WS-F: fine-grained corporate role. Null => derived from `role` (CORPORATE_ADMIN -> CORP_SUPER_ADMIN, CORPORATE_MANAGER -> TRANSPORT).
  corporateRole      CorporateUserRole? @map("corporate_role")
  /// WS-F: office scope of a corporate user. Empty => all offices of the tenant.
  corporateOfficeIds String[]           @default([]) @map("corporate_office_ids") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  vendor                 Vendor?
  driver                 Driver?
  auditLogs              AuditLog[]
  reviewsWritten         Review[]                @relation("ReviewsWritten")
  reviewsReceived        Review[]                @relation("ReviewsReceived")
  filedDisputes          Dispute[]               @relation("ReporterDisputes")
  accusedDisputes        Dispute[]               @relation("AccusedDisputes")
  couponRedemptions      CouponRedemption[]
  deviceTokens           DeviceToken[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  corporateTenant        CorporateTenant?        @relation(fields: [corporateTenantId], references: [id], onDelete: SetNull)
  corporateEmployee      CorporateEmployee?
  corporateTicketMessages CorporateTicketMessage[]

  @@index([corporateTenantId])
  @@map("users")
}

model Vendor {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  organizationName   String             @map("organization_name")
  fullName           String             @map("full_name")
  phone              String?
  gstNumber          String?            @map("gst_number")
  address            String?
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  escrowBalance      Decimal            @default(0.00) @map("escrow_balance") @db.Decimal(12, 2)
  rejectionReason    String?            @map("rejection_reason")
  kycDocuments       Json?              @map("kyc_documents")
  approvedAt         DateTime?          @map("approved_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  trips        Trip[]
  payments     Payment[]

  @@map("vendors")
}

model Driver {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @unique @map("user_id") @db.Uuid
  fullName            String                   @map("full_name")
  phone               String?                  @unique
  verificationStatus  VerificationStatus       @default(PENDING) @map("verification_status")
  availabilityStatus  DriverAvailability       @default(OFFLINE) @map("availability_status")
  vehicleType         String?                  @map("vehicle_type") @db.VarChar(50)
  vehicleModel        String?                  @map("vehicle_model")
  vehiclePlate        String?                  @map("vehicle_plate")
  walletBalance       Decimal                  @default(0.00) @map("wallet_balance") @db.Decimal(12, 2)
  trustScore          Float                    @default(100.0) @map("trust_score")
  averageRating       Float                    @default(5.0) @map("average_rating")
  ratingCount         Int                      @default(0) @map("rating_count")
  totalTrips          Int                      @default(0) @map("total_trips")
  acceptanceRate      Float                    @default(100.0) @map("acceptance_rate")
  acceptedOffers      Int                      @default(0) @map("accepted_offers")
  declinedOffers      Int                      @default(0) @map("declined_offers")
  consecutiveDeclines Int                      @default(0) @map("consecutive_declines")
  cooldownUntil       DateTime?                @map("cooldown_until")
  cooldownLevel       Int                      @default(0) @map("cooldown_level")
  lastCooldownAt      DateTime?                @map("last_cooldown_at")
  currentLat          Decimal?                 @map("current_lat") @db.Decimal(10, 7)
  currentLng          Decimal?                 @map("current_lng") @db.Decimal(10, 7)
  lastLocationAt      DateTime?                @map("last_location_at")
  rejectionReason     String?                  @map("rejection_reason")
  kycDocuments        Json?                    @map("kyc_documents")
  dlFrontUrl          String?                  @map("dl_front_url")
  dlBackUrl           String?                  @map("dl_back_url")
  rcDocUrl            String?                  @map("rc_doc_url")
  insuranceDocUrl     String?                  @map("insurance_doc_url")
  vehiclePhotoUrl     String?                  @map("vehicle_photo_url")
  aadharFrontUrl      String?                  @map("aadhar_front_url")
  aadharBackUrl       String?                  @map("aadhar_back_url")
  panDocUrl           String?                  @map("pan_doc_url")
  subscriptionStatus  DriverSubscriptionStatus @default(TRIAL_ACTIVE) @map("subscription_status")
  trialStartDate      DateTime                 @default(now()) @map("trial_start_date")
  trialEndDate        DateTime?                @map("trial_end_date")
  subscriptionExpiry  DateTime?                @map("subscription_expiry")
  autoDebit           Boolean                  @default(true) @map("auto_debit")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles             Vehicle[]
  offers               Offer[]
  assignments          Assignment[]
  trips                Trip[]
  settlements          Settlement[]
  reviewsReceived      Review[]                    @relation("DriverReviewsReceived")
  subscriptionPayments DriverSubscriptionPayment[]
  corporateRoutes      CorporateRoute[]
  corporateEarnings    CorporateDriverEarning[]
  corporateOffers      CorporateDriverOffer[]
  corporatePayouts     CorporatePayout[] // wire/billing-payouts

  @@map("drivers")
  /// Dispatch DB fallback: available + verified + fresh location, narrowed by a lat/lng box.
  @@index([availabilityStatus, verificationStatus, lastLocationAt], map: "drivers_dispatch_fallback_idx")
}

model Vehicle {
  id                 String             @id @default(uuid()) @db.Uuid
  driverId           String             @map("driver_id") @db.Uuid
  vehicleType        String             @map("vehicle_type") @db.VarChar(50)
  make               String?
  model              String
  registrationNumber String             @unique @map("registration_number")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rcNumber           String?            @map("rc_number")
  insuranceExpiry    DateTime?          @map("insurance_expiry")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  driver          Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignments     Assignment[]
  trips           Trip[]
  corporateRoutes CorporateRoute[]

  @@map("vehicles")
  /// Foreign key lookups (dispatch loads candidates' vehicles); Postgres does not index FKs itself.
  @@index([driverId])
}

model Requirement {
  id               String            @id @default(uuid()) @db.Uuid
  vendorId         String            @map("vendor_id") @db.Uuid
  fulfillmentMode  FulfillmentMode   @default(DIRECT_DISPATCH) @map("fulfillment_mode")
  vehicleType      String            @map("vehicle_type") @db.VarChar(50)
  quantity         Int               @default(1)
  assignedQuantity Int               @default(0) @map("assigned_quantity")
  pickupLat        Decimal           @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng        Decimal           @map("pickup_lng") @db.Decimal(10, 7)
  pickupAddress    String            @map("pickup_address")
  dropLat          Decimal           @map("drop_lat") @db.Decimal(10, 7)
  dropLng          Decimal           @map("drop_lng") @db.Decimal(10, 7)
  dropAddress      String            @map("drop_address")
  reportingTime    DateTime          @map("reporting_time")
  ratePerVehicle   Decimal?          @map("rate_per_vehicle") @db.Decimal(10, 2)
  suggestedBudget  Decimal?          @map("suggested_budget") @db.Decimal(10, 2)
  totalAmount      Decimal           @map("total_amount") @db.Decimal(12, 2)
  status           RequirementStatus @default(POSTED)
  dispatchWaves    Int               @default(0) @map("dispatch_waves")
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  vendor          Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  offers          Offer[]
  assignments     Assignment[]
  trips           Trip[]
  payments        Payment[]
  zonalQuote      ZonalQuoteSnapshot?
  pricingSnapshot TripPricingSnapshot?
  tripQuote       TripQuote?

  @@map("requirements")
}

model Offer {
  id            String      @id @default(uuid()) @db.Uuid
  requirementId String      @map("requirement_id") @db.Uuid
  driverId      String      @map("driver_id") @db.Uuid
  vehicleType   String      @map("vehicle_type") @db.VarChar(50)
  offeredRate   Decimal     @map("offered_rate") @db.Decimal(10, 2)
  status        OfferStatus @default(SENT)
  expiresAt     DateTime    @map("expires_at")
  respondedAt   DateTime?   @map("responded_at")
  // Dispatch-time snapshot used for behaviour decisions (never recomputed from live GPS)
  waveNumber    Int         @default(1) @map("wave_number")
  distanceKm    Float?      @map("distance_km")
  etaMinutes    Int?        @map("eta_minutes")
  // Set when the driver app displayed the offer; unseen expiries are not held against the driver
  seenAt        DateTime?   @map("seen_at")
  // True once this offer's outcome has been counted in the driver's rolling acceptance window
  countsForAr   Boolean     @default(false) @map("counts_for_ar")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignment  Assignment?

  @@index([status, expiresAt])
  @@index([requirementId, status])
  @@index([driverId, countsForAr, respondedAt])
  @@map("offers")
  /// A driver's live offers (GET /offers: driverId + SENT + not expired).
  @@index([driverId, status, expiresAt])
}

model Assignment {
  id            String           @id @default(uuid()) @db.Uuid
  requirementId String           @map("requirement_id") @db.Uuid
  offerId       String?          @unique @map("offer_id") @db.Uuid
  driverId      String           @map("driver_id") @db.Uuid
  vehicleId     String?          @map("vehicle_id") @db.Uuid
  status        AssignmentStatus @default(CONFIRMED)
  assignedAt    DateTime         @default(now()) @map("assigned_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  offer       Offer?      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trip        Trip?

  @@map("assignments")
}

model Trip {
  id                  String     @id @default(uuid()) @db.Uuid
  requirementId       String     @map("requirement_id") @db.Uuid
  assignmentId        String     @unique @map("assignment_id") @db.Uuid
  vendorId            String     @map("vendor_id") @db.Uuid
  driverId            String     @map("driver_id") @db.Uuid
  vehicleId           String?    @map("vehicle_id") @db.Uuid
  vehicleType         String     @map("vehicle_type") @db.VarChar(50)
  pickupAddress       String     @map("pickup_address")
  dropAddress         String     @map("drop_address")
  reportingTime       DateTime   @map("reporting_time")
  startedAt           DateTime?  @map("started_at")
  completedAt         DateTime?  @map("completed_at")
  cancelledAt         DateTime?  @map("cancelled_at")
  status              TripStatus @default(ASSIGNED)
  otp                 String     @default("1234")
  driverRate          Decimal    @map("driver_rate") @db.Decimal(10, 2)
  tollCharges         Decimal    @default(0.00) @map("toll_charges") @db.Decimal(10, 2)
  parkingCharges      Decimal    @default(0.00) @map("parking_charges") @db.Decimal(10, 2)
  totalDriverEarnings Decimal    @default(0.00) @map("total_driver_earnings") @db.Decimal(10, 2)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  requirement     Requirement          @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  assignment      Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  vendor          Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  driver          Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  events          TripEvent[]
  reviews         Review[]
  disputes        Dispute[]
  pricingSnapshot TripPricingSnapshot?

  @@index([vendorId, status, completedAt])
  @@map("trips")
  /// Driver app polling (GET /trips, GET /offers active-trip check): without it every poll scans all trips.
  @@index([driverId, status])
}

model TripEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  eventType String   @map("event_type")
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_events")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String   @map("trip_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  driverId   String?  @map("driver_id") @db.Uuid
  rating     Int
  feedback   String?
  createdAt  DateTime @default(now()) @map("created_at")

  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  driver   Driver? @relation("DriverReviewsReceived", fields: [driverId], references: [id], onDelete: SetNull)

  @@unique([tripId, reviewerId])
  @@map("reviews")
}

model Dispute {
  id             String        @id @default(uuid()) @db.Uuid
  tripId         String        @map("trip_id") @db.Uuid
  reporterId     String        @map("reporter_id") @db.Uuid
  accusedId      String        @map("accused_id") @db.Uuid
  reason         String
  description    String?
  status         DisputeStatus @default(OPEN)
  resolutionText String?       @map("resolution_text")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reporter User @relation("ReporterDisputes", fields: [reporterId], references: [id], onDelete: Cascade)
  accused  User @relation("AccusedDisputes", fields: [accusedId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
  @@index([reporterId])
  @@index([status])
  @@map("disputes")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  requirementId  String        @map("requirement_id") @db.Uuid
  vendorId       String        @map("vendor_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?       @map("payment_method")
  transactionRef String?       @map("transaction_ref")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  accountType   String          @map("account_type")
  accountId     String          @map("account_id") @db.Uuid
  entryType     LedgerEntryType @map("entry_type")
  amount        Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(12, 2)
  referenceType String          @map("reference_type")
  referenceId   String          @map("reference_id")
  description   String
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("ledger_entries")
}

model Settlement {
  id                String           @id @default(uuid()) @db.Uuid
  driverId          String           @map("driver_id") @db.Uuid
  amount            Decimal          @db.Decimal(12, 2)
  status            SettlementStatus @default(PENDING)
  bankAccountName   String?          @map("bank_account_name")
  bankAccountNumber String?          @map("bank_account_number")
  bankIfsc          String?          @map("bank_ifsc")
  transactionRef    String?          @map("transaction_ref")
  processedAt       DateTime?        @map("processed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("settlements")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String   @map("action")
  entityName String   @map("entity_name")
  entityId   String?  @map("entity_id")
  payload    Json?    @map("payload")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityName, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Coupon {
  id                String                  @id @default(uuid()) @db.Uuid
  code              String                  @unique
  title             String
  description       String?
  discountType      CouponDiscountType      @map("discount_type")
  discountValue     Decimal                 @map("discount_value") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?                @map("max_discount_amount") @db.Decimal(10, 2)
  minOrderAmount    Decimal                 @default(0.00) @map("min_order_amount") @db.Decimal(10, 2)
  applicableTo      CouponApplicableContext @default(ALL) @map("applicable_to")
  usageLimitTotal   Int?                    @map("usage_limit_total")
  usageLimitPerUser Int                     @default(1) @map("usage_limit_per_user")
  usedCount         Int                     @default(0) @map("used_count")
  validFrom         DateTime                @map("valid_from")
  validUntil        DateTime                @map("valid_until")
  isActive          Boolean                 @default(true) @map("is_active")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  referenceType  String   @map("reference_type")
  referenceId    String   @map("reference_id")
  orderAmount    Decimal  @map("order_amount") @db.Decimal(12, 2)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  finalAmount    Decimal  @map("final_amount") @db.Decimal(12, 2)
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([userId])
  @@map("coupon_redemptions")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id             String     @id @default(uuid()) @db.Uuid
  title          String
  slug           String     @unique
  excerpt        String     @db.Text
  content        String     @db.Text
  category       String
  tags           String[]   @default([])
  coverImage     String?    @map("cover_image")
  authorName     String     @default("AdhocX Team") @map("author_name")
  authorRole     String?    @default("Fleet Operations & Mobility Research") @map("author_role")
  status         BlogStatus @default(DRAFT)
  views          Int        @default(0)
  readTime       String     @default("5 min read") @map("read_time")
  seoTitle       String?    @map("seo_title")
  seoDescription String?    @map("seo_description") @db.Text
  seoKeywords    String?    @map("seo_keywords")
  publishedAt    DateTime?  @map("published_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([slug])
  @@index([status, publishedAt])
  @@index([category])
  @@map("blog_posts")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  SYSTEM
  TRIP_OFFER
  TRIP_ASSIGNED
  TRIP_STATUS
  REQUIREMENT_UPDATE
  KYC_UPDATE
  WALLET_UPDATE
  MARKETING_PROMO
  BROADCAST
}

model DeviceToken {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  token        String         @unique
  platform     DevicePlatform @default(ANDROID)
  deviceModel  String?        @map("device_model")
  appVersion   String?        @map("app_version")
  isActive     Boolean        @default(true) @map("is_active")
  lastActiveAt DateTime       @default(now()) @map("last_active_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("device_tokens")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  title          String
  body           String
  type           NotificationType @default(SYSTEM)
  data           Json?
  imageUrl       String?          @map("image_url")
  isRead         Boolean          @default(false) @map("is_read")
  readAt         DateTime?        @map("read_at")
  isClicked      Boolean          @default(false) @map("is_clicked")
  clickedAt      DateTime?        @map("clicked_at")
  idempotencyKey String?          @map("idempotency_key")
  priority       String           @default("high")
  channel        String           @default("PUSH")
  createdAt      DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  smsEnabled      Boolean  @default(true) @map("sms_enabled")
  tripAlerts      Boolean  @default(true) @map("trip_alerts")
  marketingPromos Boolean  @default(true) @map("marketing_promos")
  quietHoursStart String?  @map("quiet_hours_start")
  quietHoursEnd   String?  @map("quiet_hours_end")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationCampaign {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  body          String
  imageUrl      String?  @map("image_url")
  actionUrl     String?  @map("action_url")
  targetRole    String?  @map("target_role")
  targetFilter  Json?    @map("target_filter")
  totalTargeted Int      @default(0) @map("total_targeted")
  successCount  Int      @default(0) @map("success_count")
  failureCount  Int      @default(0) @map("failure_count")
  status        String   @default("SENT")
  sentBy        String?  @map("sent_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("notification_campaigns")
}

model VehiclePricingTier {
  id                 String   @id @default(uuid()) @db.Uuid
  vehicleType        String   @unique @map("vehicle_type") @db.VarChar(50)
  categoryLabel      String   @map("category_label")
  seatingCapacity    String   @map("seating_capacity")
  description        String
  iconKey            String?  @default("car") @map("icon_key")
  baseFare           Decimal  @map("base_fare") @db.Decimal(10, 2)
  baseKm             Decimal  @map("base_km") @db.Decimal(10, 2)
  perKmRate          Decimal  @map("per_km_rate") @db.Decimal(10, 2)
  surgeMultiplier    Decimal  @default(1.00) @map("surge_multiplier") @db.Decimal(4, 2)
  isActive           Boolean  @default(true) @map("is_active")
  updatedAt          DateTime @updatedAt @map("updated_at")
  updatedBy          String?  @map("updated_by")

  @@map("vehicle_pricing_tiers")
}

model SystemPolicyConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  key                 String   @unique
  driverMonthlyFee    Decimal  @default(499.00) @map("driver_monthly_fee") @db.Decimal(10, 2)
  driverTrialDays     Int      @default(15) @map("driver_trial_days")
  minWithdrawalAmount Decimal  @default(1000.00) @map("min_withdrawal_amount") @db.Decimal(10, 2)
  escortFee           Decimal  @default(300.00) @map("escort_fee") @db.Decimal(10, 2)
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("system_policy_configs")
}

model DriverSubscriptionPayment {
  id             String   @id @default(uuid()) @db.Uuid
  driverId       String   @map("driver_id") @db.Uuid
  amount         Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  finalAmount    Decimal  @map("final_amount") @db.Decimal(10, 2)
  paymentMethod  String   @map("payment_method") // WALLET | RAZORPAY
  paymentRef     String?  @map("payment_ref")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  couponCode     String?  @map("coupon_code")
  createdAt      DateTime @default(now()) @map("created_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_subscription_payments")
}

model LeadCapture {
  id                   String   @id @default(uuid()) @db.Uuid
  type                 String   @map("type") // 'ENTERPRISE_DEMO' | 'NEWSLETTER'
  email                String   @map("email")
  phone                String?  @map("phone")
  companyName          String?  @map("company_name")
  contactName          String?  @map("contact_name")
  city                 String?  @map("city")
  fleetRequirements    String?  @map("fleet_requirements")
  monthlyTripsEstimate String?  @map("monthly_trips_estimate")
  preferredVehicles    String?  @map("preferred_vehicles")
  notes                String?  @map("notes")
  status               String   @default("NEW") @map("status") // 'NEW' | 'CONTACTED' | 'RESOLVED'
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("lead_captures")
}

// ==========================================
// RATE CARD MASTER (Immutable Versions)
// ==========================================
enum RateCardAudience {
  VENDOR
  DRIVER
}

enum RateCardStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model RateCardVersion {
  id            String           @id @default(uuid()) @db.Uuid
  version       String
  audience      RateCardAudience
  status        RateCardStatus   @default(DRAFT)
  effectiveFrom DateTime         @map("effective_from")
  currency      String           @default("INR")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  publishedAt   DateTime?        @map("published_at")
  publishedBy   String?          @map("published_by")
  rows          RateCardRow[]

  @@unique([audience, version])
  @@index([audience, status])
  @@map("rate_card_versions")
}

model RateCardRow {
  id                String @id @default(uuid()) @db.Uuid
  rateCardVersionId String @map("rate_card_version_id") @db.Uuid
  hubId             String @map("hub_id")
  zoneId            String @map("zone_id")
  vehicleType       String @map("vehicle_type") @db.VarChar(50)
  baseAmountPaise   Int    @map("base_amount_paise")
  escortMaxPaise    Int    @default(0) @map("escort_max_paise")

  rateCardVersion RateCardVersion @relation(fields: [rateCardVersionId], references: [id], onDelete: Cascade)

  @@unique([rateCardVersionId, hubId, zoneId, vehicleType])
  @@map("rate_card_rows")
}

// ==========================================
// LOCALITY & HUB RESOLUTION MASTER
// ==========================================
enum LocalityReviewStatus {
  VERIFIED
  PENDING_REVIEW
  INACTIVE
}

model LocalityMaster {
  id           String               @id @default(uuid()) @db.Uuid
  displayName  String               @unique @map("display_name")
  aliases      String[]
  zoneId       String               @map("zone_id")
  centerLat    Decimal?             @map("center_lat") @db.Decimal(10, 7)
  centerLng    Decimal?             @map("center_lng") @db.Decimal(10, 7)
  h3IndexRes8  String?              @map("h3_index_res8")
  reviewStatus LocalityReviewStatus @default(VERIFIED) @map("review_status")
  notes        String?
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at")

  @@index([zoneId])
  @@index([h3IndexRes8])
  @@map("locality_masters")
}

// ==========================================
// IMMUTABLE QUOTE SNAPSHOTS
// ==========================================
model ZonalQuoteSnapshot {
  id                String    @id @default(uuid()) @db.Uuid
  requirementId     String?   @unique @map("requirement_id") @db.Uuid
  requestedBy       String?   @map("requested_by") @db.Uuid
  rateVersion       String    @map("rate_version")
  driverRateVersion String?   @map("driver_rate_version")
  direction         String?   @map("direction") @db.VarChar(32)
  hubId             String    @map("hub_id")
  localityId        String    @map("locality_id")
  localityName      String?   @map("locality_name")
  zoneId            String    @map("zone_id")
  pickupLat         Decimal?  @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng         Decimal?  @map("pickup_lng") @db.Decimal(10, 7)
  dropLat           Decimal?  @map("drop_lat") @db.Decimal(10, 7)
  dropLng           Decimal?  @map("drop_lng") @db.Decimal(10, 7)
  consumedAt        DateTime? @map("consumed_at")
  vehicleType       String    @map("vehicle_type") @db.VarChar(50)
  hasEscort         Boolean   @default(false) @map("has_escort")
  baseFarePaise     Int       @map("base_fare_paise")
  escortFarePaise   Int       @default(0) @map("escort_fare_paise")
  totalFarePaise    Int       @map("total_fare_paise")
  driverFarePaise   Int       @map("driver_fare_paise")
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  requirement Requirement? @relation(fields: [requirementId], references: [id])

  @@index([requestedBy, createdAt])
  @@map("zonal_quote_snapshots")
}

// ==========================================
// DYNAMIC DISTANCE-BASED PRICING ENGINE (PRD v1.0)
// ==========================================

model PricingPlan {
  id              String                @id @default(uuid()) @db.Uuid
  vehicleCategory String                @default("ALL") @map("vehicle_category") @db.VarChar(50)
  version         String
  name            String?
  status          String                @default("DRAFT") // DRAFT, ACTIVE, SCHEDULED, RETIRED
  effectiveFrom   DateTime              @default(now()) @map("effective_from")
  effectiveTo     DateTime?             @map("effective_to")
  createdBy       String?               @map("created_by")
  publishedBy     String?               @map("published_by")
  publishedAt     DateTime?             @map("published_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at")
  /// Peak windows in IST: [{ start: "08:00", end: "11:00", label? }]. Null/empty = never peak.
  peakWindowsJson Json?                 @map("peak_windows_json")
  /// Admin slab-generator settings (step km, max km, uplift %). Display only; never used for pricing.
  rateConfigJson  Json?                 @map("rate_config_json")

  slabs           PricingSlab[]
  quotes          TripQuote[]
  snapshots       TripPricingSnapshot[]

  @@unique([vehicleCategory, version])
  @@index([vehicleCategory, status])
  @@map("pricing_plans")
}

model PricingSlab {
  id                    String      @id @default(uuid()) @db.Uuid
  planId                String      @map("plan_id") @db.Uuid
  minDistanceMExclusive Int         @map("min_distance_m_exclusive")
  maxDistanceMInclusive Int         @map("max_distance_m_inclusive")
  vendorPricePaise      Int         @map("vendor_price_paise")
  driverPayoutPaise     Int         @map("driver_payout_paise")
  /// Peak-hour rates. Null = same as the standard rate (no implicit surcharge).
  vendorPeakPricePaise  Int?        @map("vendor_peak_price_paise")
  driverPeakPayoutPaise Int?        @map("driver_peak_payout_paise")
  active                Boolean     @default(true)
  sortOrder             Int         @default(0) @map("sort_order")

  plan                  PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, active])
  @@map("pricing_slabs")
}

model PricingAudit {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id")
  actorName    String?  @map("actor_name")
  action       String // CREATE_PLAN, UPDATE_SLABS, PUBLISH_PLAN, RETIRE_PLAN
  entityType   String   @default("PRICING_PLAN") @map("entity_type")
  entityId     String   @map("entity_id")
  oldValueJson Json?    @map("old_value_json")
  newValueJson Json?    @map("new_value_json")
  reason       String?
  timestamp    DateTime @default(now())

  @@index([entityId])
  @@index([timestamp])
  @@map("pricing_audit")
}

model TripQuote {
  id                String       @id @default(uuid()) @db.Uuid
  vendorId          String       @map("vendor_id")
  pickupAddress     String?      @map("pickup_address")
  pickupLat         Decimal?     @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng         Decimal?     @map("pickup_lng") @db.Decimal(10, 7)
  dropAddress       String?      @map("drop_address")
  dropLat           Decimal?     @map("drop_lat") @db.Decimal(10, 7)
  dropLng           Decimal?     @map("drop_lng") @db.Decimal(10, 7)
  vehicleCategory   String       @default("ALL") @map("vehicle_category") @db.VarChar(50)
  routeDistanceM    Int          @map("route_distance_m")
  planId            String?      @map("plan_id") @db.Uuid
  planVersion       String?      @map("plan_version")
  slabId            String?      @map("slab_id") @db.Uuid
  vendorPricePaise  Int          @map("vendor_price_paise")
  driverPayoutPaise Int          @map("driver_payout_paise")
  hasEscort         Boolean      @default(false) @map("has_escort")
  escortFarePaise   Int          @default(0) @map("escort_fare_paise")
  /// Pickup instant the quote was priced for, and whether that fell in a peak window. A booking's
  /// reporting time must fall in the same pricing period or the quote is refused.
  pricedForTime     DateTime?    @map("priced_for_time")
  isPeak            Boolean      @default(false) @map("is_peak")
  expiresAt         DateTime     @map("expires_at")
  status            String       @default("ACTIVE") // ACTIVE, CONFIRMED, EXPIRED
  routeSummary      String?      @map("route_summary")
  /// Distance source and routing policy used (PRD 6 audit), e.g. GOOGLE_ROUTES / TRAFFIC_UNAWARE.
  routeSource       String?   @map("route_source") @db.VarChar(32)
  routingPreference String?   @map("routing_preference") @db.VarChar(32)
  requirementId     String?   @unique @map("requirement_id") @db.Uuid
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Restrict: a plan version referenced by a quote or trip can never be hard-deleted (PRD 4).
  plan        PricingPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([vendorId, status])
  @@map("trip_quotes")
}

model TripPricingSnapshot {
  id                String       @id @default(uuid()) @db.Uuid
  tripId            String?      @unique @map("trip_id") @db.Uuid
  requirementId     String?      @unique @map("requirement_id") @db.Uuid
  quoteId           String?      @map("quote_id") @db.Uuid
  planId            String?      @map("plan_id") @db.Uuid
  planVersion       String       @map("plan_version")
  distanceM         Int          @map("distance_m")
  slabId            String?      @map("slab_id") @db.Uuid
  vendorPricePaise  Int          @map("vendor_price_paise")
  driverPayoutPaise Int          @map("driver_payout_paise")
  grossSpreadPaise  Int          @map("gross_spread_paise")
  hasEscort         Boolean      @default(false) @map("has_escort")
  escortFarePaise   Int          @default(0) @map("escort_fare_paise")
  quotedAt          DateTime     @default(now()) @map("quoted_at")
  overrideReason    String?      @map("override_reason")
  createdAt         DateTime     @default(now()) @map("created_at")

  trip        Trip?        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  plan        PricingPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planVersion])
  @@map("trip_pricing_snapshots")
}

// ==========================================
// CORPORATE EMPLOYEE TRANSPORTATION SYSTEM (ETS)
// ==========================================

enum CorporateTenantStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum CorporateGender {
  MALE
  FEMALE
  OTHER
}

enum CorporateRosterStatus {
  DRAFT
  APPROVED // WS-F: DRAFT -> APPROVED -> PUBLISHED
  PUBLISHED
  PROCESSED
  CANCELLED
}

enum CorporateTransportDirection {
  LOGIN
  LOGOUT
}

enum CorporateRequestStatus {
  APPROVED
  PLANNED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  UNSERVED
}

enum CorporateRouteStatus {
  PLANNED
  DISPATCHING
  ASSIGNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum CorporateStopStatus {
  PENDING
  ARRIVED
  BOARDED
  NO_SHOW
  CANCELLED
}

enum CorporateInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  DISPUTED
}

enum CorporateDriverEarningStatus {
  UNPAID
  PROCESSING
  PAID
  /// wire/dispatch-ops: earning withdrawn by a manual reassign. Kept for audit, never paid or summed.
  VOIDED
}

model CorporateTenant {
  id                        String                @id @default(uuid()) @db.Uuid
  code                      String                @unique @db.VarChar(32)
  name                      String
  legalEntityName           String                @map("legal_entity_name")
  gstin                     String?               @db.VarChar(15)
  cin                       String?               @db.VarChar(21)
  logoUrl                   String?               @map("logo_url")
  industry                  String?
  website                   String?
  registeredAddress         String?               @map("registered_address")
  city                      String?
  state                     String?
  pinCode                   String?               @map("pin_code") @db.VarChar(12)
  country                   String?
  primaryContactName        String?               @map("primary_contact_name")
  primaryContactEmail       String?               @map("primary_contact_email")
  primaryContactPhone       String?               @map("primary_contact_phone") @db.VarChar(32)
  registeredBusinessAddress String?               @map("registered_business_address")
  billingAddress            String?               @map("billing_address")
  billingSameAsRegistered   Boolean               @default(true) @map("billing_same_as_registered")
  status                    CorporateTenantStatus @default(ACTIVE)
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @default(now()) @updatedAt @map("updated_at")

  offices           CorporateOffice[]
  employees         CorporateEmployee[]
  rosters           CorporateRoster[]
  transportRequests CorporateTransportRequest[]
  routes            CorporateRoute[]
  invoices          CorporateInvoice[]
  users             User[]
  driverOffers      CorporateDriverOffer[]
  supportTickets    CorporateSupportTicket[]
  tripFeedbacks     CorporateTripFeedback[]
  sosAlerts         CorporateSosAlert[]
  rateCards         CorporateRateCard[]
  // WS-F back-relations
  departments       CorporateDepartment[]
  costCenters       CorporateCostCenter[]
  transportZones    CorporateTransportZone[]
  policies          CorporateTenantPolicy[]
  shiftTemplates    CorporateShiftTemplate[]
  holidays          CorporateHoliday[]
  // wire/billing-payouts back-relations
  invoiceDisputes   CorporateInvoiceDispute[]
  creditNotes       CorporateCreditNote[]

  @@map("corporate_tenants")
}

model CorporateOffice {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  code         String   @db.VarChar(32)
  name         String
  addressText  String   @map("address_text")
  city         String?
  state        String?
  pinCode      String?  @map("pin_code") @db.VarChar(12)
  country      String?
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone") @db.VarChar(32)
  isActive     Boolean  @default(true) @map("is_active")
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  h3Res8Index  String   @map("h3_res8_index") @db.VarChar(15)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant         CorporateTenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees      CorporateEmployee[]
  rosters        CorporateRoster[]
  routes         CorporateRoute[]
  // WS-F back-relations
  shiftTemplates CorporateShiftTemplate[]
  holidays       CorporateHoliday[]
  departments    CorporateDepartment[]
  transportZones CorporateTransportZone[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([h3Res8Index])
  @@map("corporate_offices")
}

model CorporateEmployee {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  officeId     String          @map("office_id") @db.Uuid
  employeeCode String          @map("employee_code") @db.VarChar(64)
  fullName     String          @map("full_name")
  email        String
  phoneNumber  String          @map("phone_number") @db.VarChar(20)
  gender       CorporateGender @default(MALE)
  department   String?         @db.VarChar(64)
  costCenter   String?         @map("cost_center") @db.VarChar(64)
  /// WS-F: optional FKs; the string fields above stay what the roster upload writes.
  departmentId String?         @map("department_id") @db.Uuid
  costCenterId String?         @map("cost_center_id") @db.Uuid
  isActive     Boolean         @default(true) @map("is_active")
  /// Login account of this employee (EMPLOYEE role). Null until the employee is onboarded to the rider app.
  userId       String?         @unique @map("user_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at")

  user              User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant            CorporateTenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  office            CorporateOffice             @relation(fields: [officeId], references: [id])
  locations         CorporateEmployeeLocation[]
  transportRequests CorporateTransportRequest[]
  routeStops        CorporateRouteStop[]
  supportTickets    CorporateSupportTicket[]
  tripFeedbacks     CorporateTripFeedback[]
  // WS-F
  departmentRef     CorporateDepartment?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  costCenterRef     CorporateCostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  rosterEntries     CorporateRosterEntry[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([officeId])
  @@map("corporate_employees")
}

model CorporateEmployeeLocation {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  addressText String   @map("address_text")
  landmark    String?
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  h3Res8Index String   @map("h3_res8_index") @db.VarChar(15)
  isDefault   Boolean  @default(true) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  employee CorporateEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([h3Res8Index])
  @@map("corporate_employee_locations")
}

model CorporateRoster {
  id             String                      @id @default(uuid()) @db.Uuid
  tenantId       String                      @map("tenant_id") @db.Uuid
  officeId       String                      @map("office_id") @db.Uuid
  rosterDate     DateTime                    @map("roster_date") @db.Date
  shiftTime      String                      @map("shift_time") @db.VarChar(8)
  direction      CorporateTransportDirection
  status         CorporateRosterStatus       @default(DRAFT)
  passengerCount Int                         @default(0) @map("passenger_count")
  /// WS-F: version per (tenant, office, rosterDate) and lifecycle actors.
  version        Int                         @default(1)
  uploadedById   String?                     @map("uploaded_by_id") @db.Uuid
  approvedById   String?                     @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?                   @map("approved_at")
  publishedById  String?                     @map("published_by_id") @db.Uuid
  publishedAt    DateTime?                   @map("published_at")
