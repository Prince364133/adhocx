// ===== WS-F: tenancy & scheduling =====

/// Fine-grained corporate portal role (PRD CP-ADM-01). Permission matrix: src/domains/corporate/tenants/corporate-permissions.ts
enum CorporateUserRole {
  CORP_SUPER_ADMIN
  HR
  TRANSPORT
  FINANCE
  SAFETY
  READ_ONLY
}

model CorporateDepartment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  code           String   @db.VarChar(32)
  name           String
  departmentHead String?  @map("department_head")
  officeId       String?  @map("office_id") @db.Uuid
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  tenant    CorporateTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  office    CorporateOffice?    @relation(fields: [officeId], references: [id], onDelete: SetNull)
  employees CorporateEmployee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("corporate_departments")
}

model CorporateTransportZone {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  officeId        String   @map("office_id") @db.Uuid
  code            String   @db.VarChar(32)
  name            String
  description     String?
  serviceArea     String   @map("service_area")
  pickupLocations Json     @default("[]") @map("pickup_locations")
  dropLocations   Json     @default("[]") @map("drop_locations")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  tenant CorporateTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  office CorporateOffice @relation(fields: [officeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId, officeId])
  @@map("corporate_transport_zones")
}

model CorporateCostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(32)
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant    CorporateTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees CorporateEmployee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("corporate_cost_centers")
}

/// Versioned operational policy per tenant. Every edit inserts a new version; active = highest version with effective_from <= now.
model CorporateTenantPolicy {
  id                         String   @id @default(uuid()) @db.Uuid
  tenantId                   String   @map("tenant_id") @db.Uuid
  version                    Int
  effectiveFrom              DateTime @map("effective_from")
  cancelCutoffHours          Int      @default(9) @map("cancel_cutoff_hours")
  maxRideMinutes             Int      @default(120) @map("max_ride_minutes")
  defaultVehicleCategory     String   @default("SEDAN") @map("default_vehicle_category") @db.VarChar(32)
  defaultCapacity            Int      @default(4) @map("default_capacity")
  escalationLeadMinutes        Int      @default(30) @map("escalation_lead_minutes")
  officeArrivalBufferMinutes   Int      @default(10) @map("office_arrival_buffer_minutes")
  stopDwellMinutes             Int      @default(10) @map("stop_dwell_minutes")
  approachLeadMinutes          Int      @default(30) @map("approach_lead_minutes")
  dispatchWindowMinutes        Int      @default(30) @map("dispatch_window_minutes")
  dispatchRetryIntervalMinutes Int      @default(5) @map("dispatch_retry_interval_minutes")
  searchRadiusKm               Int      @default(10) @map("search_radius_km")
  nightShiftStart              String   @default("20:00") @map("night_shift_start") @db.VarChar(5)
  nightShiftEnd              String   @default("06:00") @map("night_shift_end") @db.VarChar(5)
  createdById                String?  @map("created_by_id") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at")

  tenant CorporateTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, version])
  @@index([tenantId, effectiveFrom])
  @@map("corporate_tenant_policies")
}

model CorporateShiftTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  officeId    String   @map("office_id") @db.Uuid
  name        String   @db.VarChar(64)
  loginTime   String   @map("login_time") @db.VarChar(5)
  logoutTime  String   @map("logout_time") @db.VarChar(5)
  /// ISO weekdays the shift runs on (1 = Monday ... 7 = Sunday).
  weekdays    Int[]
  /// Logout falls on the next IST calendar day (e.g. login 20:00, logout 02:00).
  isOvernight Boolean  @default(false) @map("is_overnight")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tenant CorporateTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  office CorporateOffice @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, officeId, name])
  @@index([tenantId, officeId])
  @@map("corporate_shift_templates")
}

/// No transport demand is generated on a holiday. officeId null => every office of the tenant.
model CorporateHoliday {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  officeId    String?  @map("office_id") @db.Uuid
  holidayDate DateTime @map("holiday_date") @db.Date
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  tenant CorporateTenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  office CorporateOffice? @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, officeId, holidayDate])
  @@index([tenantId, holidayDate])
  @@map("corporate_holidays")
}

/// Demand line of a DRAFT / APPROVED roster version. Publishing turns each line into a
/// CorporateTransportRequest with the same idempotencyHash (createMany skipDuplicates).
model CorporateRosterEntry {
  id              String                      @id @default(uuid()) @db.Uuid
  rosterId        String                      @map("roster_id") @db.Uuid
  tenantId        String                      @map("tenant_id") @db.Uuid
  employeeId      String                      @map("employee_id") @db.Uuid

  officeId        String                      @map("office_id") @db.Uuid
  scheduledDate   DateTime                    @map("scheduled_date") @db.Date
  shiftTime       String                      @map("shift_time") @db.VarChar(8)
  direction       CorporateTransportDirection
  pickupLat       Decimal                     @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng       Decimal                     @map("pickup_lng") @db.Decimal(10, 7)
  dropoffLat      Decimal                     @map("dropoff_lat") @db.Decimal(10, 7)
  dropoffLng      Decimal                     @map("dropoff_lng") @db.Decimal(10, 7)
  h3PickupIndex   String                      @map("h3_pickup_index") @db.VarChar(15)
  idempotencyHash String                      @map("idempotency_hash") @db.VarChar(64)
  createdAt       DateTime                    @default(now()) @map("created_at")

  roster   CorporateRoster   @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  employee CorporateEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([rosterId, idempotencyHash])
  @@index([rosterId])
  @@index([tenantId, scheduledDate])
  @@map("corporate_roster_entries")
}

