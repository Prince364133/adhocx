  tenant CorporateTenant @relation(fields: [tenantId], references: [id])
  route  CorporateRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver Driver          @relation(fields: [driverId], references: [id])

  @@unique([routeId, driverId, attempt])
  @@index([driverId, status, expiresAt])
  @@index([routeId, status])
  @@index([tenantId, createdAt])
  @@map("corporate_driver_offers")
}

