// ===== wire/billing-payouts: per-driver payouts, provider confirmations, disputes, credit notes =====

enum CorporatePayoutStatus {
  PENDING // created with the batch, not yet sent to the provider
  PROCESSING // accepted by the provider, awaiting confirmation
  PAID // only ever set from a provider confirmation
  FAILED // retry reuses the same idempotencyKey
  REVERSED // compensated by a REVERSAL row; nothing is deleted
}

/// One row per driver per batch. kind PAYOUT carries money out; kind REVERSAL is the
/// compensating record of a reversed PAYOUT (negative amounts, reversalOfId set).
model CorporatePayout {
  id                String                @id @default(uuid()) @db.Uuid
  batchId           String                @map("batch_id") @db.Uuid
  driverId          String                @map("driver_id") @db.Uuid
  kind              String                @default("PAYOUT") @db.VarChar(16)
  reversalOfId      String?               @unique @map("reversal_of_id") @db.Uuid
  idempotencyKey    String                @unique @map("idempotency_key") @db.VarChar(128)
  status            CorporatePayoutStatus @default(PENDING)
  grossPaise        BigInt                @map("gross_paise")
  tdsPaise          BigInt                @map("tds_paise")
  netPaise          BigInt                @map("net_paise")
  earningIds        String[]              @map("earning_ids") @db.Uuid
  attemptCount      Int                   @default(0) @map("attempt_count")
  providerPayoutId  String?               @map("provider_payout_id") @db.VarChar(128)
  providerReference String?               @map("provider_reference") @db.VarChar(128)
  failureReason     String?               @map("failure_reason")
  submittedAt       DateTime?             @map("submitted_at")
  paidAt            DateTime?             @map("paid_at")
  failedAt          DateTime?             @map("failed_at")
  reversedAt        DateTime?             @map("reversed_at")
