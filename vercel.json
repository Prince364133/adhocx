{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "apps/marketing",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/drivers", "destination": "/apps/marketing/drivers.html" },
    { "source": "/vendors", "destination": "/apps/marketing/vendors.html" },
    { "source": "/blogs", "destination": "/apps/marketing/blogs.html" },
    { "source": "/terms", "destination": "/apps/marketing/terms.html" },
    { "source": "/privacy", "destination": "/apps/marketing/privacy.html" },
    { "source": "/(.*)", "destination": "/apps/marketing/$1" }
  ]
}
